def compact_apply_preset(sdir, scope, agent_name, preset_name):
    """Apply a named preset's three cadence values, preserving the
    enabled flag (never silently enables a disabled scope) and the
    timeout. Returns (ok, message)."""
    role = scope if scope in ("orchestrator", "sub") else \
        compact_role_of(sdir, agent_name)
    hit = [p for p in COMPACT_PRESETS.get(role, ())
           if p["name"] == preset_name]
    if not hit:
        return False, f"unknown preset: {preset_name}"
    p = hit[0]
    vals = {"max_turns": p["max_turns"],
            "token_threshold": p["token_threshold"],
            "keep_recent": p["keep_recent"]}
    if scope in ("orchestrator", "sub"):
        r = compact_set_default(sdir, scope, vals)
        if isinstance(r, dict) and r.get("error"):
            return False, str(r["error"])[:100]
        return True, f'saved {p["name"]}: {p["desc"]}'
    eff = compact_effective(sdir, agent_name)["settings"]
    patch = dict(vals)
    patch["enabled"] = bool(eff.get("enabled"))
    patch["timeout"] = eff.get("timeout", 120)
    r = compact_set_agent(sdir, agent_name, patch)
    if isinstance(r, dict) and r.get("error"):
        return False, str(r["error"])[:100]
    state = "on" if patch["enabled"] else "off"
    return True, f'saved {p["name"]}: {p["desc"]} (stays {state})'

def compact_apply_onoff(sdir, scope, agent_name, enabled):
    """Set only the enabled flag. Returns (ok, message)."""
    if scope in ("orchestrator", "sub"):
        r = compact_set_default(sdir, scope, {"enabled": bool(enabled)})
    else:
        r = compact_set_agent(sdir, agent_name, {"enabled": bool(enabled)})
    if isinstance(r, dict) and r.get("error"):
        return False, str(r["error"])[:100]
    return True, f'saved automatic summaries {"on" if enabled else "off"}'

def compact_screen_rows(sdir, agent_name):
    """Legacy entry: now the overview screen (title + one row per scope).
    Kept for older callers; the TUI drills into scope/advanced views."""
    return compact_overview_rows(sdir, agent_name)

def compact_selectable(crows):
    """Logical indices of interactive compact rows (nav/pick/edit/act).
    Pure. Headers (sec) and live stats (stat) are display-only."""
    return [i for i, (k, _r, _l, _v) in enumerate(crows or [])
            if k in ("nav", "pick", "edit", "act")]

def compact_first_selectable(crows):
    """First editable index on open (never a header/stat). Pure."""
    sel = compact_selectable(crows)
    return sel[0] if sel else 0

def compact_step(crows, idx, delta):
    """Move idx to the next selectable in direction (+1/-1). Pure."""
    sel = compact_selectable(crows)
    if not sel:
        return max(0, idx)
    if idx not in sel:
        return sel[0] if delta > 0 else sel[-1]
    j = sel.index(idx)
    return sel[max(0, min(len(sel) - 1, j + delta))]

def compact_disp_index(disp_rows, rid):
    """First wrapped display position for a logical row id. Pure."""
    for j, (_k, r, _s) in enumerate(disp_rows or []):
        if r == rid:
            return j
    return 0

def compact_disp_span(disp_rows, rid):
    """(first, last) wrapped display positions for a logical row id, so
    the whole selected option can be kept visible. Pure."""
    pos = [j for j, (_k, r, _s) in enumerate(disp_rows or []) if r == rid]
    if not pos:
        return (0, 0)
    return (pos[0], pos[-1])

def compact_parse_value(key, raw):
    """Parse editor text for a compact setting. Pure.
    Returns (value, error)."""
    t = (raw or "").strip().lower()
    if key == "enabled":
        if t in ("1", "true", "on", "yes", "y"): return True, ""
        if t in ("0", "false", "off", "no", "n"): return False, ""
        return None, "use on/off"
    try:
        return int(t), ""
    except Exception:
        return None, "must be an integer"

def compact_apply_edit(sdir, target, key, raw):
    """Validate + persist one compact edit through the shared helpers.
    target: 'orchestrator'|'sub'|'agent:NAME'. Pure I/O; returns
    (ok_bool, inline_message). Writes immediately on success; the
    message names what saved."""
    val, err = compact_parse_value(key, raw)
    if err:
        return False, err
    if target in ("orchestrator", "sub"):
        r = compact_set_default(sdir, target, {key: val})
    elif target.startswith("agent:"):
        r = compact_set_agent(sdir, target[len("agent:"):], {key: val})
    else:
        return False, "bad target"
    if isinstance(r, dict) and r.get("error"):
        return False, str(r["error"])[:100]
    label = (COMPACT_ADV_META.get(key, (key,))[0] if key in
             COMPACT_ADV_META else key).lower()
    if key == "enabled":
        return True, f'saved automatic summaries {"on" if val else "off"}'
    return True, f"saved {label} = {val}"

def context_screen_lines(ctx, width):
    """Flatten a get_agent_context result into wrapped (kind, text) lines.
    Pure. kinds: sec|body|warn|src."""
    out = []
    w = max(10, width)
    asg = (ctx or {}).get("assignment") or {}
    if asg:
        out.append(("sec", "assignment"))
        for k in ("project", "scope", "task", "acceptance"):
            v = asg.get(k)
            if v:
                for seg in wrap_chat_line(f"{k}: {v}", w):
                    out.append(("body", seg))
    srcs = (ctx or {}).get("sources") or []
    if srcs:
        out.append(("sec", f"sources ({len(srcs)})"))
        for s in srcs:
            nm = f'{(s.get("status","?")):12} {(s.get("kind","?")):10} {s.get("path","")}'
            for seg in wrap_chat_line(nm, w):
                out.append(("src", seg))
    warns = (ctx or {}).get("warnings") or []
    for x in warns:
        for seg in wrap_chat_line(f"! {x}", w):
            out.append(("warn", seg))
    txt = ((ctx or {}).get("text") or "").strip()
    if txt:
        out.append(("sec", "content"))
        for ln in txt.splitlines():
            for seg in wrap_chat_line(ln, w) or [""]:
                out.append(("body", seg))
    if not out:
        out = [("body", "no context assigned yet — see ag context assign")]
    return out

def group_agents_by_workdir(agents, cwd=""):
    """Group roster by normalized workdir, first-seen order. Pure.
    ''/missing -> '.', equivalent paths ('.' vs absolute cwd, trailing
    slashes, nested relative) merge into one project group."""
    groups = {}
    for a in agents or []:
        groups.setdefault(norm_workdir((a or {}).get("dir"), cwd), []).append(a)
    return list(groups.items())

def norm_workdir(d, cwd=""):
    """Canonical grouping key: abspath (against cwd when given) + normpath.
    Pure. No symlink resolution, no home expansion — literal meaning kept."""
    s = (d or ".") or "."
    if cwd and not os.path.isabs(s):
        s = os.path.join(cwd, s)
    return os.path.normpath(s)

def index_by_name(seq, name):
    """Position of an agent name in a roster/flat list. Pure; None if absent.
    Maps home-highlight (group order) <-> active (roster order)."""
    for i, a in enumerate(seq or []):
        if (a or {}).get("name") == name:
