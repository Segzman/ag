def G(sym):
    """UI glyph with AG_ASCII fallback (opt-in, default keeps Unicode).
    Pure (env-read, no curses); no other behavior changes."""
    if os.environ.get("AG_ASCII"):
        return AG_ASCII_GLYPHS.get(sym, sym)
    return sym

def ui_colors_on():
    """False under NO_COLOR: meaning then rides on text markers (>, !,
    +/-, status words) + reverse video, never color alone. Pure."""
    return not os.environ.get("NO_COLOR")

def select_attr(th):
    """Selection attr: theme color normally, reverse video under NO_COLOR
    so the current row stays visible in monochrome."""
    import curses as _c
    try:
        if not ui_colors_on():
            return _c.A_REVERSE | getattr(_c, "A_BOLD", 0)
    except Exception:
        pass
    try:
        return (th or {})["sel"]
    except Exception:
        return 0

def timeline_new():
    """Live per-agent timeline store: ordered rows, upsert by event_id.
    Pure container (dict); the TUI owns instances, never the backend."""
    return {"order": [], "by_id": {}}

def timeline_upsert(store, row):
    """Upsert one timeline row by stable event_id: replace the snapshot,
    never concatenate (re-emitted progress updates one row). Pure.
    Missing event_id falls back to append. Returns the stored row."""
    if store is None:
        store = timeline_new()
    r = dict(row or {})
    eid = r.get("event_id") or f'anon-{len(store.get("order", []))}'
    r["event_id"] = eid
    if eid not in store.get("by_id", {}):
        store.setdefault("order", []).append(eid)
    store.setdefault("by_id", {})[eid] = r
    return r

def timeline_rows(store):
    """Chronological row list (first-seen order). Pure."""
    if not store:
        return []
    by_id = store.get("by_id", {})
    return [by_id[i] for i in store.get("order", []) if i in by_id]

TOOL_STATUS_WORDS = {"running": "Running", "started": "Running",
    "pending": "Running", "in_progress": "Running",
    "completed": "Done", "done": "Done", "success": "Done", "ok": "Done",
    "failed": "Failed", "failure": "Failed", "error": "Failed"}

def timeline_tool_summary(row, width=60):
    """Compact tool card text: name + useful args (path first, never huge
    JSON) + Running/Done/Failed word. Pure. Backend-composed 'Name args'
    text is reused as-is (never 'Grep Grep …')."""
    r = row or {}
    name = str(r.get("tool_name") or r.get("name") or "tool")
    path = str(r.get("path") or "").strip()
    txt = str(r.get("text") or "")
    first = (txt.strip().splitlines() or [""])[0].strip()
    if first.lstrip().startswith("{"):
        first = ""
    if path:
        core = f"{name} {path}"
    elif first and first.lower().startswith(name.lower()):
        core = first  # already "Name args" from the timeline engine
    elif first:
        core = f"{name} {first}"
    else:
        core = name
    status = str(r.get("status") or "").strip().lower()
    word = TOOL_STATUS_WORDS.get(status,
        status.capitalize()[:10] if status else "")
    core = cell_trunc(core, max(10, width - (len(word) + 3 if word else 0)))
    return f"{core} {G('·')} {word}" if word else core

def diff_screen_lines(text, width):
    """Unified diff -> [(kind, line)]: whitespace and +/- signs kept,
    lines truncated (never wrapped — wrapping would detach a +/- sign from
    its content). Pure. kinds: diffhead|diffhunk|diffadd|diffdel|diffctx."""
    out = []
    w = max(10, width)
    for ln in (text or "").splitlines() or [""]:
        if ln.startswith("@@"):
            kind = "diffhunk"
        elif ln.startswith(("+++", "---", "diff ")):
            kind = "diffhead"
        elif ln.startswith("+"):
            kind = "diffadd"
        elif ln.startswith("-"):
            kind = "diffdel"
        else:
            kind = "diffctx"
        out.append((kind, cell_trunc(ln, w)))
    return out

