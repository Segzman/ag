def theme_pairs(name):
    import curses
    cols = {"black":0,"red":1,"green":2,"yellow":3,"blue":4,"magenta":5,"cyan":6,"white":7}
    spec = THEMES.get(name,THEMES["abyss"])
    if os.environ.get("NO_COLOR"):
        # monochrome: meaning rides on text markers (>, !, +/-, status
        # words) + reverse-video selection (select_attr), never color alone.
        th = {r: 0 for r in PAIR_ROLES.values()}
        th["rounded"] = spec.get("rounded",True)
        return th
    th = {}
    for i,r in enumerate(["header","user","tool","alert","border","active","dim"],1):
        fg,b = spec[r]
        try:
            curses.init_pair(i,cols.get(fg,7),-1)
            a = curses.color_pair(i)
        except Exception:
            a = 0
        if b==1: a |= curses.A_BOLD
        elif b=="dim": a |= getattr(curses,"A_DIM",0)
        th[r] = a
    # charcoal/blue surfaces: 256-color pairs when available, 8-color
    # fallback otherwise, attr 0 when curses is unusable (headless tests).
    try:
        ncol = curses.COLORS if hasattr(curses, "COLORS") else 0
    except Exception:
        ncol = 0
    use256 = ncol >= 256
    spec256 = THEME_256.get(name, THEME_256["abyss"])
    for i, r in ((10,"text"),(11,"accent"),(12,"composer"),(13,"rule"),
                 (14,"sel"),(15,"wordmark"),(16,"userfill"),
                 (17,"text_c"),(18,"dim_c"),(19,"text_u"),(20,"alert_c"),
                 (21,"diffadd"),(22,"diffdel")):
        try:
            if use256:
                fg, bg = spec256.get(r, (252, None))
                curses.init_pair(i, fg if isinstance(fg,int) else 7,
                                 bg if isinstance(bg,int) else -1)
                a = curses.color_pair(i)
            else:
                fb = THEME_8.get(name, THEME_8["abyss"]).get(r, "white")
                curses.init_pair(i, cols.get(fb,7), -1)
                a = curses.color_pair(i)
        except Exception:
            a = 0
        if r in ("accent","sel","wordmark","rule"):
            try: a |= curses.A_BOLD
            except Exception: pass
        th[r] = a
    th["rounded"] = spec.get("rounded",True)
    return th
