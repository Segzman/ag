        elif ch==ord("\t") and chats: active = (active+1)%len(chats); scroll = 0
        elif chats and tui_digit_index(ch, len(chats)) is not None:
            active = tui_digit_index(ch, len(chats)); scroll = 0
        elif ch==ord("m") and chats: open_modelpick()
        elif ch==ord("M") and chats: mode = "setmodel"; flow_inp = chats[active].get("model","") if chats else ""
        elif ch==ord("b") and chats: open_backendpick()
        elif ch==ord("P") and chats: open_profilepick()
        elif ch==ord("H") and chats:
            nm = chats[active]["name"]
            if agent_busy(sdir, nm):
                msg = f"{nm} is busy (turn or handoff running); retry when idle."
            else:
                r = native_launch(sdir, nm, "")
                if not r.get("ok"):
                    show_slash(nm, "/handoff", False, r.get("error", "handoff failed"))
                    msg = (r.get("error") or "handoff failed")[:60]
                else:
                    _tui_handoff_exec(stdscr, sdir, nm, r, show_slash)
                    msg = f"handoff {r.get('backend','')} done (see log)"
        elif ch==ord("R") and chats: open_rolepick()
        elif ch==ord("n"): mode = "newname"; flow_inp = ""
        elif ch==ord("d"):
            subs = [c["name"] for c in chats if c.get("role")!="orchestrator"] or [c["name"] for c in chats]
            mode = "dagent"; flow_inp = subs[0] if subs else ""
        elif ch==ord("c") and chats:
            cfg_idx = 0; cfg_return = ("chat", "input"); mode = "config"
        elif ch==ord("?"): help_return = ("chat", mode); mode = "help"
        elif ch in (ord("["),curses.KEY_PPAGE,curses.KEY_UP): scroll += 5
        elif ch in (ord("]"),curses.KEY_NPAGE,curses.KEY_DOWN): scroll = max(0,scroll-5)
        elif ch==ord("t"):
            names = list(THEMES)
            theme = names[(names.index(theme)+1)%len(names)] if theme in names else names[0]
            save_ui(sdir,theme); th = theme_pairs(theme); msg = f"theme -> {theme}"
        elif ch==ord("a"):
            try: pend = [r for r in json.loads((sdir/"approvals.json").read_text()) if r.get("status")=="pending"]
            except Exception: pend = []
            msg = f'approved {pend[0]["id"]}' if pend and approve_id(sdir,pend[0]["id"]) else "no pending approvals"
        elif isinstance(ch, str) and len(ch) == 1:
            # selection mode stays discoverable: unbound text returns to
            # the composer with that char.
            try: printable = ch.isprintable()
            except Exception: printable = True
            if printable:
                mode = "input"; inp += ch; slash_sync()
        elif isinstance(ch, int) and 32 <= ch <= 126:
            mode = "input"; inp += chr(ch); slash_sync()

