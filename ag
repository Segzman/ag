         "0 turns that limit off.", "")]
    for key in ("max_turns", "token_threshold", "keep_recent", "timeout"):
        label = COMPACT_ADV_META[key][0]
        rows.append(("edit", f"adv.{key}", f"  {label}",
                     str(st.get(key, ""))))
    rows.append(("act", "act.back", "Back", ""))
    return rows

def compact_help_for(view, rid, sdir=None, scope=None, agent_name=""):
    """Help line for the highlighted row. Pure. Plain words only."""
    if (rid or "") == "act.compact":
        return ("Summarize older messages now. Keeps the newest "
                "messages and full chat log.")
    if (rid or "").startswith("scope.orchestrator"):
        return "Changes orchestrators using these defaults."
    if (rid or "").startswith("scope.sub"):
        return "Changes subagents using these defaults."
    if (rid or "") == "scope.agent":
        if sdir is None:
            return ""
        return (f"Changes {agent_name} only "
                f"({compact_inherit_line(sdir, agent_name).lower()}).")
    if rid == "scope.onoff":
