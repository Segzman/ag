    ata=sub.add_parser("attach",help="jump into a live session terminal (Ctrl-] detaches)"); ata.add_argument("sess")
    fgt=sub.add_parser("forget",help="wipe a session's logs (auth traces)"); fgt.add_argument("sess")
    sub.add_parser("keys",help="control cheat-sheet")
    dg=sub.add_parser("delegate",help="orchestrator assigns harness-linked task to a sub"); dg.add_argument("agent"); dg.add_argument("text",nargs="*")
    sub.add_parser("shell",help="interactive REPL")
    sub.add_parser("selfcheck",help="run built-in checks")
    return p

def main(argv=None):
    if argv is None: argv = sys.argv[1:]
    # --json anywhere (agents type `ag run --json -- ...`)
    want_json = "--json" in argv
    argv = [x for x in argv if x != "--json"]
    p = build()
    a = p.parse_args(argv)
    if want_json: a.json = True
    if getattr(a, "version", False): print(VERSION); return 0
    if not getattr(a, "subcmd", None): p.print_help(); return 1
    # strip leading -- from run/spawn
    if a.subcmd in ("run","spawn") and getattr(a,"cmd",None) and a.cmd[0]=="--": a.cmd=a.cmd[1:]
    fn = {"run":do_run,"read":do_read,"write":do_write,"edit":do_edit,"ls":do_ls,
        "grep":do_grep,"note":do_note,"notes":do_notes,"todo":do_todo,"history":do_history,
        "approvals":do_approvals,"approve":do_approve,"shell":do_shell,"selfcheck":do_selfcheck,
        "spawn":do_spawn,"send":do_send,"snap":do_snap,"sessions":do_sessions,
        "kill":do_kill,"wait":do_wait,"events":do_events,"_daemon":do_daemon,
        "harness":do_harness,"agents":do_agents,"chat":do_chat,"status":do_status,
        "tui":do_tui,"attach":do_attach,"forget":do_forget,"keys":do_keys,
        "delegate":do_delegate}[a.subcmd]
    return fn(a)

if __name__=="__main__":
    sys.exit(main())
