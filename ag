TIMELINE_OMIT_LINES = 60

def chat_screen_lines(rows, stream_text, agent_name, width,
        omit_cap=TIMELINE_OMIT_LINES):
    """Flatten chat rows + live stream into wrapped display lines.
    Returns [(kind, text)]. Pure; kinds: uh|ah|body|delegate|tool|toolout|
    stream|hint|think|error|diffhead|diffhunk|diffadd|diffdel|diffctx|omit.
    Timeline roles (assistant/reasoning/tool/toolout/diff/error) render in
    chronological order interleaved with legacy rows: assistant shares the
    agent header (no repeated label per chunk); reasoning is a subdued
    'Thinking' section; tool rows with tool_name/status render as compact
    cards (Running/Done/Failed + useful args, never huge JSON); diffs keep
    whitespace and +/- signs (truncated, never wrapped); errors stay as
    visible '! …' lines. A final aggregate agent row carrying
    timeline_summary=true is suppressed only when assistant rows from
    the SAME turn already show the answer (replay path): the turn starts
    at the nearest preceding user row. Live stream_text is suppressed while timeline
    assistant rows exist (no double render). Any single row yielding more
    than omit_cap lines ends with an explicit omission marker."""
    out, prev = [], ""
    try:
        cap = max(5, int(omit_cap))
    except Exception:
        cap = TIMELINE_OMIT_LINES
    has_assistant = any((r or {}).get("role") == "assistant"
        and ((r or {}).get("text") or "").strip() for r in rows or [])
    def _same_turn_assistant(rows, idx):
        """True when an assistant row sits between the nearest preceding
        user row (the turn start) and rows[idx]. Pure."""
        start = 0
        for j in range(idx - 1, -1, -1):
            if ((rows[j] or {}).get("role") or "") == "user":
                start = j
                break
        else:
            # no user row above (trimmed history): only suppress when an
            # assistant row precedes the aggregate at all.
            start = 0
        for j in range(start, idx):
            rj = rows[j] or {}
            if (rj.get("role") or "") == "assistant" \
                    and (rj.get("text") or "").strip():
                return True
        return False
    def _omit(lines):
        if len(lines) <= cap:
            return lines
        return lines[:cap] + [("omit", f'{G("…")} ({len(lines) - cap} more '
            f'lines {G("·")} full text in chat log)')]
    for idx, r in enumerate(rows or []):
        role = (r or {}).get("role", "")
        text = (r or {}).get("text", "") or ""
        if role == "agent" and (r or {}).get("timeline_summary") \
                and _same_turn_assistant(rows, idx):
            prev = role
            continue  # replay aggregate duplicates the same-turn assistant rows
        if role == "assistant":
            if prev not in ("agent", "assistant"):
                out.append(("ah", f'{G("●")} {agent_name}'))
            segs = []
            for ln in text.splitlines() or [""]:
                segs += cell_wrap_line(ln, max(10, width - 2))
            out += [(k, f"  {s}" if k == "body" else s) for k, s in
                _omit([("body", s) for s in segs])]
            prev = role
            continue
        if role == "reasoning":
            if prev != "reasoning":
                out.append(("think", f'{G("▸")} Thinking'))
            segs = []
            for ln in text.splitlines() or [""]:
                segs += cell_wrap_line(ln, max(10, width - 2))
            out += [(k, f"  {s}" if k == "think" else s) for k, s in
                _omit([("think", s) for s in segs])]
            prev = role
            continue
        if role == "diff":
            path = str((r or {}).get("path") or "").strip()
            if path:
                out.append(("diffhead", f'{G("─") * 2} {path}'))
            out += _omit(diff_screen_lines(text, max(10, width - 2)))
            prev = role
            continue
        if role == "error":
            segs = []
            for ln in text.splitlines() or [""]:
                segs += cell_wrap_line(ln, max(10, width - 2))
            out += [(k, f'! {s}' if k == "error" else s) for k, s in
                _omit([("error", s) for s in segs])]
            prev = role
            continue
        if role == "tool" and ((r or {}).get("tool_name")
                or (r or {}).get("status") or (r or {}).get("path")):
            out.append(("tool",
                f'{G("◆")} {timeline_tool_summary(r, max(20, width - 3))}'))
            prev = role
            continue
        lines = []
        for ln in text.splitlines() or [""]:
            if role in ("user", "agent"):
                segs = wrap_chat_line(ln, max(10, width - 2))
                if role == "user":
                    if prev != "user":
                        lines.append(("uh", f'{G("●")} you'))
                    lines += [("body", f"  {s}") for s in segs]
                else:
                    if prev not in ("agent", "assistant"):
                        lines.append(("ah", f'{G("●")} {agent_name}'))
                    lines += [("body", f"  {s}") for s in segs]
            elif role in ("delegate", "summary"):
                lines += [("delegate", f'{G("◆")} {s}')
                    for s in wrap_chat_line(ln, max(10, width - 2))]
            elif role == "tool":
                lines += [("tool", f'{G("└")}─ {s}')
                    for s in wrap_chat_line(ln, max(10, width - 3))]
            elif role == "toolout":
                lines += [("toolout", f"   {s}")
                    for s in wrap_chat_line(ln, max(10, width - 3))]
            else:
                lines += [("body", s) for s in wrap_chat_line(ln, width)]
        out += _omit(lines)
        prev = role
    if stream_text and not has_assistant:
        for seg in wrap_chat_line(stream_text[-300:], max(10, width - 2)):
            out.append(("stream", f'{G("◌")} {seg}'))
    if not out:
        out = [("hint", "No messages yet — type a message and Enter to send."),
               ("hint", "enter send · / commands · esc back · arrows scroll · ? help")]
    return out

