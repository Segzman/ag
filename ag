                "Off: only manual summaries.")
    if rid == "scope.cadence":
        return ("Named choices; Custom when values differ. "
                "Never turns summaries on or off.")
    if rid == "scope.advanced":
        return "Exact limits, kept messages, and time limit."
    if rid == "act.reset":
        return "Go back to the shared settings (drops custom ones)."
    if rid == "act.back":
        return "Return to the previous screen."
    if (rid or "").startswith("preset."):
        return "Uses the exact limits shown; On/Off stays as it is."
    if (rid or "").startswith("onoff."):
