    p.add_argument("--json", action="store_true", help="machine-readable JSON output")
    p.add_argument("--version", action="store_true")
    sub = p.add_subparsers(dest="subcmd")
    r = sub.add_parser("run", help="run shell cmd, logged"); r.add_argument("--timeout",type=int,default=30)
    r.add_argument("--cwd",default=None); r.add_argument("--env",action="append",default=[])
    r.add_argument("--force",action="store_true"); r.add_argument("cmd",nargs=argparse.REMAINDER)
    rd = sub.add_parser("read",help="read file numbered"); rd.add_argument("path")
