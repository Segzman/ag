def live_session_count(sdir):
    """Running pty sessions. Light probe, no reconcile writes. Never raises."""
    try:
        n = 0
        for d in _sroot(sdir).iterdir():
            if not d.is_dir(): continue
            try: st = json.loads((d/"status.json").read_text())
            except Exception: continue
            if st.get("running") and st.get("exit") is None and not st.get("stale"):
                n += 1
        return n
    except Exception:
        return 0

