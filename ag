# ---- portable task snapshots (outbound SSH, no native runtime migration) ----
SYNC_WIRE_MAX = 8 * 1024 * 1024
SYNC_FILE_MAX = 1024 * 1024
SYNC_TOTAL_MAX = 4 * 1024 * 1024
SYNC_TEXT_MAX = 24000

class SyncTransportError(ValueError): pass

def _sync_json(obj): return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
def _sync_hash(obj): return hashlib.sha256(_sync_json(obj).encode()).hexdigest()
def _sync_name(name):
    if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", name):
        raise ValueError("name must be 1-64 letters, digits, dots, underscores or hyphens")
    return name

def _sync_same_path(a, b):
    """Same path modulo symlinks/normalization (e.g. /var -> /private/var on macOS).

    Remote paths are configured as strings but the source reports resolved
    paths; require equality after normalization or resolution. Resolution is
    best-effort only and never widens identity: agent name is still exact."""
    if a == b: return True
    if not isinstance(a, str) or not isinstance(b, str): return False
    try:
        if os.path.normpath(a) == os.path.normpath(b): return True
        return Path(a).expanduser().resolve(strict=False) == Path(b).expanduser().resolve(strict=False)
    except (OSError, RuntimeError): return False

def _sync_read(path, cap=SYNC_WIRE_MAX):
    with open(path, "rb") as f: raw = f.read(cap + 1)
    if len(raw) > cap: raise ValueError(f"file exceeds size limit: {path}")
    return raw

def _sync_write(path, value, root):
    """Private, unique temporary file + fsync + atomic replace, confined to root."""
    import tempfile
    path, root = Path(path), Path(root)
    if _ctx_escape(path, root): raise ValueError(f"unsafe state path: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".sync-", dir=str(path.parent))
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(value if isinstance(value, bytes) else value.encode())
            f.flush(); os.fsync(f.fileno())
        os.replace(tmp, path)
        dfd = os.open(path.parent, os.O_RDONLY)
        try: os.fsync(dfd)
        finally: os.close(dfd)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

def _sync_hosts(sdir):
    p = sdir/"sync"/"hosts.json"
    if not p.exists(): return {}
    if _ctx_escape(p, sdir): raise ValueError("unsafe hosts path")
    result = json.loads(_sync_read(p, 65536))
    if not isinstance(result, dict): raise ValueError("invalid hosts registry")
    return result

def _sync_host(sdir, name):
    hosts = _sync_hosts(sdir)
    if name not in hosts: raise ValueError(f"unknown host: {name}")
    return hosts[name]

def _sync_remote(host, args, timeout=30):
    """SSH argv is local configuration; quote every remote-shell argument once.
    Bound both streams and wall time; an SSH failure never proves source death."""
    import selectors
    remote = [host["remote_ag"], "--dir", host["remote_state"], "--json"] + args
    cmd = list(host["ssh"]) + [shlex.join(remote)]
    buffers = {"out": bytearray(), "err": bytearray()}
    deadline = time.monotonic() + timeout
    try:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as e: raise SyncTransportError(f"cannot start SSH: {e}") from e
    try:
        with selectors.DefaultSelector() as sel:
            sel.register(p.stdout, selectors.EVENT_READ, "out")
            sel.register(p.stderr, selectors.EVENT_READ, "err")
            while sel.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0: raise SyncTransportError("SSH timed out; source may still be running")
                for key, _ in sel.select(min(remaining, 1)):
                    chunk = os.read(key.fileobj.fileno(), 65536)
                    if not chunk: sel.unregister(key.fileobj); continue
                    buffers[key.data].extend(chunk)
                    if len(buffers[key.data]) > (SYNC_WIRE_MAX if key.data == "out" else 65536):
                        raise ValueError("remote response exceeds size limit")
            try: rc = p.wait(timeout=max(.01, deadline - time.monotonic()))
            except subprocess.TimeoutExpired: raise SyncTransportError("SSH timed out; source may still be running")
        if rc == 255: raise SyncTransportError("SSH unavailable; source may still be running")
        if rc: raise ValueError(f"remote command failed (exit {rc}): {buffers['out'].decode(errors='replace')[:400]}")
        try: response = json.loads(buffers["out"])
        except (ValueError, UnicodeError): raise ValueError("incomplete or invalid remote response")
        if not isinstance(response, dict) or response.get("ok") is not True or not isinstance(response.get("data"), dict):
            raise ValueError("remote command did not return successful JSON")
        return response["data"]
    finally:
        if p.poll() is None: p.kill()
        p.wait()
        p.stdout.close(); p.stderr.close()

def _sync_file_name(value):
    if not isinstance(value, str) or not value or "\\" in value or "\x00" in value:
        raise ValueError("invalid project file path")
    parts = value.split("/")
    if any(p in ("", ".", "..") for p in parts): raise ValueError("project files must be relative without dot segments")
    # Reject known credential/runtime/config stores even when selected explicitly.
    denied = {".git", ".agent", ".ssh", ".aws", ".azure", ".config", ".codex", ".claude", ".opencode", ".gnupg", "node_modules"}
    if any(p in denied or p == '.env' or p.startswith('.env.') or p.lower().endswith(('.pem', '.key')) or p in ('auth.json', 'credentials.json', 'id_ed25519', 'id_rsa', '.npmrc', '.netrc') for p in parts):
        raise ValueError(f"credential/config/runtime path is not portable: {value}")
    return value

def _sync_source_agent(sdir, name, project):
    rows = {r['name']: r for r in load_agents(sdir)}
    if name not in rows: raise ValueError(f"unknown agent: {name}")
    agent = rows[name]
    adir = agent.get('dir', '.') or '.'
    if not Path(adir).is_absolute():
        raise ValueError(f"agent '{name}' has a relative --dir ('{adir}'); sync cannot infer the remote working directory over SSH (sshd starts at $HOME). Register an absolute dir: ag agents set {name} --dir <absolute path>")
    root = Path(project).resolve()
    if not root.is_dir() or Path(adir).resolve() != root:
        raise ValueError("agent/project mismatch")
    assignment = ctx_load_assignments(sdir).get(name, {})
    if assignment and assignment.get('project') != str(root): raise ValueError("context/project mismatch")
    return agent, root, assignment

def _sync_request(sdir, name):
    """Bounded chat tail and newest queued/running wake, no transcript export."""
    latest, stamp = '', ''
    path = chat_log_path(sdir, name)
    if path.is_file() and not _ctx_escape(path, sdir):
        with open(path, 'rb') as f:
            f.seek(0, 2); size = f.tell(); f.seek(max(0, size - 256 * 1024))
            raw = f.read(256 * 1024)
        lines = raw.splitlines()
        if size > 256 * 1024: lines = lines[1:]
        for line in lines:
            try: row = json.loads(line)
            except (ValueError, UnicodeError): continue
            if row.get('role') == 'user': latest, stamp = row.get('text', '')[:SYNC_TEXT_MAX], row.get('ts', '')
    jobs = sdir/'wake'/'jobs'
    if jobs.is_dir() and not _ctx_escape(jobs, sdir):
        for path in jobs.glob('*.json'):
            if _ctx_escape(path, sdir): continue
            try: row = json.loads(_sync_read(path, 65536))
            except (ValueError, OSError): continue
            if row.get('agent') == name and row.get('status') in ('queued', 'running') and row.get('ts', '') >= stamp:
                latest, stamp = row.get('message', '')[:SYNC_TEXT_MAX], row.get('ts', '')
    return latest

def _sync_export(sdir, name, project, selected, message=None):
    import base64
    agent, root, assignment = _sync_source_agent(sdir, name, project)
    if len(selected) > 64: raise ValueError('at most 64 selected files')
    files, total = [], 0
    for rel in sorted(set(selected)):
        _sync_file_name(rel)
        p = root/rel
        if _ctx_escape(p, root) or not p.is_file(): raise ValueError(f'unsafe or missing project file: {rel}')
        if sdir == p or sdir in p.parents: raise ValueError('state files are not portable')
        raw = _sync_read(p, SYNC_FILE_MAX); total += len(raw)
        if total > SYNC_TOTAL_MAX: raise ValueError('selected files exceed total size limit')
        files.append(dict(path=rel, data=base64.b64encode(raw).decode(), sha256=hashlib.sha256(raw).hexdigest()))
    ctx = get_agent_context(sdir, name)
    scope = assignment.get('scope', '')
    memdir = ctx_agent_dir(_ctx_root(sdir)/'p'/ctx_projkey(root), scope, name)
    memories = {}
    for key, filename in [('brief', 'BRIEF.md'), ('checkpoint', 'CHECKPOINT.md')]:
        memories[key] = _ctx_read_one(memdir/filename, key, CTX_PER_FILE, stop=sdir)[0]
    payload = dict(schema=1, source=dict(agent=name, project=str(root), state=str(sdir)),
        agent={key: agent.get(key, '') for key in ('backend', 'model', 'role')},
        assignment={key: assignment.get(key, '') for key in ('scope', 'task', 'acceptance')},
        context=ctx['text'], memories=memories,
        message=message if message is not None else _sync_request(sdir, name), files=files)
    _sync_validate(payload)
    return dict(snapshot=_sync_hash(payload), payload=payload, captured_at=now_iso(),
        busy=agent_busy(sdir, name), warnings=ctx['warnings'], requested_project=project)

def _sync_validate(payload):
    import base64
    if not isinstance(payload, dict) or payload.get('schema') != 1: raise ValueError('unsupported snapshot schema')
    if set(payload) != {'schema','source','agent','assignment','context','memories','message','files'}: raise ValueError('unexpected snapshot fields')
    for key, fields in [('source', {'agent','project','state'}), ('agent', {'backend','model','role'}), ('assignment', {'scope','task','acceptance'}), ('memories', {'brief','checkpoint'})]:
        obj = payload.get(key)
        if not isinstance(obj, dict) or set(obj) != fields or any(not isinstance(v, str) or len(v) > SYNC_TEXT_MAX for v in obj.values()):
            raise ValueError(f'invalid snapshot {key}')
    for key in ('context', 'message'):
        if not isinstance(payload.get(key), str) or len(payload[key]) > SYNC_TEXT_MAX: raise ValueError(f'invalid snapshot {key}')
    if payload['agent']['backend'] not in ('claude','opencode','gemini','codex','cursor','echo'): raise ValueError('unsupported backend')
    if ctx_validate_scope(payload['assignment']['scope']) is None: raise ValueError('invalid scope')
    files, seen, total = payload['files'], set(), 0
    if not isinstance(files, list) or len(files) > 64: raise ValueError('invalid file manifest')
    for f in files:
        if not isinstance(f, dict) or set(f) != {'path','data','sha256'}: raise ValueError('invalid file entry')
        rel = _sync_file_name(f['path'])
        if rel in seen: raise ValueError('duplicate project file')
        seen.add(rel)
        if not isinstance(f['data'], str) or len(f['data']) > 4 * ((SYNC_FILE_MAX + 2)//3): raise ValueError('file exceeds size limit')
        try: raw = base64.b64decode(f['data'], validate=True)
        except (ValueError, TypeError): raise ValueError('invalid file encoding')
        if len(raw) > SYNC_FILE_MAX or hashlib.sha256(raw).hexdigest() != f['sha256']: raise ValueError('file size/hash mismatch')
        total += len(raw)
    if total > SYNC_TOTAL_MAX: raise ValueError('selected files exceed total size limit')

def do_hosts(a):
    sdir = state_dir(a.dir).resolve(); ensure_state(sdir)
    try:
        hosts = _sync_hosts(sdir)
        if a.hostsub == 'list': return emit(a, 'hosts', {'hosts': hosts})
        if a.hostsub == 'check':
            host = _sync_host(sdir, a.host)
            result = _sync_remote(host, ['sync', '_probe', '--project', host['remote_project']], a.timeout)
            return emit(a, 'hosts', {'reachable': True, **result})
        _sync_name(a.host)
        ssh = json.loads(a.ssh_json)
        if not isinstance(ssh, list) or len(ssh) < 2 or any(not isinstance(x, str) or not x or '\x00' in x or '\n' in x for x in ssh):
            raise ValueError('--ssh-json must be an argv array including executable, options and destination')
        for value in (a.remote_ag, a.remote_state, a.remote_project):
            if not Path(value).is_absolute() or '\x00' in value: raise ValueError('remote paths must be absolute')
        local = Path(a.local_project).expanduser().resolve()
        if not local.is_dir(): raise ValueError('local project must exist')
        lk = _ctx_lock(sdir)
        try:
            hosts = _sync_hosts(sdir)
            if a.host in hosts: raise ValueError('host already exists; use a new name to preserve snapshot identity')
            hosts[a.host] = dict(ssh=ssh, remote_ag=a.remote_ag, remote_state=a.remote_state, remote_project=a.remote_project, local_project=str(local))
            _sync_write(sdir/'sync'/'hosts.json', _sync_json(hosts), sdir)
        finally: _ctx_unlock(lk)
        return emit(a, 'hosts', {'host': a.host, **hosts[a.host]})
    except (ValueError, OSError, KeyError, TypeError) as e: return emit(a, 'hosts', error=str(e))

def _sync_pull(sdir, a):
    host = _sync_host(sdir, a.host)
    args = ['sync', '_export', a.agent, '--project', host['remote_project']]
    for rel in a.file: args += ['--file', rel]
    if a.message is not None: args += ['--message', a.message]
    data = _sync_remote(host, args, a.timeout)
    payload = data.get('payload'); _sync_validate(payload)
    source = payload.get('source', {})
    if source.get('agent') != a.agent: raise ValueError('source identity/project mismatch')
    if data.get('requested_project') != host['remote_project']:
        if 'requested_project' in (data or {}): raise ValueError('source identity/project mismatch')
        # Remotes predating the request echo: local-normalization fallback.
        if not _sync_same_path(source.get('project', ''), host['remote_project']) or not _sync_same_path(source.get('state', ''), host['remote_state']):
            raise ValueError('source identity/project mismatch')
    # Remote-canonical cross-check: two independent remote commands must report
    # the same resolved paths. The strings are compared to each other exactly;
    # remote paths are never resolved on the local filesystem (per-OS symlinks
    # such as /var vs /private/var differ across hosts).
    try:
        probe = _sync_remote(host, ['sync', '_probe', a.agent, '--project', host['remote_project']], a.timeout)
    except SyncTransportError:
        raise ValueError('source identity/project mismatch')
    if probe.get('project') != source.get('project') or probe.get('state') != source.get('state'):
        raise ValueError('source identity/project mismatch')
    sid = _sync_hash(payload)
    if data.get('snapshot') != sid: raise ValueError('snapshot checksum mismatch')
    record = dict(schema=1, snapshot=sid, host=a.host, host_hash=_sync_hash(host), captured_at=data['captured_at'], payload=payload,
        requested_project=host['remote_project'], requested_state=host['remote_state'])
    dest = sdir/'sync'/'snapshots'/(sid+'.json')
    if not dest.exists(): _sync_write(dest, _sync_json(record), sdir)
    elif _ctx_escape(dest, sdir) or json.loads(_sync_read(dest)).get('payload') != payload: raise ValueError('existing snapshot is corrupt')
    latest = dict(snapshot=sid, host=a.host, agent=a.agent, pulled_at=now_iso(), path=str(dest), source_busy=data.get('busy'), warnings=data.get('warnings', []))
    _sync_write(sdir/'sync'/'latest'/(_sync_hash([a.host,a.agent])+'.json'), _sync_json(latest), sdir)
    return latest

def _sync_resume(sdir, a):
    import base64
    if not a.source_stopped: raise ValueError('--source-stopped is required: stop/fence the source and prevent restart before resuming')
    _sync_name(a.name)
    if not re.fullmatch(r'[a-f0-9]{64}', a.snapshot): raise ValueError('invalid snapshot ID')
    path = sdir/'sync'/'snapshots'/(a.snapshot+'.json')
    if _ctx_escape(path, sdir): raise ValueError('unsafe snapshot path')
    record = json.loads(_sync_read(path)); payload = record.get('payload'); _sync_validate(payload)
    if record.get('snapshot') != a.snapshot or _sync_hash(payload) != a.snapshot: raise ValueError('snapshot checksum mismatch')
    host = _sync_host(sdir, record['host'])
    if record.get('host_hash') != _sync_hash(host): raise ValueError('host mapping changed since snapshot')
    project = Path(a.project).expanduser().resolve()
    if str(project) != host['local_project'] or not project.is_dir(): raise ValueError('destination project/mapping mismatch')
    source = payload['source']
    if record.get('requested_project') is not None or record.get('requested_state') is not None:
        # Exact match against the configured strings recorded at pull time.
        # Remote paths are never resolved locally (per-OS symlinks differ);
        # mapping drift is already refused via host_hash above.
        if record.get('requested_project') != host['remote_project'] or record.get('requested_state') != host['remote_state']:
            raise ValueError('snapshot source mismatch')
    elif not _sync_same_path(source['project'], host['remote_project']) or not _sync_same_path(source['state'], host['remote_state']):
        raise ValueError('snapshot source mismatch')
    source_verified = False
    try:
        status = _sync_remote(host, ['sync', '_probe', source['agent'], '--project', host['remote_project']], a.timeout)
        if status.get('busy') is not False: raise ValueError('source is busy or status is unknown; stop it and check terminal state first')
        source_verified = True
    except SyncTransportError:
        # Explicit acknowledgement, never an automatic timeout-driven failover.
        pass
    run_budget = 0
    if a.run:
        # Fail fast on a bad flag: validation runs before any local write.
        run_budget = _valid_runtime(getattr(a, 'max_runtime', 1800))
        if run_budget is None: raise ValueError('invalid --max-runtime: need finite seconds >= 0 (0 = unlimited)')
    lk = _ctx_lock(sdir)
    try:
        rows = load_agents(sdir)
        if any(r['name'] == a.name for r in rows): raise ValueError('destination agent already exists; choose a fresh name')
        # A removed roster entry may still own a conversation. Never reuse it.
        if chat_log_path(sdir, a.name).exists() or (chat_dir(sdir)/(a.name + '.meta.json')).exists(): raise ValueError('destination name has existing native/chat state')
        if agent_busy(sdir, a.name): raise ValueError('destination agent is busy')
        for f in payload['files']:
            dest = project/f['path']
            if _ctx_escape(dest, project) or dest.exists(): raise ValueError(f'refusing existing or unsafe destination: {f["path"]}')
            if sdir == dest or sdir in dest.parents: raise ValueError('cannot extract project files into state')
        # Recheck source immediately before creating the fresh local assignment.
        # User's acknowledgement is still responsible for fencing future launches.
        # A model ID from the source harness must never leak into a different
        # backend override (foreign provider IDs are invalid there). Stored
        # 'default' resolves per backend (Muse Spark on opencode via
        # eff_model); an explicit --model always wins.
        _src = payload['agent']
        _backend = a.backend or _src['backend']
        if a.model: _model = a.model
        elif a.backend and a.backend != _src['backend']: _model = 'default'
        else: _model = _src['model'] or 'default'
        agent = dict(name=a.name, backend=_backend, model=_model, role=_src['role'] or 'sub', dir=str(project), instructions=[], system='', persona='')
        asg = dict(payload['assignment'], project=str(project), files=[], updated=now_iso())
        memdir = ctx_agent_dir(_ctx_root(sdir)/'p'/ctx_projkey(project), asg['scope'], a.name)
        for key, filename in [('brief','BRIEF.md'), ('checkpoint','CHECKPOINT.md')]:
            _sync_write(memdir/filename, payload['memories'][key], sdir)
        message = ('Continue this transferred task in a fresh backend session. The snapshot may be stale; verify files and external effects before repeating work.\n\n'
            + payload['context'] + '\n\nLatest source request:\n' + (payload['message'] or payload['assignment']['task']))
        msgpath = sdir/'sync'/'resumes'/(_ctx_safe_agent(a.name)+'.txt')
        _sync_write(msgpath, message, sdir)
        for f in payload['files']:
            dest = project/f['path']; dest.parent.mkdir(parents=True, exist_ok=True)
            # Exclusive create never overwrites a file appearing after preflight.
            with open(dest, 'xb') as out: out.write(base64.b64decode(f['data']))
        assignments = ctx_load_assignments(sdir); assignments[a.name] = asg
        ctx_save_assignments(sdir, assignments)
        rows.append(agent)
        _sync_write(sdir/'agents.json', json.dumps(rows, indent=2), sdir)
    finally: _ctx_unlock(lk)
    result = dict(snapshot=a.snapshot, agent=a.name, project=str(project), source_verified=source_verified,
        source_stopped_acknowledged=True, captured_at=record['captured_at'], message_path=str(msgpath), fresh_session=True)
    if a.run:
        result['turn'] = run_turn(sdir, a.name, message, timeout_s=run_budget)
        t = result['turn']
        # No rollback: the prepared agent and extracted files are valid and
        # kept. Recover by sending the saved message to the prepared agent
        # (do not rerun resume: the name is taken); both are named here.
        if t.get('timed_out'):
            raise ValueError(f"agent '{a.name}' prepared, but turn timed out: {t.get('error') or 'max-runtime exceeded'}; retry the saved message with: ag chat send {a.name} \"$(cat \"{msgpath}\")\"")
        if t.get('error') or t.get('exit', 0) != 0:
            excerpt = ' '.join(str(t.get('reply') or '').split())[:160]
            raise ValueError(f"agent '{a.name}' prepared, but turn failed (exit {t.get('exit', 1)}): {t.get('error') or excerpt or 'backend failed'}; retry the saved message with: ag chat send {a.name} \"$(cat \"{msgpath}\")\"")
    return result

def do_sync(a):
    sdir = state_dir(a.dir).resolve(); ensure_state(sdir)
    try:
        if a.syncsub == '_probe':
            if not Path(a.project).is_dir(): raise ValueError('missing remote project')
            result = dict(protocol=1, project=str(Path(a.project).resolve()), state=str(sdir))
            if a.agent:
                _sync_source_agent(sdir, a.agent, a.project)
                result['busy'] = agent_busy(sdir, a.agent)
            return emit(a, 'sync', result)
        if a.syncsub == '_export':
            return emit(a, 'sync', _sync_export(sdir, a.agent, a.project, a.file, a.message))
        if a.syncsub == 'list':
            root = sdir/'sync'/'latest'
            if _ctx_escape(root, sdir): raise ValueError('unsafe snapshot index')
            records = [json.loads(_sync_read(p, 65536)) for p in root.glob('*.json') if not _ctx_escape(p, sdir)]
            return emit(a, 'sync', {'latest': records})
        if a.syncsub == 'resume': return emit(a, 'sync', _sync_resume(sdir, a))
        if a.watch is not None and a.watch < 1: raise ValueError('--watch interval must be at least 1 second')
        while True:
            try: code = emit(a, 'sync', _sync_pull(sdir, a))
            except (ValueError, OSError, KeyError, TypeError) as e:
                code = emit(a, 'sync', error=str(e))
            sys.stdout.flush(); sys.stderr.flush()
            if a.watch is None: return code
            time.sleep(a.watch)
    except KeyboardInterrupt: return 130
    except (ValueError, OSError, KeyError, TypeError) as e: return emit(a, 'sync', error=str(e))


def main(argv=None):
    if argv is None: argv = sys.argv[1:]
    # Global --json only before explicit `--` boundary. Tokens after the
    # first bare `--` are child args (defect 1): never strip there, so
    # `ag run -- echo --json` preserves child --json and stays text mode.
    # `ag run --json -- echo hi` / `ag --json run -- ...` still enable JSON.
    if "--" in argv:
        cut = argv.index("--")
        head, tail = argv[:cut], argv[cut:]
    else:
        head, tail = argv, []
    want_json = "--json" in head
    head = [x for x in head if x != "--json"]
    argv = head + tail
    p = build()
    a = p.parse_args(argv)
    if want_json: a.json = True
    if getattr(a, "version", False): print(VERSION); return 0
    if not getattr(a, "subcmd", None): p.print_help(); return 1
    # strip leading -- from run/spawn
    if a.subcmd in ("run","spawn") and getattr(a,"cmd",None) and a.cmd[0]=="--": a.cmd=a.cmd[1:]
    fn = {"run":do_run,"read":do_read,"write":do_write,"edit":do_edit,"ls":do_ls,
        "grep":do_grep,"note":do_note,"notes":do_notes,"todo":do_todo,"history":do_history,
        "approvals":do_approvals,"approve":do_approve,"shell":do_shell,"selfcheck":do_selfcheck,
        "spawn":do_spawn,"send":do_send,"snap":do_snap,"sessions":do_sessions,
        "kill":do_kill,"wait":do_wait,"events":do_events,"_daemon":do_daemon,
        "harness":do_harness,"agents":do_agents,"roles":do_roles,"chat":do_chat,"status":do_status,
        "handoff":do_handoff,"hosts":do_hosts,"sync":do_sync,
        "tui":do_tui,"attach":do_attach,"forget":do_forget,"keys":do_keys,
        "delegate":do_delegate,"wake":do_wake,"wakes":do_wakes,"context":do_context,"compact":do_compact,
        "_wake_run":do__wake_run}[a.subcmd]
    return fn(a)

if __name__=="__main__":
    sys.exit(main())
