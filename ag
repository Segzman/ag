def setup_ui_pick(want="", platform=None, env=None, tty=True):
    """Front-end: explicit --ui/AG_SETUP_UI wins (mac = web; cli needs a TTY, else plain);
    auto = web on a local macOS desktop (no SSH), else cli on a TTY, else plain. Pure."""
    platform, env = platform or sys.platform, os.environ if env is None else env
    if want in ("web", "mac"): return "web"
    if want == "plain": return "plain"
    if not want and platform == "darwin" and not (env.get("SSH_CONNECTION") or env.get("SSH_TTY")): return "web"
    return "cli" if tty else "plain"

def _setup_bg_refresh(wait=1.0):
    """Refresh stale model lists in a daemon thread, blocking the first screen <= `wait`s. Pickers read
    the cache each time, so a late finish shows up in the next picker."""
    c = _models_read()
    if not any(_age_s((c["backends"].get(b) or {}).get("checked_at")) > MODELS_TTL_S for b in MODEL_BACKENDS): return None
    def run():
        try: models_load()
        except Exception: pass
    t = threading.Thread(target=run, daemon=True, name="ag-setup-models"); t.start(); t.join(wait)
    return t

def setup_backend_status(wait=1.0):
    """{b: 'v1.2 · auth yes · 92 models · fetched 3h ago'}: provider probe refreshed <= wait s (AG_PROBE=0: cache only)."""
    snap = {}
    if os.environ.get("AG_PROBE", "1") != "0":
        try: snap = providers_snapshot(list(BACKEND_TABS), deadline=wait)
        except Exception: snap = {}
    cache = _json_or_empty(_providers_path())
    out = {}
    for b in BACKEND_TABS:
        r = snap.get(b) or (cache.get(b) if isinstance(cache.get(b), dict) else {})
        inst = (r.get("version") or "installed") if r.get("installed", r.get("ok")) else "not installed" if r else "not probed"
        out[b] = f'{inst} · auth {r.get("auth") or "unknown"} · ' + setup_models_info(b).split(" · ", 1)[1]
    return out

