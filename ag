def ag_wordmark_lines(size="full"):
    """Centered ASCII 'ag' wordmark. Pure. full=5 rows, small=3, tiny=1."""
    if size == "tiny":
        return ["  __ _  __ _ "]
    if size == "small":
        return ["  __ _  __ _ ",
                " / _` |/ _` |",
                " \\__,_|\\__,_|"]
    return ["  __ _  __ _ ",
            " / _` |/ _` |",
            " | (_| | (_| |",
            "  \\__,_|\\__, |",
            "        |___/ "]

