# ---- scoped agent context: custom.md guidance + persistent memory ----
# ponytail: file-backed Markdown under sdir/context, isolated by canonical
# project root + scope. Ceilings: no pruning/rotation, last-write-wins HANDOFF.
CTX_PER_FILE = 6000
CTX_TOTAL = 18000
CTX_RESERVE = 4000
CTX_SCOPE_RE = re.compile(r"^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$")

def _ctx_lock_path(sdir): return _ctx_root(sdir)/".lock"
def _ctx_lock(sdir):
    """Blocking state lock for context read-modify-write (POSIX flock)."""
    if os.name != "posix": return None
    import fcntl
    _ctx_root(sdir).mkdir(parents=True, exist_ok=True)
    f = open(_ctx_lock_path(sdir), "a+b")
    fcntl.flock(f.fileno(), fcntl.LOCK_EX)
    return f
def _ctx_unlock(f):
    if f is None: return
    try:
        import fcntl
        fcntl.flock(f.fileno(), fcntl.LOCK_UN)
    except Exception: pass
    try: f.close()
    except Exception: pass

def _ctx_root(sdir): return Path(sdir)/"context"
def _ctx_assign_path(sdir): return _ctx_root(sdir)/"assignments.json"
def _ctx_projects_path(sdir): return _ctx_root(sdir)/"projects.json"
