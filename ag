def recent_history(sdir,name,limit=4000):
    rows = [r for r in load_chat_log(sdir,name) if r.get("role") in ("user","agent")][-10:]
    return "\n".join(f'{r["role"]}: {r.get("text","")}' for r in rows)[-limit:]

_RUNNING, _RUN_LOCK = {}, threading.Lock()
def mark_running(name,on):
    with _RUN_LOCK:
        if on: _RUNNING[name]=True
        else: _RUNNING.pop(name,None)
def is_running(name):
    with _RUN_LOCK: return name in _RUNNING

def run_turn(sdir,name,text,on_event=None):
    """One prompt turn. on_event(name,kind,text). Returns {sid,exit,reply} or {error}."""
    agents = {x["name"]:x for x in load_agents(sdir)}
    if name not in agents: return {"error":f"no such agent: {name} (ag agents list)"}
    a = agents[name]
    backend = a.get("backend","claude")
    model = a.get("model","default") or "default"
    workdir = a.get("dir",".") or "."
    meta = load_chat_meta(sdir,name,agent=a)
    sid = meta.get("sid","")
    hist = "" if (sid and backend in ("claude","opencode","cursor")) else recent_history(sdir,name)
    prompt = (hist+"\n\n---\n"+text) if hist else text
    try: argv = backend_argv(backend,model=model,workdir=workdir,sid=sid,prompt=prompt)
    except ValueError as e: return {"error":str(e)}
    append_chat(sdir,name,"user",text)
    mark_running(name,True)
    chunks, sid_new, rc, err = [], "", 0, ""
    try:
        p = subprocess.Popen(argv,cwd=workdir,stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,text=True,bufsize=1)
        for line in p.stdout:
            for kind,txt in parse_events(backend,line):
                if kind=="meta":
                    if txt and not sid_new:
                        sid_new=txt; meta["sid"]=txt; save_chat_meta(sdir,name,meta)
                elif kind=="text":
                    if txt: chunks.append(txt)
                    if on_event: on_event(name,"text",txt)
                elif kind=="tool":
                    append_chat(sdir,name,"tool",txt)
                    _event(sdir,"tool",name,tool=txt[:200])
                    if on_event: on_event(name,"tool",txt)
                elif kind=="toolout":
                    append_chat(sdir,name,"toolout",txt[:1000])
                    _event(sdir,"toolout",name,out=txt[:200])
                    if on_event: on_event(name,"toolout",txt)
                elif kind=="done" and on_event: on_event(name,"done",txt)
        err = p.stderr.read() or ""
        rc = p.wait()
    except FileNotFoundError:
        rc = 127
        chunks = [f"backend binary missing (ag agents doctor)"]
    except Exception as e:
        rc = 1; chunks = [f"error: {e}"]
    finally:
        mark_running(name,False)
    full = "\n".join(c for c in chunks if c).strip()
    if not full and rc!=0:
        full = (err.strip().splitlines()[-3:] or ["(failed)"])[-1][:500]
        full = f"(exit {rc}) {full}"
    full = full or "(no output)"
    append_chat(sdir,name,"agent",full)
    _event(sdir,"chat",name,exit=rc)
    if on_event: on_event(name,"exit",str(rc))
    return {"sid":sid_new or sid,"exit":rc,"reply":full}

def do_chat(a):
    sdir = state_dir(a.dir); ensure_state(sdir)
    if a.sub=="send":
        text = " ".join(a.text or []).strip()
        if not text: return emit(a,"chat",error="empty message")
        live = not getattr(a,"json",False)
        r = run_turn(sdir,a.name,text,
            on_event=(lambda n,k,t: print(t) if live and k=="text" and t else None))
        if "error" in r: return emit(a,"chat",error=r["error"])
        if getattr(a,"json",False):
            return emit(a,"chat",{"reply":r["reply"],"exit":r["exit"],"sid":r["sid"]})
        return emit(a,"chat",{"_text":f'[exit={r["exit"]}]'})
    if a.sub=="log":
        rows = load_chat_log(sdir,a.name)[-(a.limit or 20):]
        if getattr(a,"json",False): return emit(a,"chat",{"log":rows})
        txt = "\n".join(f'{r.get("role","")}: {(r.get("text","") or "")[:500]}' for r in rows) or "(none)"
        return emit(a,"chat",{"_text":txt})

def orch_snapshot(sdir):
    ensure_state(sdir)
    sess = []
    for d in sorted(_sroot(sdir).iterdir()):
        if not d.is_dir(): continue
        st = _sstatus(d)
        if not st: continue
        try: raw = (d/"output.log").read_bytes()
        except Exception: raw = b""
        tail = ANSI.sub("",raw[-400:].decode(errors="replace")).splitlines()
        last = next((l.strip()[:100] for l in reversed(tail) if l.strip()),"")
        try: idle = int(time.time()-(d/"output.log").stat().st_mtime)
        except Exception: idle = -1
        sess.append({"id":st["id"],"name":st.get("name",""),"cmd":st.get("cmd"),
            "running":st.get("running"),"exit":st.get("exit"),"log_bytes":len(raw),
            "idle_s":idle,"last":last})
    try: events = [json.loads(l) for l in (sdir/"events.jsonl").read_text().splitlines() if l.strip()][-8:]
    except Exception: events = []
    todos = [t for t in load_todos(sdir) if not t.get("done")]
    try: approvals = [r for r in json.loads((sdir/"approvals.json").read_text()) if r.get("status")=="pending"]
    except Exception: approvals = []
    chats = []
    for ag in load_agents(sdir):
        log = load_chat_log(sdir,ag["name"])
        lastm = next((r for r in reversed(log) if r.get("role")=="agent"),{})
        chats.append({"name":ag["name"],"backend":ag.get("backend","?"),
            "model":ag.get("model","default"),"role":ag.get("role","sub"),
            "running":is_running(ag["name"]),
            "turns":len([r for r in log if r.get("role")=="user"]),
            "last":(lastm.get("text","") or "")[:100]})
    return {"sessions":sess,"events":events,"todos":todos,"approvals":approvals,"chats":chats}

def render_snapshot(s, width=100):
    L = ["== agents =="]
    for c in s["chats"]:
        flag = "*" if c["running"] else " "
        L.append(f'{flag} {c["name"][:12]:12} {c["backend"][:8]:8} {c["model"][:14]:14} {c["role"][:11]:11} {c["last"]}'[:width])
    L.append("== live sessions ==")
    L += [f'{"run" if x["running"] else "dead":4} {(x["name"] or x["id"])[:14]:14} {(x["cmd"] or "")[:30]:30} idle={x["idle_s"]}s {x["last"]}'[:width] for x in s["sessions"]] or ["(none)"]
    L.append("== activity ==")
    L += [f'{e.get("ts","")[11:19]} {e.get("type","")[:6]:6} {e.get("session") or ""} {e.get("cmd",e.get("tool",e.get("exit","")))}'[:width] for e in s["events"]] or ["(none)"]
    L.append("== todos ==")
    L += [f'[ ] #{t["id"]} {t["text"]}'[:width] for t in s["todos"]] or ["(none)"]
    L.append("== approvals ==")
    L += [f'! {r["id"]} {r.get("reason","")}: {(r.get("cmd","") or "")[:60]}'[:width] for r in s["approvals"]] or ["(none)"]
    return "\n".join(L)

def do_status(a):
    sdir = state_dir(a.dir)
    snap = orch_snapshot(sdir)
    if getattr(a,"json",False): return emit(a,"status",snap)
    w = shutil.get_terminal_size((100,30)).columns
    return emit(a,"status",{"_text":render_snapshot(snap,w)})

def do_tui(a):
    try: import curses
    except Exception: return emit(a,"tui",error="curses unavailable (POSIX terminal needed)")
    sdir = state_dir(a.dir); ensure_state(sdir)
    curses.wrapper(_tui_main, sdir)
    return 0

def _tui_main(stdscr, sdir):
    import curses
    try: curses.curs_set(0)
    except Exception: pass
    if curses.has_colors():
        curses.start_color()
        try: curses.use_default_colors()
        except Exception: pass
        for i,c in enumerate([curses.COLOR_CYAN,curses.COLOR_GREEN,curses.COLOR_YELLOW,curses.COLOR_RED],1):
            try: curses.init_pair(i,c,-1)
            except Exception: pass
    chats = load_agents(sdir)
    if not chats:
        chats = [{"name":"claude","backend":"claude","model":"default","dir":".","role":"orchestrator"}]
        save_agents(sdir,chats)
    active = 0
    logs = {c["name"]:load_chat_log(sdir,c["name"])[-60:] for c in chats}
    stream = {c["name"]:"" for c in chats}
    activity = []
    for e in orch_snapshot(sdir)["events"][-6:]:
        activity.append((e.get("session") or "",e.get("type",""),
            str(e.get("cmd",e.get("tool",e.get("exit",""))))[:60]))
    inp, mode, msg = "", "input", "tab switch · m models · d delegate · n new · a approve · ? keys · q quit"
    scroll = 0
    pick_idx = 0
    lock = threading.Lock()
    def onevent(n,k,t):
        with lock:
            if k=="text": stream[n] = (stream[n]+t)[-3000:]
            elif k in ("tool","toolout","done","exit"):
                activity.append((n,k,(t or "")[:70])); del activity[:-30]
            if k=="exit":
                logs[n] = load_chat_log(sdir,n)[-60:]; stream[n] = ""
    def send_active(text):
        if not chats: return
        th = threading.Thread(target=run_turn,args=(sdir,chats[active]["name"],text,onevent),daemon=True)
        th.start()
    def put(y,x,s,attr=0,w=0):
        try: stdscr.addstr(y,x,s[:max(0,(w or len(s)))],attr)
        except Exception: pass
    stdscr.timeout(120)
    while True:
        h,w = stdscr.getmaxyx()
        if mode=="help":
            stdscr.erase()
            for i,ln in enumerate(KEYS_HELP.splitlines()[:h-1]): put(i,0,ln[:w-1])
            stdscr.refresh()
            try: c2 = stdscr.getch()
            except Exception: c2 = -1
            if c2!=-1: mode = "input"
            continue
        if mode=="modelpick" and chats:
            opts = _model_opts(chats[active]["backend"])
            bw, bh = min(44,w-4), len(opts)+4
            bx, by = (w-bw)//2, (h-bh)//2
            for _y in range(by,by+bh): put(_y,bx," "*bw,curses.A_REVERSE)
            put(by,bx+2,f'model: {chats[active]["name"]}',curses.A_REVERSE|curses.A_BOLD)
            for i,o in enumerate(opts):
                mark = ">" if i==pick_idx else " "
                cur = "*" if o==chats[active].get("model") else " "
                put(by+2+i,bx+2,f'{mark}{cur} {o}'[:bw-4],curses.A_REVERSE|(curses.A_BOLD if i==pick_idx else 0))
            put(by+bh-1,bx+2,"up/down+enter, esc cancel"[:bw-4],curses.A_REVERSE)
            stdscr.refresh()
            try: c3 = stdscr.getch()
            except Exception: c3 = -1
            if c3==-1: continue
            if c3==27:
                stdscr.nodelay(True)
                try: c4 = stdscr.getch()
                except Exception: c4 = -1
                try: c5 = stdscr.getch() if c4!=-1 else -1
                except Exception: c5 = -1
                stdscr.nodelay(False); stdscr.timeout(120)
                if c4==-1: mode = "input"
                elif c4==91 and c5==65: pick_idx = (pick_idx-1)%len(opts)
                elif c4==91 and c5==66: pick_idx = (pick_idx+1)%len(opts)
            elif c3 in (curses.KEY_UP,ord("k")): pick_idx = (pick_idx-1)%len(opts)
            elif c3 in (curses.KEY_DOWN,ord("j"),9): pick_idx = (pick_idx+1)%len(opts)
            elif c3 in (10,13):
                if opts[pick_idx]=="[custom…]": mode = "setmodel"; inp = ""
                else:
                    chats[active]["model"] = opts[pick_idx]
                    save_agents(sdir,chats); msg = f'model -> {opts[pick_idx]}'; mode = "input"
            continue
        lw, rw = min(24,w//4), min(34,w//3)
        with lock:
            snap_logs = {k:list(v) for k,v in logs.items()}
            snap_stream = dict(stream); snap_act = list(activity)
        stdscr.erase()
        put(0,0,f' ag tui · {Path.cwd().name} · {now_iso()[11:19]} · {msg}'[:w-1],curses.color_pair(1)|curses.A_BOLD)
        for _y in range(1,h-2):
            put(_y,lw,"│"); put(_y,max(w-rw,lw+2),"│")
        # left: agents
        put(1,0," agents "[:lw],curses.A_BOLD)
        for i,c in enumerate(chats[:h-6]):
            flag = "*" if is_running(c["name"]) else " "
            sel = ">" if i==active else " "
            put(2+i,0,f'{sel}{flag}{c["name"][:12]:12} {c["model"][:lw-16]}'[:lw-1],
                curses.A_REVERSE if i==active else 0)
        # main: active chat
        mx = lw+1
        name = chats[active]["name"] if chats else ""
        put(1,mx,f' chat: {name} [{chats[active]["backend"] if chats else ""}]'[:w-mx-rw-2] if chats else "",curses.A_BOLD)
        rows = []
        for r in snap_logs.get(name,[])[-(h-5):]:
            role = r.get("role","")
            for ln in (r.get("text","") or "").splitlines() or [""]:
                rows.append((role,ln))
        if snap_stream.get(name): rows.append(("agent…",snap_stream[name][-200:]))
        scroll = min(scroll, max(0,len(rows)-(h-5)))
        vis = rows[:len(rows)-scroll if scroll else None]
        for i,(role,ln) in enumerate(vis[-(h-5):]):
            at = 0
            if role=="user": at = curses.color_pair(2)
            elif role in ("tool","toolout"): at = curses.color_pair(3)
            put(2+i,mx,f'{role[:6]:6} {ln}'[:w-mx-rw-2],at)
        # right: activity + approvals
        rx = w-rw
        put(1,rx," activity "[:rw],curses.A_BOLD)
        for i,(n,k,t) in enumerate(snap_act[-(h//2):]):
            tag = "└out" if k=="toolout" else k[:5]
            at = curses.color_pair(3) if k in ("tool","toolout") else 0
            put(2+i,rx,f'{n[:8]:8} {tag:5} {t}'[:rw-1],at)
        ay = 2+min(len(snap_act),h//2)+1
        if ay<h-3:
            put(ay,rx," approvals "[:rw],curses.A_BOLD)
            try: pend = [r for r in json.loads((sdir/"approvals.json").read_text()) if r.get("status")=="pending"][:h-ay-3]
            except Exception: pend = []
            for i,r in enumerate(pend):
                put(ay+1+i,rx,f'! {r["id"][:8]} {(r.get("cmd","") or "")[:rw-12]}'[:rw-1],curses.color_pair(4))
        put(h-2,0,f'> {inp}'[-(w-1):],0,w)
        put(h-1,0,f'[{mode}] {len(chats)} agents · enter send · esc normal'[:w-1])
        try: stdscr.move(h-2,min(2+len(inp),w-1))
        except Exception: pass
        stdscr.refresh()
        try: ch = stdscr.getch()
        except Exception: ch = -1
        if ch==-1: continue
        if mode in ("input","setmodel","newname","newbackend","dagent","dtext"):
            if ch in (10,13):
                if mode=="input":
                    if inp.strip(): send_active(inp.strip())
                elif mode=="setmodel" and chats:
                    chats[active]["model"] = inp.strip() or "default"
                    save_agents(sdir,chats); msg = f'model -> {chats[active]["model"]}'
                elif mode=="newname":
                    pending_name = inp.strip()
                    if pending_name: mode = "newbackend"; inp = "opencode"; continue
                    else: mode = "input"; continue
                elif mode=="newbackend":
                    b = inp.strip() or "opencode"
                    if b in MODELS:
                        chats.append({"name":pending_name,"backend":b,"model":"default","dir":".","role":"sub"})
                        save_agents(sdir,chats)
                        logs[pending_name] = []; stream[pending_name] = ""
                        active = len(chats)-1; msg = f"added {pending_name} ({b})"
                    else: msg = f"unknown backend (claude|opencode|gemini|codex|cursor)"
                    mode = "input"
                elif mode=="dagent":
                    pending_dagent = inp.strip()
                    if pending_dagent and any(c["name"]==pending_dagent for c in chats):
                        mode = "dtext"; inp = ""; continue
                    msg = "no such agent"; mode = "input"
                elif mode=="dtext":
                    if inp.strip():
                        tgt = pending_dagent
                        th = threading.Thread(target=delegate_task,args=(sdir,tgt,inp.strip(),onevent),daemon=True)
                        th.start(); msg = f"delegated to {tgt}"
                inp = ""; mode = "input" if mode!="input" else mode
                if mode in ("setmodel","newname"): mode = "input"
                continue
            if ch==27: inp = ""; mode = "normal"; continue
            if ch in (curses.KEY_BACKSPACE,127,8): inp = inp[:-1]; continue
            if 32<=ch<=126: inp += chr(ch)
            continue
        if ch in (10,13): mode = "input"
        elif ch in (ord("q"),27): break
        elif ch==ord("\t") and chats: active = (active+1)%len(chats); scroll = 0
        elif ord("1")<=ch<=ord("9") and chats:
            i = ch-ord("1")
            if i<len(chats): active = i; scroll = 0
        elif ch==ord("i"): mode = "input"
        elif ch==ord("m") and chats:
            mode = "modelpick"; pick_idx = _model_idx(chats[active])
        elif ch==ord("M"): mode = "setmodel"; inp = chats[active].get("model","") if chats else ""
        elif ch==ord("n"): mode = "newname"; inp = ""
        elif ch==ord("d"):
            subs = [c["name"] for c in chats if c.get("role")!="orchestrator"] or [c["name"] for c in chats]
            mode = "dagent"; inp = subs[0] if subs else ""
        elif ch==ord("?"): mode = "help"
        elif ch in (ord("["),curses.KEY_PPAGE): scroll += 5
        elif ch in (ord("]"),curses.KEY_NPAGE): scroll = max(0,scroll-5)
        elif ch==ord("a"):
            try: pend = [r for r in json.loads((sdir/"approvals.json").read_text()) if r.get("status")=="pending"]
            except Exception: pend = []
            msg = f'approved {pend[0]["id"]}' if pend and approve_id(sdir,pend[0]["id"]) else "no pending approvals"

KEYS_HELP = """ag keys
 sessions: spawn -- <cmd> | send <id> text | send --key ctrl-c|esc|up|enter | snap [--since OFF] [--clean] | sessions | wait | kill [--force]
 attach <id>: jump into live terminal (auth etc). Ctrl-] detaches, session keeps running. resize follows your terminal.
 forget <id>: wipe session logs (do after typing secrets)
 agents: agents list/add/rm/set/doctor | chat send <name> msg | chat log <name> | delegate <sub> task | status [--json] | tui
 tui: tab/1-9 target · enter/i input · esc normal · m model picker · M custom · n new agent · d delegate · a approve · ? this help · q quit
 approvals: blocked run -> approvals -> approve <id> (10min) or re-run --force
 memory: note/notes [--grep] · todo add/list/done/clear · history · events
 harness: show | export [file] | import <file> [--force] | link --to DIR"""

def _push_winsize(sp):
    try: cols, rows = shutil.get_terminal_size((100,30))
    except Exception: cols, rows = 100, 30
    try: (sp/"winsize.json").write_text(json.dumps({"cols":cols,"rows":rows}))
    except Exception: pass

def do_attach(a):
    import termios, tty, select, signal
    if os.name != "posix" or not sys.stdin.isatty():
        return emit(a,"attach",error="needs a POSIX tty",hint="run in a terminal")
    sdir = state_dir(a.dir); ensure_state(sdir)
    hit, err = resolve_sess(sdir, a.sess)
    if err: return emit(a,"attach",error=err,hint="ag sessions")
    sp, st = hit
    if not st.get("running"):
        return emit(a,"attach",error=f'session {st["id"]} exited',hint=f'ag snap {st["id"]}')
    try: fifo = os.open(sp/"stdin.fifo", os.O_WRONLY|os.O_NONBLOCK)
    except OSError as e: return emit(a,"attach",error=f"fifo: {e}")
    _push_winsize(sp)
    old = termios.tcgetattr(sys.stdin.fileno())
    try: lg = (sp/"output.log").stat().st_size
    except Exception: lg = 0
    print(f'attached {st["id"]} — Ctrl-] detaches, session keeps running',file=sys.stderr)
    signal.signal(signal.SIGWINCH, lambda sig,frm: _push_winsize(sp))
    try:
        tty.setraw(sys.stdin.fileno())
        while True:
            r,_,_ = select.select([sys.stdin.fileno()],[],[],0.1)
            if r:
                try: data = os.read(sys.stdin.fileno(),1024)
                except OSError: break
                if not data or b"\x1d" in data: break
                try: os.write(fifo, data)
                except OSError: break
            try: sz = (sp/"output.log").stat().st_size
            except Exception: sz = lg
            if sz < lg: lg = sz
            elif sz > lg:
                with open(sp/"output.log","rb") as f:
                    f.seek(lg); chunk = f.read(sz-lg)
                lg = sz
                os.write(sys.stdout.fileno(), chunk)
            if not _sstatus(sp).get("running"):
                try:
                    with open(sp/"output.log","rb") as f:
                        f.seek(lg); tail = f.read()
                    if tail: os.write(sys.stdout.fileno(), tail)
                except Exception: pass
                os.write(sys.stderr.fileno(), b"\r\n[session exited]\r\n")
                break
    finally:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        try: os.close(fifo)
        except Exception: pass
        print(f'detached {st["id"]}',file=sys.stderr)
    return 0

def do_forget(a):
    sdir = state_dir(a.dir); ensure_state(sdir)
    hit, err = resolve_sess(sdir, a.sess)
    if err: return emit(a,"forget",error=err,hint="ag sessions")
    sp, st = hit
    n = 0
    for f in ("output.log","input.log"):
        p = sp/f
        if p.exists(): n += p.stat().st_size; p.write_bytes(b"")
    _event(sdir,"forget",st["id"],bytes=n)
    return emit(a,"forget",{"_text":f'wiped {n}B of logs for {st["id"]}',"id":st["id"],"bytes":n})

def do_keys(a):
    if getattr(a,"json",False): return emit(a,"keys",{"keys":KEYS_HELP.splitlines()})
    return emit(a,"keys",{"_text":KEYS_HELP})

def delegate_task(sdir, agent_name, task, on_event=None):
    agents = {x["name"]:x for x in load_agents(sdir)}
    if agent_name not in agents: return {"error":f"no such agent: {agent_name}"}
    sub = agents[agent_name]
    try:
        harness_link(Path.home(), Path.cwd(),
            Path(sub.get("dir",".") or ".").expanduser() or Path.cwd())
    except Exception: pass
    r = run_turn(sdir,agent_name,task,on_event=on_event)
    if "error" in r: return r
    orch = next((x["name"] for x in load_agents(sdir) if x.get("role")=="orchestrator"),None)
    if orch: append_chat(sdir,orch,"delegate",f'{agent_name}: {task} -> {r["reply"][:2000]}')
    _event(sdir,"delegate",agent_name,task=task[:120],exit=r["exit"])
    return r

def do_delegate(a):
    sdir = state_dir(a.dir); ensure_state(sdir)
    task = " ".join(a.text or []).strip()
    if not task: return emit(a,"delegate",error="empty task")
    live = not getattr(a,"json",False)
    r = delegate_task(sdir,a.agent,task,
        on_event=(lambda n,k,t: print(t) if live and k=="text" and t else None))
    if "error" in r: return emit(a,"delegate",error=r["error"])
    if getattr(a,"json",False):
        return emit(a,"delegate",{"reply":r["reply"],"exit":r["exit"],"agent":a.agent})
    return emit(a,"delegate",{"_text":f'delegated to {a.agent} (exit={r["exit"]})'})

