def setup_targets(st):
    """Planned writes [(path, text, old, new|changed|unchanged)] + notes, skill_err, block, tdir. Reads only."""
    scope, harn, proj, jobs = st["scope"], st["harnesses"], Path(st["proj"]), st["jobs"]
    gp, pp = routing_paths(proj)
    under = backends_effective(st["existing"].get("global") or {}) if scope == "project" else backends_effective()
    bks = {b: d for b, d in ((b, {k: v for k, v in st["backends"][b].items() if v != under[b][k]}) for b in BACKEND_TABS) if d}
    doc = {"version": 1, "preset": st["preset"], "jobs": jobs, **({"backends": bks} if bks else {})}
    eff = routing_effective(doc) if scope == "global" else routing_effective(st["existing"].get("global") or {}, doc)
    block = routing_block(eff)
    writes = [(gp if scope == "global" else pp, json.dumps(doc, indent=2) + "\n")]
    tdir, tpls, skill_err, notes = skill_templates_dir(), {}, "", []
    for n in SKILL_NAMES if harn else ():
        t = tdir/n/"SKILL.md"
        try: tpls[n] = t.read_text()
        except OSError: skill_err = f"skill template missing: {t}"; break
    if not skill_err:
        for h in harn:
            sd = harness_skills_dir(h, scope, proj)
            writes += [(sd/n/"SKILL.md", render_skill(tpls[n], routing_block(eff, st["backends"]), scope)) for n in SKILL_NAMES]
            notes += [f"left alone: old skill {sd/o} (remove by hand once ag-cli/ag-agents replace it)"
                for o in OLD_SKILLS if (sd/o).exists()]
    if setup_claude_md_on(st) and scope == "global":
        cp, ap = _ag_home()/".claude"/"CLAUDE.md", _ag_home()/"AGENTS.md"
        writes.append((cp, routing_md_insert(_read_or_empty(cp), block)))
        t2 = routing_md_insert(_read_or_empty(ap), block, append=False)  # markers only, never append
        if t2 is not None: writes.append((ap, t2))
    elif st["claude_md"] and scope == "project": notes.append("CLAUDE.md block is global-only; skipped for --scope project")
    plan = []
    for p, txt in writes:
        old, ex = _read_or_empty(p), p.exists()
        plan.append((p, txt, old, "unchanged" if ex and old == txt else "changed" if ex else "new"))
    return {"plan": plan, "notes": notes, "skill_err": skill_err, "block": block, "tdir": tdir}

