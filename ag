                        logs[name] = load_chat_view(sdir, name)
                except Exception:
                    pass
        threading.Thread(target=_run, daemon=True).start()
        return "started"
    def open_chooser(which, ret):
        """Project/agent chooser overlay. ret=(screen,mode) restored on Esc
        with drafts untouched; Enter lands back on a composer."""
        nonlocal mode, pick_idx, pk_return, proj_names, agent_names
        nonlocal last_pick_click
        pk_return = ret
