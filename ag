def native_handoff_argv(backend, *, sid="", workdir=".", model=""):
    """Interactive native TUI argv preserving the session. Pure.
    Never includes auto-approve/bypass flags (see BYPASS_FLAGS). OpenCode
    carries the effective model via -m (verified root flag); default/missing
    resolves to the ag-level default. Other backends keep their bare launch."""
    if backend == "claude":
        return (["claude"] + (["--resume", sid] if sid else []), workdir or ".")
    if backend == "opencode":
        m = eff_model("opencode", model)
        return ([_opencode_bin()] + (["-m", m] if m else []), workdir or ".")
    if backend == "gemini":
        return (["gemini"], workdir or ".")
    if backend == "codex":
        return (["codex"], workdir or ".")
    if backend == "cursor":
        return ([_cursor_bin()] + (["--resume", sid] if sid else []), workdir or ".")
    raise ValueError(f"no native interactive session for backend: {backend}")

