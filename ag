# mode -> backend flags. plan wins over mode where the backend has a native plan mode.
_CLAUDE_PM = {"ro": "dontAsk", "edits": "acceptEdits", "auto": "auto", "full": "bypassPermissions"}  # headless can't ask: ro = strictest non-prompting
_CODEX_SB = {"ro": "read-only", "edits": "workspace-write", "auto": "workspace-write", "full": "danger-full-access"}
_GEMINI_AM = {"ro": "plan", "edits": "auto_edit", "full": "yolo"}
_CURSOR_MODE = {"ro": ["--mode", "ask"], "edits": ["--force", "--sandbox", "enabled"], "auto": ["--force"], "full": ["--force", "--sandbox", "disabled"]}

def mode_warning(backend, mode, plan=False):
    """One advisory line when the chosen mode can't be enforced natively, else ''."""
    c = CAPS.get(backend) or {}
    if mode and mode not in (c.get("modes") or []):
        return f"[mode] {backend} cannot enforce mode={mode}; running with backend default (advisory only)"
    if (mode or plan) and not c.get("native_enforce"):
        return f"[mode] {backend} does not enforce permission modes natively; mode={mode or 'plan'} is advisory"
    return ""

def mode_flags(backend, mode="", plan=False):
    """Pure: -> argv flags for (backend, mode, plan). '' / unsupported -> backend default flags."""
    ok = mode if mode in (CAPS.get(backend) or {}).get("modes", []) else ""
    if backend == "claude":
        pm = "plan" if plan else _CLAUDE_PM.get(ok)
        return ["--permission-mode", pm] if pm else []
    if backend == "codex":
        sb = _CODEX_SB["ro"] if plan else _CODEX_SB.get(ok)
        return ["-s", sb] if sb else []
    if backend == "gemini":
        return ["--approval-mode", "plan" if plan else _GEMINI_AM.get(ok, "default")]
    if backend == "cursor":
        return ["--mode", "plan"] if plan else list(_CURSOR_MODE.get(ok, []))
    return []

def opencode_permission(mode="", plan=False):
    """Pure: opencode `permission` config block for the mode ({} = leave backend default)."""
    m = "ro" if plan else mode
    return {"ro": {"edit": "deny", "bash": "deny"}, "edits": {"edit": "allow", "bash": "deny"},
            "auto": {"edit": "allow", "bash": "allow"}, "full": {"*": "allow"}}.get(m, {})

def mode_env(sdir, agent, env):
    """Overlay OPENCODE_CONFIG with a generated config carrying the `permission` block,
    merged onto the profile's config (env['OPENCODE_CONFIG']) if any. No-op otherwise."""
    perm = opencode_permission(agent.get("mode") or "", bool(agent.get("plan"))) if agent.get("backend") == "opencode" else {}
    if not perm: return env
    base = {}
    if env.get("OPENCODE_CONFIG"):
        try: base = json.loads(Path(env["OPENCODE_CONFIG"]).read_text())
        except Exception: base = {}
    cur = base.get("permission")
    base["permission"] = {**(cur if isinstance(cur, dict) else {}), **perm}
    base.setdefault("$schema", "https://opencode.ai/config.json")
    p = sdir/"modes"/re.sub(r"[^\w.-]", "_", agent.get("name") or "agent")/"opencode.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    _atomic_write(p, json.dumps(base, indent=2))
    return {**env, "OPENCODE_CONFIG": str(p)}

def caps_rows(backend=None):
    names = [backend] if backend else list(CAPS)
    return [{"backend": b, **CAPS[b], "advisory": [m for m in MODES if m not in CAPS[b]["modes"]]} for b in names]

def do_caps(a):
    be = getattr(a, "backend", None)
    if be and be not in CAPS: return emit(a, "agents", error=f"unknown backend: {be}", hint="/".join(CAPS))
    rows = caps_rows(be)
    if getattr(a, "json", False): return emit(a, "agents", {"caps": rows})
    f = lambda v: ",".join(v) if isinstance(v, list) else ("y" if v is True else "-" if v in (False, "") else str(v))
    txt = "\n".join(f'{r["backend"]:9} resume={f(r["resume"])} sys={f(r["system_flag"])} mcp={f(r["mcp_flag"])} skills={f(r["skills"])} intr={f(r["interrupt"])} usage={f(r["usage"])} plan={f(r["plan"])} modes={f(r["modes"]) or "-"} enforce={"native" if r["native_enforce"] else "advisory"}' for r in rows)
    return emit(a, "agents", {"_text": txt})

def backend_argv(backend, *, model="", workdir=".", sid="", prompt="", system="", command="", mode="", plan=False):
    m = eff_model(backend, model)
    mf = mode_flags(backend, mode or "", plan)
    if backend=="claude":
        argv = ["claude","-p","--verbose","--output-format","stream-json",
                "--include-partial-messages"]
        if m: argv += ["--model",m]
        if system: argv += ["--append-system-prompt",system]
        if sid: argv += ["--resume",sid]
        return argv + mf + [prompt]
    if backend=="opencode":
        argv = [_opencode_bin(),"run","--format","json","--thinking"]
        if command: argv += ["--command",command]
        if m: argv += ["-m",m]
        argv += ["--dir",workdir]
        if sid: argv += ["--session",sid]
        return argv + ([prompt] if prompt or not command else [])
    if backend=="gemini":
        argv = ["gemini","-p",prompt,"-o","stream-json"] + mf
        if m: argv += ["-m",m]
        return argv
    if backend=="codex":
        argv = ["codex","exec","--json"] + mf
        if m: argv += ["-m",m]
        if sid: argv += ["resume",sid]
        return argv + [prompt]
    if backend=="cursor":
        argv = [_cursor_bin(),"-p","--output-format","stream-json",
                "--stream-partial-output"]
        if m: argv += ["--model",m]
        if sid: argv += ["--resume",sid]
        return argv + mf + [prompt]
    if backend=="echo":
        return ["printf","%s\n",prompt]
    raise ValueError(f"unknown backend: {backend}")

def _cursor_bin():
    return shutil.which("agent") or str(Path.home()/".local/bin/agent")

def _opencode_bin():
    exe = shutil.which("opencode")
    if exe:
        # Absolute: the backend Popen runs under the agent workdir, so a
        # relative PATH entry must not leak through as a relative argv[0].
        return os.path.abspath(exe)
    for fallback in [
        Path.home() / ".opencode" / "bin" / "opencode",
        Path.home() / ".local" / "bin" / "opencode",
        Path.home() / ".bun" / "bin" / "opencode",
        Path("/opt/homebrew/bin/opencode"),
        Path("/usr/local/bin/opencode"),
    ]:
        if fallback.is_file() and os.access(str(fallback), os.X_OK):
            return str(fallback)
    return "opencode"

def _parse_claude(line):
    try: o = json.loads(line)
    except Exception: return [("text",line[:500])] if line.strip() else []
    t = o.get("type")
    if t=="system" and o.get("subtype")=="init":
        return [("meta",o["session_id"])] if o.get("session_id") else []
    if t=="assistant":
        out = []
        try: blocks = o["message"]["content"]
        except Exception: blocks = []
        for b in blocks or []:
            if b.get("type")=="text" and b.get("text"): out.append(("text",b["text"]))
            elif b.get("type")=="tool_use":
                out.append(("tool",f'{b.get("name","tool")} {json.dumps(b.get("input",{}))[:160]}'))
        return out
    if t=="user":
        out = []
        try: blocks = o["message"]["content"]
        except Exception: blocks = []
        for b in blocks or []:
            if b.get("type")=="tool_result":
                c = b.get("content")
                if isinstance(c,list):
                    txt = " ".join(x.get("text","") for x in c if isinstance(x,dict) and x.get("type")=="text")
                else: txt = str(c or "")
                txt = txt.strip()
                out.append(("toolout",tl_bound(txt,600)[0] if txt else ("(error)" if b.get("is_error") else "(ok)")))
        return out
    if t=="result":
        return [("done",f'{o.get("subtype","")} cost=${o.get("total_cost_usd",0):.3f}')]
    return []

def _parse_opencode(line):
    try: o = json.loads(line)
    except Exception: return [("text",line[:500])] if line.strip() else []
    evs = []
    if o.get("sessionID"): evs.append(("meta",o["sessionID"]))
    t, p = o.get("type"), o.get("part",{}) or {}
    if t=="text" and p.get("text"): evs.append(("text",p["text"]))
    elif t=="tool_use":
        st = p.get("state",{}) or {}
        title = st.get("title") or json.dumps(st.get("input",{}))[:160]
        evs.append(("tool",f'{p.get("tool","tool")} {title}'))
        if st.get("output"): evs.append(("toolout",tl_bound(str(st["output"]),600)[0]))
    elif t=="step_finish" and p.get("reason")=="stop": evs.append(("done","stop"))
    return evs

def _parse_codex(line):
    """`codex exec --json` JSONL (verified codex-cli 0.160): thread.started
    {thread_id}, item.completed {agent_message|command_execution}, turn.completed {usage}."""
    try: o = json.loads(line)
    except Exception: return [("text",line[:500])] if line.strip() else []
    t, it = o.get("type"), o.get("item") if isinstance(o.get("item"),dict) else {}
    if t=="thread.started" and o.get("thread_id"): return [("meta",o["thread_id"])]
    if t=="item.completed":
        if it.get("type")=="agent_message" and it.get("text"): return [("text",it["text"])]
        if it.get("type")=="command_execution":
            out = (it.get("aggregated_output") or "").strip()
            return [("tool",f'shell {it.get("command","")[:160]}'),
                    ("toolout",tl_bound(out,600)[0] if out else f'(exit {it.get("exit_code")})')]
    if t=="turn.completed":
        u = o.get("usage") or {}
        return [("done",f'in={u.get("input_tokens",0)} cached={u.get("cached_input_tokens",0)} out={u.get("output_tokens",0)}')]
    if t in ("turn.failed","error"):
        e = o.get("error"); return [("text",f'error: {(e.get("message") if isinstance(e,dict) else e) or "codex error"}'[:500])]
    return []

def _parse_generic(line):
    try: o = json.loads(line)
    except Exception: return [("text",line[:500])] if line.strip() else []
    texts, tools = [], []
    def walk(x):
        if isinstance(x,dict):
            for k,v in x.items():
                kl = str(k).lower()
                if isinstance(v,str) and kl in ("text","content","output","message","response") and v.strip():
                    texts.append(v[:2000])
                elif isinstance(v,str) and kl in ("tool","tool_name","function","command") and v.strip():
                    tools.append(v[:200])
                elif isinstance(v,(dict,list)): walk(v)
        elif isinstance(x,list):
            for v in x: walk(v)
    walk(o)
    out = [("tool",t) for t in tools[:5]]
    if texts: out.append(("text","\n".join(texts)[:4000]))
    for mt in re.finditer(r"(?i)(?:session_?id|conversation_?id)[\s\":=,/]+([A-Za-z0-9_\-]{6,})|\b(ses_[A-Za-z0-9]{6,})\b", line):
        sid = mt.group(1) or mt.group(2)
        if sid: out.insert(0,("meta",sid)); break
    return out or [("text",line[:300])]

def parse_events(backend, line):
    """-> [(kind, text)]; kinds: text|tool|done|meta. Pure, no I/O."""
    line = line.strip()
    if not line: return []
    if (_ao := _acp_obj(line)) is not None: return parse_events_acp(_ao)
    if backend=="claude": return _parse_claude(line)
    if backend=="opencode": return _parse_opencode(line)
    if backend=="codex": return _parse_codex(line)
    return _parse_generic(line)

# ---- provider usage: real token counts per turn (pure extractor + store) ----
# Verified shapes: claude assistant.message.usage (per API call = real context)
# + result.usage/total_cost_usd (turn aggregate over all calls); codex
# turn.completed.usage; opencode step_finish.part.tokens/cost (per step).
# cursor/gemini: no verifiable usage output (unauthenticated) -> not parsed.
# Normalized: in = whole prompt incl. cache; ctx = prompt size of the LAST call.
USAGE_KEYS = ("in", "out", "cache_read", "cache_write", "reasoning", "cost")

def _uint(v):
    return int(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and v >= 0 else 0

def parse_usage(backend, line):
    """-> None | {"ctx"?, "in"?, ..., "final": bool}. Pure, no I/O.
    final=True replaces per-turn totals; else additive (per step)."""
    try: o = json.loads(line)
    except Exception: return None
    if not isinstance(o, dict): return None
    if "ag_acp" in o: return parse_usage_acp(o)
    t = o.get("type")
    if backend == "claude":
        if t == "assistant" and not o.get("parent_tool_use_id"):
            u = (o.get("message") or {}).get("usage") if isinstance(o.get("message"), dict) else None
            if isinstance(u, dict):
                return {"ctx": _uint(u.get("input_tokens")) + _uint(u.get("cache_read_input_tokens"))
                    + _uint(u.get("cache_creation_input_tokens")), "final": False}
        if t == "result" and isinstance(o.get("usage"), dict):
            u = o["usage"]; cr = _uint(u.get("cache_read_input_tokens")); cw = _uint(u.get("cache_creation_input_tokens"))
            d = {"in": _uint(u.get("input_tokens")) + cr + cw, "out": _uint(u.get("output_tokens")),
                "cache_read": cr, "cache_write": cw,
                "reasoning": _uint((u.get("output_tokens_details") or {}).get("thinking_tokens")), "final": True}
            if isinstance(o.get("total_cost_usd"), (int, float)): d["cost"] = float(o["total_cost_usd"])
            return d
    elif backend == "codex" and t == "turn.completed" and isinstance(o.get("usage"), dict):
        u = o["usage"]; i = _uint(u.get("input_tokens"))
        return {"ctx": i, "in": i, "out": _uint(u.get("output_tokens")),
            "cache_read": _uint(u.get("cached_input_tokens")), "cache_write": _uint(u.get("cache_write_input_tokens")),
            "reasoning": _uint(u.get("reasoning_output_tokens")), "final": True}
    elif backend == "opencode" and t == "step_finish":
        p = o.get("part") if isinstance(o.get("part"), dict) else {}
        tk = p.get("tokens")
        if isinstance(tk, dict):
            c = tk.get("cache") if isinstance(tk.get("cache"), dict) else {}
            cr, cw = _uint(c.get("read")), _uint(c.get("write"))
            i = _uint(tk.get("input")) + cr + cw
            d = {"ctx": i, "in": i, "out": _uint(tk.get("output")), "cache_read": cr,
                "cache_write": cw, "reasoning": _uint(tk.get("reasoning")), "final": False}
            if isinstance(p.get("cost"), (int, float)): d["cost"] = float(p["cost"])
            return d
    return None

def usage_merge(acc, ev):
    """Fold one parse_usage event into the per-turn accumulator (ctx: last wins)."""
    if "ctx" in ev: acc["ctx"] = ev["ctx"]
    for k in USAGE_KEYS:
        if k in ev: acc[k] = ev[k] if ev.get("final") else acc.get(k, 0) + ev[k]
    return acc

def usage_record(sdir, name, backend, sid, fresh, acc):
    """Persist last-turn usage + running totals (+ session baseline) in chat meta."""
    if not acc: return None
    m = load_chat_meta(sdir, name)
    u = m.get("usage") if isinstance(m.get("usage"), dict) else {}
    tot = u.get("totals") if isinstance(u.get("totals"), dict) else {}
    for k in USAGE_KEYS:
        if k in acc: tot[k] = round(tot.get(k, 0) + acc[k], 6) if k == "cost" else tot.get(k, 0) + acc[k]
    tot["turns"] = tot.get("turns", 0) + 1
    last = dict(acc, backend=backend, sid=sid, ts=now_iso())
    base = u.get("base") if isinstance(u.get("base"), dict) else {}
    # baseline = prompt size of the first turn of a fresh session (system prompt,
    # tool defs, replayed history): growth above it is what compaction controls.
    if "ctx" in acc and (fresh or base.get("backend") != backend):
        base = {"backend": backend, "ctx": acc["ctx"]}
    m["usage"] = {"last": last, "totals": tot, "base": base}
    save_chat_meta(sdir, name, m)
    return m["usage"]

def usage_occupancy(sdir, agent):
    """Real context growth of the live native session, or None (-> chars//4).
    None unless the last measured turn is this backend's still-live session."""
    try:
        name, backend = agent.get("name", ""), agent.get("backend", "claude")
        m = load_chat_meta(sdir, name, agent=agent)
        u = m.get("usage") if isinstance(m.get("usage"), dict) else {}
        last, base = u.get("last") or {}, u.get("base") or {}
        sid = (m.get("sids") or {}).get(backend) or (m.get("sid") if m.get("backend") == backend else "")
        if not sid or last.get("backend") != backend or base.get("backend") != backend: return None
        if "ctx" not in last or "ctx" not in base: return None
        return {"ctx": last["ctx"], "base": base["ctx"], "tokens": max(0, last["ctx"] - base["ctx"])}
    except Exception:
        return None

def usage_short(acc):
    return {k: acc[k] for k in ("ctx", "in", "out", "cache_read", "reasoning", "cost") if k in acc}

# ---- streaming timeline: honest incremental provider events ----
# ponytail: one TimelineBuffer per turn; deltas concatenate in memory,
# snapshots persist-before-emit. Ceilings: no token-level invention for
# providers that only emit finished blocks; unknown JSON is dropped.
TL_ROW_CAP = 8000    # persisted text cap per row (matches append_chat)
TL_SEG_CAP = 20000   # in-memory segment cap, then truthful omission label
TL_EMIT_EVERY = 2000 # delta snapshot persist/emit cadence (chars)
TL_EMIT_FLUSH_S = 0.08  # time cadence for short deltas (s); first delta immediate
TL_TOOLOUT_CAP = 600 # tool result body cap (with omission note, not silent)
TL_DELTA_OPS = ("assistant_delta", "reasoning_delta", "tool_args_delta")
TL_FLUSH_OPS = ("flush",)
# No parser-global counters: per-turn message scope lives on TimelineBuffer
# (tl_scope) and is threaded through parse_timeline(..., scope=...).
TL_ROLES = ("assistant", "reasoning", "tool", "toolout", "diff", "error")
_TL_SEQ = 0
_TL_LOCK = threading.Lock()

def tl_new_id():
    """Stable unique timeline event_id (generated once, persisted, upserted)."""
    global _TL_SEQ
    with _TL_LOCK:
        _TL_SEQ += 1
        n = _TL_SEQ
    return "tl-%x-%x-%d" % (int(time.time() * 1000) & 0xffffff, os.getpid() & 0xffff, n)

def _tl_json(line):
    try:
        o = json.loads(line)
        return o if isinstance(o, dict) else None
    except Exception:
        return None

def _tl_tool_text(tool_name, args_preview):
    return f'{tool_name or "tool"} {args_preview or ""}'.strip()[:800]

def tl_bound(text, cap):
    """Central truthful bound: (bounded_text, omitted_chars). Never silent."""
    t = text or ""
    if len(t) <= cap:
        return t, 0
    return (t[:cap] + f"\n…[truncated: +{len(t) - cap} chars omitted]"), len(t) - cap

def _tl_opencode_part(o):
    p = o.get("part")
    return p if isinstance(p, dict) else {}

def parse_timeline_opencode(line):
    """Opencode `run --format json` events (see run.ts: text/reasoning fire
    only on part.time.end; tool_use only at completed/error; no idle marker).
    Returns [op]; unknown shapes -> [] (never prose). Pure, no I/O."""
    o = _tl_json(line)
    if o is None: return []
    ops = []
    t, p = o.get("type"), _tl_opencode_part(o)
    if t == "text" and isinstance(p.get("text"), str) and p["text"].strip():
        ops.append({"op": "assistant_text", "text": p["text"]})
    elif t == "reasoning" and isinstance(p.get("text"), str) and p["text"].strip():
        ops.append({"op": "reasoning_text", "text": p["text"]})
    elif t == "tool_use":
        st = p.get("state")
        st = st if isinstance(st, dict) else {}
        status = st.get("status")
        inp = st.get("input")
        title = st.get("title") or (json.dumps(inp)[:160] if inp is not None else "")
        ops.append({"op": "tool", "tool_id": str(p.get("id") or ""),
            "tool_name": str(p.get("tool") or "tool"),
            "args": inp, "title": str(title or "")[:200],
            "status": "completed" if status == "completed" else
                      "failed" if status == "error" else "",
            "meta": st.get("metadata") if isinstance(st.get("metadata"), dict) else None})
        out = st.get("output")
        if out not in (None, ""):
            txt, _ = tl_bound(str(out), TL_TOOLOUT_CAP)
            ops.append({"op": "toolout", "tool_id": str(p.get("id") or ""),
                "text": txt,
                "is_error": status == "error"})
        elif status == "error" and isinstance(st.get("error"), str) and st["error"].strip():
            # failed with no output: state.error is the useful body.
            txt, _ = tl_bound(st["error"].strip(), TL_TOOLOUT_CAP)
            ops.append({"op": "toolout", "tool_id": str(p.get("id") or ""),
                "text": txt, "is_error": True})
            ops.append({"op": "error", "text": txt[:500]})
    elif t == "error":
        err = o.get("error")
        ops.append({"op": "error", "text": str(err)[:500] if err else "provider error"})
    return ops

def _tl_claude_blocks(blocks, key=None):
    ops = []
    for i, b in enumerate(blocks or []):
        if not isinstance(b, dict): continue
        bt = b.get("type")
        if bt == "text" and b.get("text"):
            op = {"op": "assistant_text", "text": b["text"]}
            if key is not None: op["seg"] = f"a:{key}:{i}"
            ops.append(op)
        elif bt == "thinking" and b.get("thinking"):
            op = {"op": "reasoning_text", "text": b["thinking"]}
            if key is not None: op["seg"] = f"r:{key}:{i}"
            ops.append(op)
        elif bt == "tool_use":
            ops.append({"op": "tool", "tool_id": str(b.get("id") or ""),
                "tool_name": str(b.get("name") or "tool"),
                "args": b.get("input"), "title": json.dumps(b.get("input", {}))[:160],
                "status": ""})
    return ops

def _tl_scope_key(scope):
    """Segment scope key: provider message id when known, else the
    caller-owned per-turn counter. Caller threads its own scope dict."""
    mid = (scope or {}).get("id")
    if mid: return str(mid)
    return "n%d" % int((scope or {}).get("n", 0))

def parse_timeline_claude(line, scope=None):
    """Claude stream-json incl. --include-partial-messages deltas. Only the
    documented delta shapes below are extracted; anything else -> [].
    Block indices repeat across messages, so segment keys are scoped by
    provider message id (`message.id`, present on message_start and full
    blocks) or — when absent — a caller-owned per-turn counter.
    `scope` is an optional mutable dict {"n":int,"id":str|None} owned by
    the caller (TimelineBuffer threads one per turn); omitted -> a fresh
    ephemeral scope, so the legacy line-pure call shape stays stateless
    and concurrent turns never share state. No globals, no I/O."""
    if scope is None: scope = {"n": 0, "id": None}
    o = _tl_json(line)
    if o is None: return []
    t = o.get("type")
    if t == "assistant":
        try: msg = o["message"]
        except Exception: msg = {}
        msg = msg if isinstance(msg, dict) else {}
        try: blocks = msg.get("content")
        except Exception: blocks = []
        key = _tl_scope_key(scope)  # key BEFORE bump: matches this msg's deltas
        if isinstance(msg.get("id"), str) and msg["id"]:
            scope["id"] = msg["id"]
        scope["n"] = int(scope.get("n", 0)) + 1
        return _tl_claude_blocks(blocks, key)
    if t == "user":
        try: msg = o["message"]
        except Exception: msg = {}
        msg = msg if isinstance(msg, dict) else {}
        if isinstance(msg.get("id"), str) and msg["id"]:
            scope["id"] = msg["id"]
        scope["n"] = int(scope.get("n", 0)) + 1
        ops = []
        try: blocks = msg.get("content")
        except Exception: blocks = []
        for b in blocks or []:
            if not isinstance(b, dict) or b.get("type") != "tool_result": continue
            c = b.get("content")
            if isinstance(c, list):
                txt = " ".join(x.get("text", "") for x in c
                    if isinstance(x, dict) and x.get("type") == "text")
            else:
                txt = str(c or "")
            txt = txt.strip()
            btxt, _ = tl_bound(txt if txt else
                ("(error)" if b.get("is_error") else "(ok)"), TL_TOOLOUT_CAP)
            ops.append({"op": "toolout",
                "tool_id": str(b.get("tool_use_id") or ""),
                "text": btxt,
                "is_error": bool(b.get("is_error"))})
        return ops
    if t == "stream_event":
        ev = o.get("event")
        if not isinstance(ev, dict): return []
        et = ev.get("type")
        if et == "message_start":
            m = ev.get("message")
            if isinstance(m, dict) and isinstance(m.get("id"), str) and m["id"]:
                scope["id"] = m["id"]
            else:
                scope["id"] = None  # never carry a stale id into a new message
            scope["n"] = int(scope.get("n", 0)) + 1
            return [{"op": "flush", "scope": "msg"}]
        if et == "message_stop":
            scope["n"] = int(scope.get("n", 0)) + 1
            return [{"op": "flush", "scope": "msg"}]
        sk = _tl_scope_key(scope)
        if et == "content_block_stop":
            return [{"op": "flush", "scope": "block",
                "seg": f'{sk}:{ev.get("index", 0)}'}]
        if et == "content_block_start":
            cb = ev.get("content_block")
            if isinstance(cb, dict) and cb.get("type") == "tool_use":
                return [{"op": "tool", "tool_id": str(cb.get("id") or ""),
                    "tool_name": str(cb.get("name") or "tool"),
                    "args": None, "title": "", "status": "",
                    "seg": f't:{sk}:{ev.get("index", 0)}'}]
            return []
        if et == "content_block_delta":
            d = ev.get("delta")
            if not isinstance(d, dict): return []
            idx = ev.get("index", 0)
            if d.get("type") == "text_delta" and isinstance(d.get("text"), str):
                return [{"op": "assistant_delta", "seg": f'a:{sk}:{idx}',
                    "delta": d["text"]}]
            if d.get("type") == "thinking_delta" and isinstance(d.get("thinking"), str):
                return [{"op": "reasoning_delta", "seg": f'r:{sk}:{idx}',
                    "delta": d["thinking"]}]
            if d.get("type") == "input_json_delta":
                pj = d.get("partial_json")
                if isinstance(pj, str) and pj:
                    return [{"op": "tool_args_delta",
                        "tool_seg": f't:{sk}:{idx}',
                        "delta": pj}]
            return []
        return []
    if t == "result" and o.get("is_error"):
        return [{"op": "error", "text": str(o.get("result") or "turn failed")[:500]}]
    return []

def parse_timeline_generic(line):
    """Honest fallback: mirror _parse_generic's text/tool walk (capped) plus
    ag's documented test-fixture delta shape
    {"type":"text_delta"|"reasoning_delta","seg":k,"delta":s} (fixture-only,
    not a provider claim). Unknown JSON without recognized keys -> []
    (never giant prose). Pure, no I/O."""
    s = line.strip()
    if not s: return []
    o = _tl_json(s)
    if o is not None and o.get("type") in ("text_delta", "reasoning_delta") \
            and isinstance(o.get("delta"), str) and isinstance(o.get("seg"), str):
        return [{"op": "assistant_delta" if o["type"] == "text_delta"
            else "reasoning_delta", "seg": f"fx:{o['seg']}", "delta": o["delta"]}]
    if o is None:
        return [{"op": "assistant_text", "text": s[:2000]}]
    texts, tools = [], []
    def walk(x):
        if isinstance(x, dict):
            for k, v in x.items():
                kl = str(k).lower()
                if isinstance(v, str) and kl in ("text", "content", "output", "message", "response") and v.strip():
                    texts.append(v[:2000])
                elif isinstance(v, str) and kl in ("tool", "tool_name", "function", "command") and v.strip():
                    tools.append(v[:200])
                elif isinstance(v, (dict, list)):
                    walk(v)
        elif isinstance(x, list):
            for v in x: walk(v)
    walk(o)
    ops = [{"op": "tool", "tool_id": "", "tool_name": t, "args": None,
        "title": "", "status": ""} for t in tools[:5]]
    if texts:
        ops.append({"op": "assistant_text", "text": "\n".join(texts)[:4000]})
    return ops

def parse_timeline(backend, line, scope=None):
    """-> [op dicts] for the timeline engine. Pure, no I/O. Legacy
    parse_events stays the owner of meta/done/chunks (see run_turn).
    `scope` (claude only) is caller-owned per-turn message state; omitted
    -> each call uses a fresh ephemeral scope (legacy line-pure shape)."""
    line = line.strip()
    if not line: return []
    if (_ao := _acp_obj(line)) is not None: return parse_timeline_acp(_ao)
    if backend == "claude": return parse_timeline_claude(line, scope)
    if backend == "opencode": return parse_timeline_opencode(line)
    if backend == "codex": return parse_timeline_codex(line)
    return parse_timeline_generic(line)

def parse_timeline_codex(line):
    """`codex exec --json` items (see _parse_codex). Only completed items are
    rendered; unknown shapes -> [] (never prose). Pure, no I/O."""
    o = _tl_json(line)
    if o is None: return []
    it = o.get("item") if isinstance(o.get("item"), dict) else {}
    t = o.get("type")
    if t == "item.completed" and it.get("type") == "agent_message" and isinstance(it.get("text"), str):
        return [{"op": "assistant_text", "text": it["text"]}]
    if t == "item.completed" and it.get("type") == "reasoning" and isinstance(it.get("text"), str):
        return [{"op": "reasoning_text", "text": it["text"]}]
    if t == "item.completed" and it.get("type") == "command_execution":
        tid, rc = str(it.get("id") or ""), it.get("exit_code")
        ops = [{"op": "tool", "tool_id": tid, "tool_name": "shell", "args": {"command": it.get("command")},
            "title": str(it.get("command") or "")[:200],
            "status": "completed" if rc == 0 else "failed", "meta": None}]
        out = it.get("aggregated_output")
        if out:
            ops.append({"op": "toolout", "tool_id": tid, "text": tl_bound(str(out), TL_TOOLOUT_CAP)[0], "is_error": rc != 0})
        return ops
    if t in ("turn.failed", "error"):
        e = o.get("error")
        return [{"op": "error", "text": str((e.get("message") if isinstance(e, dict) else e) or "codex error")[:500]}]
    return []

def tl_diff_for_tool(tool_name, args, meta=None):
    """Unified diff from KNOWN edit inputs only. Returns (diff_text, path)
    or None. Never scans the worktree. Pure, no I/O.

    Source precedence (real opencode schemas):
    1. provider-confirmed metadata: state.metadata.diff (edit.ts ctx.metadata
       + return) or state.metadata.files[{patch}] / apply_patch metadata.files
       — returned verbatim with an applied/confirmed marker via caller status.
    2. input fallback: edit tool oldString/newString/filePath (camelCase,
       per edit.ts Parameters) plus snake_case aliases; apply_patch patchText.
    3. explicit patch/diff string fields.
    Unknown tools/inputs -> None (no guessed worktree scan)."""
    meta = meta if isinstance(meta, dict) else {}
    for k in ("diff",):
        v = meta.get(k)
        if isinstance(v, str) and v.strip() and any(
                l.startswith(("+", "-", "@@", "diff", "***")) for l in v.splitlines()[:30]):
            path = ""
            fd = meta.get("filediff")
            if isinstance(fd, dict):
                path = str(fd.get("file") or "")[:200]
            if not path:
                fp = meta.get("filepath", meta.get("filePath", ""))
                path = str(fp or "")[:200]
            v = v[:4000]
            return ((v + "\n…[diff truncated]") if len(meta[k]) > 4000 else v,
                path, True)
    files = meta.get("files")
    if isinstance(files, list) and files:
        spans, paths = [], []
        for f in files:
            if not isinstance(f, dict): continue
            p = f.get("patch")
            if isinstance(p, str) and p.strip():
                spans.append(p[:4000])
                paths.append(str(f.get("relativePath") or f.get("filePath") or "")[:200])
        if spans:
            txt = "\n".join(spans)[:4000]
            return (txt, "; ".join(p for p in paths if p)[:200], True)
    else:
        fd = meta.get("filediff")
        if isinstance(fd, dict) and isinstance(fd.get("patch"), str) and fd["patch"].strip():
            return (fd["patch"][:4000], str(fd.get("file") or "")[:200], True)
    if not isinstance(args, dict): return None
    old = args.get("oldString", args.get("old_string"))
    new = args.get("newString", args.get("new_string"))
    path = args.get("filePath", args.get("file_path",
        args.get("path", args.get("file", "")))) or ""
    path = str(path)[:200]
    if isinstance(old, str) and isinstance(new, str):
        dl = list(difflib.unified_diff(old.splitlines(), new.splitlines(),
            fromfile=f"a/{path}" if path else "a/before",
            tofile=f"b/{path}" if path else "b/after", lineterm=""))
        joined = "\n".join(dl)
        txt = joined[:4000]
        return (txt + "\n…[diff truncated]") if len(joined) > 4000 else txt, path, False
    pt = args.get("patchText")
    if isinstance(pt, str) and pt.strip() and any(
            l.startswith(("+", "-", "@@", "***")) for l in pt.splitlines()[:30]):
        return (pt[:4000], path, False)
    for k in ("patch", "diff"):
        v = args.get(k)
        if isinstance(v, str) and v.strip() and any(
                l.startswith(("+", "-", "@@")) for l in v.splitlines()[:20]):
            v = v[:4000]
            return (v + "\n…[diff truncated]") if len(args[k]) > 4000 else v, path, False
    return None

def load_timeline(sdir, name):
    """Deduped timeline view: last-wins by event_id, first-seen order.
    Matches what a UI upserting callbacks converges to. Legacy rows without
    event_id are preserved (each keeps its log position, never dropped)."""
    try:
        log = [json.loads(l) for l in chat_log_path(sdir, name).read_text().splitlines() if l.strip()]
    except Exception:
        return []
    order, rows = [], {}
    for i, r in enumerate(log):
        eid = r.get("event_id") or f"legacy-{i}"
        if eid not in rows: order.append(eid)
        rows[eid] = r
    return [rows[e] for e in order]

def logical_chat_rows(sdir, name):
    """Deduped logical messages: last-wins by event_id (legacy rows kept),
    first-seen order. Snapshot rewrites never inflate turn accounting."""
    return load_timeline(sdir, name)

class TimelineBuffer:
    """Per-turn ordered timeline. Persist-before-emit; UPSERT by event_id.
    Display rows only — replay/compaction keep selecting user/agent/summary."""
    def __init__(self, sdir, name, on_event):
        self.sdir, self.name, self.on_event = sdir, name, on_event
        self.rows, self.order = {}, []
        self.segs = {}       # (kind, segkey) -> {event_id, text, emitted, omitted, closed, last_emit}
        self.tools = {}      # tool_id -> event_id
        self.toolsegs = {}   # tool_seg -> event_id (unlinked args rows)
        self.seg_tool = {}   # tool_seg -> tool_id (index linkage)
        self.seg_args = {}   # tool_seg -> accumulated partial args
        self.diffs = {}      # tool_id -> (old_span, new_span) for toolout dedup
        self.diff_eids = {}  # tool_id -> diff event_id (status transitions upsert)
        self.had_assistant = False
        self.persist_failed = False  # honest disk-failure flag (surfaced by caller)
        self.tl_scope = {"n": 0, "id": None}  # per-turn claude msg scope (no globals)

    def _store(self, row):
        try:
            with open(chat_log_path(self.sdir, self.name), "a") as f:
                f.write(json.dumps(row) + "\n")
            return True
        except Exception:
            self.persist_failed = True
            return False

    def _emit(self, row):
        stored = dict(row)
        txt = stored.get("text") or ""
        if len(txt) > TL_ROW_CAP:
            kept = TL_ROW_CAP - len(f"\n…[output capped at {TL_ROW_CAP} chars]")
            kept = max(kept, 0)
            stored["text"] = txt[:kept] + f"\n…[output capped at {TL_ROW_CAP} chars]"
        ok = self._store(stored)
        stored["persisted"] = bool(ok)
        self.rows[stored["event_id"]] = stored
        if stored["event_id"] not in self.order:
            self.order.append(stored["event_id"])
        if self.on_event:
            try: self.on_event(self.name, "timeline", dict(stored))
            except Exception: pass
        return stored

    def _mkrow(self, role, text, **kw):
        row = {"ts": now_iso(), "event_id": tl_new_id(), "role": role,
            "text": text or ""}
        for k in ("tool_name", "tool_id", "status", "path", "timeline_summary"):
            if kw.get(k) not in (None, ""):
                row[k] = kw[k]
        return row

    def user_row(self, text, event_id):
        # already persisted by run_turn's append_chat with the same event_id:
        # register + emit only, never store twice.
        row = {"ts": now_iso(), "event_id": event_id, "role": "user",
            "text": text or ""}
        self.rows[event_id] = row
        self.order.append(event_id)
        if self.on_event:
            try: self.on_event(self.name, "timeline", dict(row))
            except Exception: pass

    def _close_seg(self, kind, key):
        s = self.segs.pop((kind, key), None)
        if not s or s.get("closed"): return
        s["closed"] = True
        if not s.get("event_id"): return  # never persisted, nothing to close
        full, note = s["text"], ""
        if s.get("omitted"):
            note = f"\n…[truncated: +{s['omitted']} chars omitted]"
        if len(full) + len(note) > TL_ROW_CAP:
            cap_note = f"\n…[output capped at {TL_ROW_CAP} chars]"
            full = full[:TL_ROW_CAP - len(note) - len(cap_note)] + note + cap_note
        else:
            full += note
        row = self.rows.get(s["event_id"]) or {}
        if (row.get("text") or "") != full:
            self._emit(dict(row, text=full))

    def _seg_append(self, kind, seg, piece, sep="", force=False):
        """Append to a text segment (deltas raw, runs sep-joined). First
        nonempty append persists immediately (pre-exit visibility); later
        snapshots persist throttled (TL_EMIT_EVERY chars or TL_EMIT_FLUSH_S
        seconds) plus on close/flush. Bounded: TL_SEG_CAP + omission note."""
        role = "assistant" if kind == "a" else "reasoning"
        if not piece: return
        if kind == "a": self.had_assistant = True
        now = time.monotonic()
        s = self.segs.get((kind, seg))
        if s is None or s.get("closed"):
            s = {"event_id": None, "text": "", "emitted": 0,
                "omitted": 0, "closed": False, "last_emit": 0.0}
            self.segs[(kind, seg)] = s
        add = piece if not (sep and s["text"]) else sep + piece
        room = TL_SEG_CAP - len(s["text"])
        if room < 0: room = 0
        if len(add) > room:
            s["omitted"] += len(add) - room
            add = add[:room]
        s["text"] += add
        due_chars = len(s["text"]) - s["emitted"] >= TL_EMIT_EVERY
        due_time = (now - (s.get("last_emit") or 0.0)) >= TL_EMIT_FLUSH_S
        if force or s["event_id"] is None or due_chars or due_time:
            if s["event_id"] is None:
                stored = self._emit(self._mkrow(role, s["text"]))
                s["event_id"] = stored["event_id"]
            else:
                row = self.rows.get(s["event_id"]) or {}
                self._emit(dict(row, text=s["text"]))
            s["emitted"] = len(s["text"])
            s["last_emit"] = now

    def flush(self, scope="msg", seg=""):
        """Provider stop marker: persist pending short deltas now (before the
        next tool/segment), so sub-2000-char responses are visible pre-exit."""
        if scope == "block" and seg:
            want = seg.split(":")[-1]
            for (kd, k), s in list(self.segs.items()):
                if s.get("closed") or not s.get("text"): continue
                if k == seg or (isinstance(k, str) and k.endswith(f":{want}")):
                    row = self.rows.get(s["event_id"]) if s.get("event_id") else None
                    if row is not None and (row.get("text") or "") != s["text"]:
                        self._emit(dict(row, text=s["text"]))
                        s["emitted"] = len(s["text"])
                        s["last_emit"] = time.monotonic()
            return
        for (kd, k) in list(self.segs):
            s = self.segs.get((kd, k))
            if s is None or s.get("closed") or not s.get("text"): continue
            if s.get("event_id") is None:
                role = "assistant" if kd == "a" else "reasoning"
                stored = self._emit(self._mkrow(role, s["text"]))
                s["event_id"] = stored["event_id"]
                s["emitted"] = len(s["text"])
                s["last_emit"] = time.monotonic()
            else:
                row = self.rows.get(s["event_id"]) or {}
                if (row.get("text") or "") != s["text"]:
                    self._emit(dict(row, text=s["text"]))
                    s["emitted"] = len(s["text"])
                    s["last_emit"] = time.monotonic()

    def _break_run(self, kind=None):
        """Close open run segments so a tool/diff/error row lands after the
        run's final snapshot in the log (chronological order)."""
        for kd in ([kind] if kind else ["a", "r"]):
            s = self.segs.get((kd, "run"))
            if s is not None and not s.get("closed"):
                self._close_seg(kd, "run")

    def _delta(self, kind, seg, delta):
        self._break_run(kind)
        self._seg_append(kind, seg, delta or "")

    def _full_text(self, kind, text, seg=None):
        """Full provider block. When identity is available (Claude content
        ops carry message scope + block index), the exact pending segment
        is adopted — text updated in place on the stable row, then the
        pending segment is closed/removed. Identity always wins over
        content matching, so identical prefixes or repeated message text
        can never merge. An unmatched supplied identity seeds its own new
        row (never adopts unrelated pending by prefix). Without identity
        (other providers, legacy callers), a lone open delta extended by
        the text is adopted and closed; otherwise the text joins the run
        segment."""
        if not (text or "").strip(): return
        if kind == "a": self.had_assistant = True
        role = "assistant" if kind == "a" else "reasoning"
        if seg:
            s = self.segs.get((kind, seg))
            if s is not None and not s.get("closed"):
                s["text"] = text
                row = self.rows.get(s["event_id"]) or {}
                if (row.get("text") or "") != text:
                    self._emit(dict(row, text=text))
                s["emitted"] = len(text)
                s["last_emit"] = time.monotonic()
                self.segs.pop((kind, seg), None)  # pending done; row is stable
                return
            # Supplied identity with no pending match: authoritative new row.
            # Never fall into prefix adoption of a different open segment.
            self.segs.pop((kind, seg), None)
            self._emit(self._mkrow(role, text))
            return
        cands = [k for (kd, k), s in list(self.segs.items())
            if kd == kind and k != "run" and not s.get("closed")
            and s["text"] and text.startswith(s["text"])]
        if len(cands) == 1:
            s = self.segs.get((kind, cands[0]))
            if s is not None and not s.get("closed"):
                s["text"] = text
                row = self.rows.get(s["event_id"]) or {}
                if (row.get("text") or "") != text:
                    self._emit(dict(row, text=text))
                s["emitted"] = len(text)
                s["last_emit"] = time.monotonic()
                self.segs.pop((kind, cands[0]), None)  # reconcile once, then close
                return
        self._seg_append(kind, "run", text, sep="\n")

    def assistant_text(self, text, seg=None): self._full_text("a", text or "", seg)
    def reasoning_text(self, text, seg=None): self._full_text("r", text or "", seg)
    def assistant_delta(self, seg, delta): self._delta("a", seg, delta or "")
    def reasoning_delta(self, seg, delta): self._delta("r", seg, delta or "")

    def tool(self, tool_id, tool_name, args, title, status, seg="", meta=None):
        self._break_run()
        self.flush(scope="msg")
        preview = title or (json.dumps(args)[:160] if args is not None else "")
        txt = _tl_tool_text(tool_name, preview)
        if seg and tool_id:
            self.seg_tool[seg] = tool_id
        if tool_id:
            # full invocation supersedes partial args previews for this tool.
            for _s, _t in list(self.seg_tool.items()):
                if _t == tool_id:
                    self.seg_args.pop(_s, None)
        eid = self.tools.get(tool_id) if tool_id else None
        if eid is None and seg and seg in self.toolsegs:
            eid = self.toolsegs.pop(seg)
        if eid is None and tool_id and self.toolsegs:
            # link via the index linkage: the pending args row whose seg maps
            # to this tool_id (parallel tools each keep their own row).
            for _s in list(self.toolsegs):
                if self.seg_tool.get(_s) == tool_id:
                    eid = self.toolsegs.pop(_s)
                    break
            else:
                if not seg and len(self.toolsegs) == 1:
                    _s, eid = self.toolsegs.popitem()
        if eid and eid in self.rows:
            row = dict(self.rows[eid])
            row["text"] = txt
            if status: row["status"] = status
            else: row.pop("status", None)
            if tool_name: row["tool_name"] = tool_name
            if tool_id:
                row["tool_id"] = tool_id
                self.tools[tool_id] = eid
            self._emit(row)
        else:
            kw = {"tool_name": tool_name or "tool"}
            if tool_id: kw["tool_id"] = tool_id
            if status: kw["status"] = status
            stored = self._emit(self._mkrow("tool", txt, **kw))
            if tool_id: self.tools[tool_id] = stored["event_id"]
        eid = self.tools.get(tool_id) if tool_id else None
        d = tl_diff_for_tool(tool_name, args if isinstance(args, dict) else None,
            meta if isinstance(meta, dict) else None)
        if d:
            dtxt, path, confirmed = d
            if confirmed or status == "completed":
                label = "applied (provider-confirmed)"
                dst = "applied"
            elif status == "failed":
                label = "failed (provider-reported, unapplied)"
                dst = "failed"
            else:
                label = "proposal (input-derived, unconfirmed)"
                dst = "proposal"
            kw = {"path": path} if path else {}
            kw["status"] = dst
            body = f"[{tool_name or 'tool'} diff — {label}]\n{dtxt}"
            deid = self.diff_eids.get(tool_id or txt)
            if deid and deid in self.rows:
                self._emit(dict(self.rows[deid], text=body, **kw))
            else:
                stored = self._emit(self._mkrow("diff", body, **kw))
                self.diff_eids[tool_id or txt] = stored["event_id"]
            if isinstance(args, dict):
                old = args.get("oldString", args.get("old_string"))
                new = args.get("newString", args.get("new_string"))
                if isinstance(old, str) and isinstance(new, str):
                    self.diffs[tool_id or txt] = (old, new)
        return eid

    def tool_args_delta(self, tool_seg, delta):
        acc = (self.seg_args.get(tool_seg, "") + (delta or ""))[:2000]
        self.seg_args[tool_seg] = acc
        tid = self.seg_tool.get(tool_seg)
        eid = self.tools.get(tid) if tid else self.toolsegs.get(tool_seg)
        if eid is None or eid not in self.rows:
            row = self.rows.get(eid) or {}
            name = row.get("tool_name") or "tool"
            stored = self._emit(self._mkrow("tool", _tl_tool_text(name, acc),
                tool_name=name))
            self.toolsegs[tool_seg] = stored["event_id"]
            return
        row = dict(self.rows[eid])
        row["text"] = _tl_tool_text(row.get("tool_name") or "tool", acc)
        self._emit(row)

    def toolout(self, tool_id, text, is_error=False):
        txt, _ = tl_bound(text or "", 4000)
        key = tool_id or ""
        if key and key in self.diffs and txt:
            old, new = self.diffs[key]
            for span, tag in ((old, "old_string"), (new, "new_string")):
                if isinstance(span, str) and len(span) > 50 and span in txt:
                    txt = txt.replace(span, f"[patch {tag} shown in diff row]")
        kw = {}
        if tool_id: kw["tool_id"] = tool_id
        if is_error: kw["status"] = "failed"
        self._emit(self._mkrow("toolout", txt, **kw))
        if tool_id and tool_id in self.tools:
            orig = self.rows.get(self.tools[tool_id]) or {}
            want = "failed" if is_error else "completed"
            if orig.get("status") != want:
                self._emit(dict(orig, status=want))
            # confirmed outcome transitions the linked diff row in place.
            deid = self.diff_eids.get(tool_id)
            if deid and deid in self.rows:
                orig = self.rows[deid]
                drow = dict(orig)
                body = drow.get("text") or ""
                if is_error:
                    body = body.replace("proposal (input-derived, unconfirmed)",
                        "failed (provider-reported, unapplied)")
                    drow["status"] = "failed"
                else:
                    body = body.replace("proposal (input-derived, unconfirmed)",
                        "applied (provider-confirmed)")
                    drow["status"] = "applied"
                drow["text"] = body
                if drow["text"] != orig.get("text") or \
                        drow.get("status") != orig.get("status"):
                    self._emit(drow)

    def error(self, text):
        if (text or "").strip():
            self._emit(self._mkrow("error", text.strip()[:2000]))

    def apply(self, op):
        try: k = op.get("op")
        except Exception: return
        if k == "assistant_text": self.assistant_text(op.get("text") or "", op.get("seg"))
        elif k == "reasoning_text": self.reasoning_text(op.get("text") or "", op.get("seg"))
        elif k == "assistant_delta":
            self.assistant_delta(op.get("seg", "?"), op.get("delta") or "")
        elif k == "reasoning_delta":
            self.reasoning_delta(op.get("seg", "?"), op.get("delta") or "")
        elif k == "tool":
            self.tool(op.get("tool_id") or "", op.get("tool_name") or "tool",
                op.get("args"), op.get("title") or "", op.get("status") or "",
                op.get("seg") or "", op.get("meta"))
        elif k == "tool_args_delta":
            self.tool_args_delta(op.get("tool_seg", "?"), op.get("delta") or "")
        elif k == "flush":
            self.flush(scope=op.get("scope") or "msg", seg=op.get("seg") or "")
        elif k == "toolout":
            self.toolout(op.get("tool_id") or "", op.get("text") or "",
                bool(op.get("is_error")))
        elif k == "error": self.error(op.get("text") or "")

    def seg_texts(self, kind="a"):
        """Final ordered segment texts (aggregate fallback for delta-only
        streams where legacy chunks stayed empty)."""
        return [self.rows[e]["text"] for e in self.order
            if self.rows[e].get("role") == ("assistant" if kind == "a" else "reasoning")]

    def finalize(self):
        """Close open segments and re-emit final snapshots so live == reloaded."""
        for (kind, key) in list(self.segs):
            self._close_seg(kind, key)
        if self.on_event:
            for eid in self.order:
                try: self.on_event(self.name, "timeline", dict(self.rows[eid]))
                except Exception: pass

