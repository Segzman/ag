            mode = "agentpick"
    def slash_sync():
        """Keep popup state consistent with the active composer buffer:
        leading / opens (unless Esc-suppressed), other text closes. An
        emptied buffer always resets (runs before the mode check so a
        submit that navigated away still leaves fresh state)."""
        nonlocal slash_open, slash_idx, slash_sup
        buf = home_inp if mode == "homeinput" else inp
        if not buf:
            slash_open, slash_sup, slash_idx = False, False, 0
            return
        if mode not in ("input", "homeinput"):
            return
        if buf.startswith("/"):
            if not slash_sup:
                slash_open = True
                slash_idx = min(slash_idx,
                    max(0, len(slash_popup_filter(buf[1:])) - 1))
        else:
            slash_open, slash_sup, slash_idx = False, False, 0
    def run_slash_entry(entry, buf):
        """Enter on a popup row. UI route normalizes to the canonical
        command (typed args carried along: '/model opus' runs verbatim);
        slash route runs the typed line as-is. Never shadows typed args,
        never sends unknown slash text to a model. The executed command
        is consumed from the originating composer BEFORE navigation, so
        a later Esc back never resurrects '/config' under new typing
        (which would glue into prose like '/config/quit'). Esc dismissal
        without Enter keeps the draft (handled in handle_slashkey)."""
        nonlocal slash_open, slash_sup, slash_idx, slash_off, want_quit
        nonlocal inp, home_inp
        src_home = (mode == "homeinput")
        cmd = (entry or {}).get("cmd", "")
        route = (entry or {}).get("route", "slash")
        slash_open, slash_sup = False, True
        # consume the exact executed line from the composer it came from;
        # send_active navigates (mode changes), so snapshot first.
        if src_home:
            home_inp = ""
        else:
            inp = ""
        slash_idx, slash_off = 0, 0
        if route == "quit":
            want_quit = True
            return
        if route == "ui" and cmd:
            parts = buf[1:].split(None, 1) if buf.startswith("/") else []
            args = parts[1] if len(parts) > 1 else ""
            send_active("/" + cmd + ((" " + args) if args else ""))
            return
        send_active(buf)
    def handle_slashkey(ch):
        """Slash-popup keys: letters filter in place, arrows move, Tab
        completes canonical text without executing, Enter runs, Esc
        dismisses keeping the draft, Backspace past / dismisses. Consumes."""
        nonlocal slash_open, slash_idx, slash_off, slash_sup, slash_last_click
        nonlocal inp, home_inp, scroll
        import curses as _cu
        buf = home_inp if mode == "homeinput" else inp
        def _set(s):
            nonlocal inp, home_inp
            if mode == "homeinput":
                home_inp = s
            else:
                inp = s
        query = buf[1:] if buf.startswith("/") else ""
        matches = slash_popup_filter(query)
        slash_idx = min(slash_idx, max(0, len(matches) - 1)) if matches else 0
        if ch in (10, 13):
            # Empty match never invokes a stale item: the typed line runs
            # verbatim (unknown /word errors honestly, never model prose).
            if matches:
                run_slash_entry(SLASH_COMMANDS[matches[slash_idx]], buf)
            else:
                slash_open, slash_sup = False, True
                send_active(buf)
            return True
        if ch == 27:
            slash_open, slash_sup = False, True  # dismiss, draft kept
            return True
        if ch == 9:  # Tab: complete canonical text, keep args, keep composing
            if matches:
                _set(slash_popup_complete(buf, SLASH_COMMANDS[matches[slash_idx]]))
                slash_idx, slash_last_click = 0, -1
            return True
        if ch in (_cu.KEY_UP,):
            if matches:
                slash_idx = max(0, slash_idx - 1)
            return True
        if ch in (_cu.KEY_DOWN,):
            if matches:
                slash_idx = min(len(matches) - 1, slash_idx + 1)
            return True
        if ch in (_cu.KEY_PPAGE,):
            if matches:
                slash_idx = max(0, slash_idx - 5)
            else:
                scroll = scroll + 5
            return True
        if ch in (_cu.KEY_NPAGE,):
            if matches:
                slash_idx = min(len(matches) - 1, slash_idx + 5)
            else:
                scroll = max(0, scroll - 5)
            return True
        if ch in (_cu.KEY_BACKSPACE, 127, 8):
            nb = buf[:-1]
            _set(nb)
            if not nb.startswith("/"):
                slash_open, slash_sup = False, False
            else:
                slash_idx = 0
            return True
        if ch in (_cu.KEY_LEFT, _cu.KEY_RIGHT):
            return True  # append-only composer: no cursor, never text
        if isinstance(ch, str):
            try:
                printable = ch.isprintable()
            except Exception:
                printable = True
            if printable and len(ch) == 1:
                _set(buf + ch)
                slash_idx = 0
            return True
        if isinstance(ch, int) and ch >= 256:
            return True  # KEY_RESIZE etc never text
        if 32 <= ch <= 126:
            _set(buf + chr(ch))
            slash_idx = 0
        elif 128 <= ch <= 0x10FFFF:
            try:
                if chr(ch).isprintable():
                    _set(buf + chr(ch))
                    slash_idx = 0
            except Exception:
                pass
        return True
    def handle_mouse():
        """KEY_MOUSE: clicks select rows/popup/composer, wheel scrolls.
        Best-effort (unsupported terminals are ignored); every action keeps
        keyboard parity, never a mouse-only path."""
        nonlocal home_idx, active, scroll, mode, screen, slash_idx, pick_idx
        nonlocal slash_open, last_pick_click, slash_last_click, last_home_click
        try:
            import curses as _cm
            _, mx, my, _, b = _cm.getmouse()
        except Exception:
            return
        try:
            up4 = getattr(_cm, "BUTTON4_PRESSED", 0)
            if b and up4 and (b & up4):
                scroll = scroll + 3
                return
        except Exception:
            pass
        if pop_box is not None and slash_open:
            bx, by, bw, bh, vis = pop_box
            if bx <= mx < bx + bw and by <= my < by + bh:
                pos = slash_off + (my - by - 1)
                buf = home_inp if mode == "homeinput" else inp
                matches = slash_popup_filter(buf[1:] if buf.startswith("/") else "")
                if 0 <= pos < len(matches):
                    if pos == slash_idx or pos == slash_last_click:
                        run_slash_entry(SLASH_COMMANDS[matches[pos]], buf)
                    else:
                        slash_idx, slash_last_click = pos, pos
                return
        if screen == "home" and mode not in ("palette", "config", "compact",
                "context", "projpick", "agentpick", "help"):
            if my in click_home:
                flat = home_flat_agents(group_agents_by_workdir(chats, tui_cwd))
                fi = click_home[my]
                if 0 <= fi < len(flat):
                    nm = flat[fi]["name"]
                    if nm == last_home_click and flat[fi]["name"] == (
                            flat[home_idx]["name"] if 0 <= home_idx < len(flat) else ""):
                        sync_active_to_home(flat)
                        screen, mode, scroll = "chat", "input", 0
                        last_home_click = ""
                    else:
                        home_idx = fi
                        sync_active_to_home(flat)
                        last_home_click = nm
                return
            cx, cy, cw2, ch2 = comp_box
            if cx <= mx < cx + cw2 and cy <= my < cy + ch2:
                if mode != "homeinput":
                    mode = "homeinput"
                return
            return
        if screen == "chat" and mode in ("input", "homeinput", "normal"):
            if my in click_chat:
                ri = click_chat[my]
                if 0 <= ri < len(chats):
                    active = ri
                    flat = home_flat_agents(group_agents_by_workdir(chats, tui_cwd))
                    sync_home_to_active(flat)
                    scroll = 0
                return
            cx, cy, cw2, ch2 = comp_box
            if cx <= mx < cx + cw2 and cy <= my < cy + ch2:
                if mode != "input":
                    mode = "input"
                return
            return
        if mode in ("projpick", "agentpick"):
            opts = proj_names if mode == "projpick" else agent_names
            n = len(opts)
            if 0 <= pick_idx < n and my in click_home:
                pos = click_home[my]
                if 0 <= pos < n:
                    if pos == pick_idx or pos == last_pick_click:
                        confirm_chooser()
                    else:
                        pick_idx, last_pick_click = pos, pos
                return
    def confirm_chooser():
        """Enter on a project/agent chooser row. Projects: jump home to the
