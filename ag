        reason = check_dangerous(cmd, sdir)
        if reason:
            h = hashlib.sha256(cmd.encode()).hexdigest()[:16]; rid = h[:8]
            try: approvals = json.loads((sdir/"approvals.json").read_text())
            except Exception: approvals = []
            if not any(x.get("id")==rid and x.get("status")=="pending" for x in approvals):
