def do_shell(a):
    print(f"ag shell v{VERSION} (type exit, --json for machine mode)")
    js = False
    while True:
        try: line = input("ag> ").strip()
        except (EOFError,KeyboardInterrupt): break
        if not line: continue
        if line in ("exit","quit"): break
        if line=="--json": js=True; continue
        if line=="--text": js=False; continue
        parts = shlex.split(line)
        # dispatch one level: reuse main parser
        rc = main(parts+ (["--json"] if js and "--json" not in parts else []))
    return 0

# ---- harness: sub-agents use YOUR setup, portable for others ----
# ponytail: tar bundle + manifest, no new deps. Ceilings: redaction is
# pattern-based (audit before sharing); ~/.claude.json + credentials NEVER exported.
HARNESS_HOME_KEEP = ["agents","skills","commands"]
HARNESS_HOME_FILES = ["settings.json","CLAUDE.md"]
HARNESS_PROJ = ["CLAUDE.md",".claude",".mcp.json","opencode.json",".opencode"]
REDACT_KEYS = re.compile(r"api.?key|token|secret|passwd|password|auth|bearer|cookie|session", re.I)
REDACT_VALS = re.compile(r"sk-ant-[A-Za-z0-9\-_]{10,}|sk-[A-Za-z0-9]{10,}|ghp_[A-Za-z0-9]{10,}|xox[bpas]-[A-Za-z0-9\-]{10,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9\-_]{20,}")

def _redact_json(obj, path=""):
    red = []
    if isinstance(obj, dict):
        for k,v in obj.items():
            p = f"{path}.{k}" if path else str(k)
            if REDACT_KEYS.search(k or ""):
                if isinstance(v,(dict,list)): red += _redact_json(v,p)
                else: obj[k]="REDACTED"; red.append(p)
            elif isinstance(v,str) and REDACT_VALS.search(v):
                obj[k]="REDACTED"; red.append(p)
            elif isinstance(v,(dict,list)): red += _redact_json(v,p)
    elif isinstance(obj, list):
        for i,v in enumerate(obj):
            p = f"{path}[{i}]"
            if isinstance(v,str) and REDACT_VALS.search(v):
                obj[i]="REDACTED"; red.append(p)
            elif isinstance(v,(dict,list)): red += _redact_json(v,p)
    return red

def harness_inventory(home, cwd):
    inv = {"home":str(home),"cwd":str(cwd),"claude_home":[],"project":[],"env":{},"notes":[]}
    ch = home/".claude"
    if ch.is_dir():
        for d in HARNESS_HOME_KEEP:
            p = ch/d
            if p.is_dir():
                inv["claude_home"].append({"path":f"~/.claude/{d}",
                    "files":sum(1 for _ in p.rglob("*") if _.is_file())})
        for f in HARNESS_HOME_FILES:
            p = ch/f
            if p.is_file():
                inv["claude_home"].append({"path":f"~/.claude/{f}","bytes":p.stat().st_size})
    else: inv["notes"].append("no ~/.claude")
    for f in HARNESS_PROJ:
        p = cwd/f
        if p.exists(): inv["project"].append({"path":f,"dir":p.is_dir()})
    for k in ("ANTHROPIC_API_KEY","OPENAI_API_KEY","GEMINI_API_KEY","GOOGLE_API_KEY"):
        if os.environ.get(k): inv["env"][k]="set"
    inv["notes"].append("never exported: ~/.claude.json, *credentials*, *local.json")
    return inv

def harness_export(home, cwd, out):
    import tarfile, io
    manifest = {"version":1,"exported_at":now_iso(),"redacted":[],"files":[]}
    def add(tar, full, arc):
        if full.is_dir():
            for f in sorted(full.rglob("*")):
                if f.is_file(): add(tar,f,arc+"/"+f.relative_to(full).as_posix())
            return
        data = full.read_bytes()
        if full.suffix==".json":
            try:
                o = json.loads(data.decode())
                red = _redact_json(o)
                if red: manifest["redacted"].append({"file":arc,"paths":red})
                data = json.dumps(o,indent=2).encode()
            except Exception: pass
        ti = tarfile.TarInfo(arc); ti.size=len(data); ti.mtime=int(time.time())
        tar.addfile(ti, io.BytesIO(data))
        manifest["files"].append(arc)
    with tarfile.open(out,"w:gz") as tar:
        ch = home/".claude"
        if ch.is_dir():
            for d in HARNESS_HOME_KEEP:
                if (ch/d).is_dir(): add(tar,ch/d,f"claude-home/{d}")
            for f in HARNESS_HOME_FILES:
                if (ch/f).is_file(): add(tar,ch/f,f"claude-home/{f}")
        for f in HARNESS_PROJ:
            p = cwd/f
            if p.exists(): add(tar,p,f"project/{f}")
        raw = json.dumps(manifest,indent=2).encode()
        ti = tarfile.TarInfo("manifest.json"); ti.size=len(raw); ti.mtime=int(time.time())
        tar.addfile(ti, io.BytesIO(raw))
    return manifest

def harness_import(bundle, home_to, proj_to, force=False):
    import tarfile
    wrote, skipped = [], []
    with tarfile.open(bundle,"r:gz") as tar:
        names = tar.getnames()
        man = json.loads(tar.extractfile("manifest.json").read().decode()) if "manifest.json" in names else {}
        for m in tar.getmembers():
            if not m.isfile() or m.name=="manifest.json": continue
            if ".." in m.name.split("/") or m.name.startswith("/"):
                skipped.append(m.name); continue
            if m.name.startswith("claude-home/"): dest = home_to/m.name[len("claude-home/"):]
            elif m.name.startswith("project/"): dest = proj_to/m.name[len("project/"):]
            else: skipped.append(m.name); continue
            if dest.exists() and not force: skipped.append(m.name); continue
            dest.parent.mkdir(parents=True,exist_ok=True)
            dest.write_bytes(tar.extractfile(m).read())
            wrote.append(str(dest))
    return {"wrote":wrote,"skipped":skipped,"redacted":man.get("redacted",[]),
        "hint":"fill REDACTED keys, then: ag harness link --to <project>"}

def _copy_missing(src, dst):
    n = 0
    if src.is_dir():
        for f in src.rglob("*"):
            if not f.is_file(): continue
            t = dst/f.relative_to(src)
            if t.exists(): continue
            t.parent.mkdir(parents=True,exist_ok=True)
            t.write_bytes(f.read_bytes()); n += 1
    elif not dst.exists():
        dst.parent.mkdir(parents=True,exist_ok=True)
        dst.write_bytes(src.read_bytes()); n += 1
    return n

def harness_link(home, cwd, dest):
    linked, missing = [], []
    for f in HARNESS_PROJ:
        p = cwd/f
        if not p.exists(): missing.append(f); continue
        linked.append(f"{f} ({_copy_missing(p,dest/f)} new)")
    ch = home/".claude"
    for d in HARNESS_HOME_KEEP:
        p = ch/d
        if not p.is_dir(): missing.append(f"~/.claude/{d}"); continue
        linked.append(f".claude/{d} ({_copy_missing(p,dest/'.claude'/d)} new)")
    return {"linked":linked,"missing":missing,"dest":str(dest)}

def do_harness(a):
    home = Path(a.home).expanduser() if getattr(a,"home",None) else Path.home()
    cwd = Path.cwd()
    if a.sub=="show":
        inv = harness_inventory(home,cwd)
        if getattr(a,"json",False): return emit(a,"harness",inv)
        t = ["== claude home =="]
        t += [f'{e["path"]} ({e.get("files",e.get("bytes"))})' for e in inv["claude_home"]] or ["(none)"]
        t += ["== project =="] + [e["path"] for e in inv["project"]] or ["(none)"]
        t += ["== env keys set =="] + list(inv["env"]) or ["(none)"]
        t += ["note: "+n for n in inv["notes"]]
        return emit(a,"harness",{"_text":"\n".join(t)})
    if a.sub=="export":
        out = a.file or "harness.tgz"
        man = harness_export(home,cwd,out)
        data = {"bundle":out,"files":len(man["files"]),"redacted":man["redacted"]}
        if getattr(a,"json",False): return emit(a,"harness",data)
        r = len(man["redacted"])
        return emit(a,"harness",{"_text":f"exported {len(man['files'])} files -> {out} ({r} redacted)",
            **data})
    if a.sub=="import":
        if not a.file: return emit(a,"harness",error="no bundle given")
        res = harness_import(Path(a.file),
            Path(a.home_to).expanduser() if a.home_to else home/".claude",
            Path(a.project_to).expanduser() if a.project_to else cwd, a.force)
        if getattr(a,"json",False): return emit(a,"harness",res)
        t = [f'wrote {len(res["wrote"])} files, skipped {len(res["skipped"])}']
        t += ["fill REDACTED keys, then link into a project"] if res["redacted"] else []
        return emit(a,"harness",{"_text":"\n".join(t),**res})
    if a.sub=="link":
        if not getattr(a,"to",None): return emit(a,"harness",error="no --to dir")
        res = harness_link(home,cwd,Path(a.to).expanduser())
        if getattr(a,"json",False): return emit(a,"harness",res)
        t = ["linked:"]+res["linked"]+["missing:"]+res["missing"] or ["(empty setup)"]
        return emit(a,"harness",{"_text":"\n".join(t),**res})

# ---- multi-backend agents: claude orchestrates, subs via opencode/gemini/codex ----
# ponytail: headless CLIs as backends, no API keys here. Ceilings: gemini free-tier
# dead (needs Antigravity/API key), codex vendor binary broken on this box (see doctor),
# gemini/codex turns are stateless + history replay (no reliable resume id).
MODELS = {
    "claude": ["default","sonnet","opus","haiku"],
    "opencode": ["default"],
    "gemini": ["default","gemini-2.5-pro","gemini-2.5-flash"],
    "codex": ["default"],
    "cursor": ["default","sonnet-4","sonnet-4-thinking","gpt-5"],
    "echo": ["default"],
}
PROBES = {"claude":["claude","--version"],"opencode":["opencode","--version"],
    "gemini":["gemini","--version"],"codex":["codex","--version"],"echo":["printf","ok"]}

def cycle_model(backend, cur):
    opts = MODELS.get(backend,["default"])
    return opts[(opts.index(cur)+1)%len(opts)] if cur in opts else opts[0]

def _model_opts(backend): return MODELS.get(backend,["default"])+["[custom…]"]

def _model_idx(c):
    opts = _model_opts(c["backend"])
    try: return opts.index(c.get("model","default"))
    except ValueError: return 0

def backend_argv(backend, *, model="", workdir=".", sid="", prompt=""):
    m = model if model and model!="default" else ""
    if backend=="claude":
        argv = ["claude","-p","--verbose","--output-format","stream-json"]
        if m: argv += ["--model",m]
        if sid: argv += ["--resume",sid]
        return argv + [prompt]
    if backend=="opencode":
        argv = ["opencode","run","--format","json"]
        if m: argv += ["-m",m]
        argv += ["--dir",workdir]
        if sid: argv += ["--session",sid]
        return argv + [prompt]
    if backend=="gemini":
        argv = ["gemini","-p",prompt,"-o","stream-json","--approval-mode","default"]
        if m: argv += ["-m",m]
        return argv
    if backend=="codex":
        argv = ["codex","exec"]
        if m: argv += ["-m",m]
        if sid: argv += ["resume",sid]
        return argv + [prompt]
    if backend=="cursor":
        argv = [_cursor_bin(),"-p","--output-format","stream-json"]
        if m: argv += ["--model",m]
        if sid: argv += ["--resume",sid]
        return argv + [prompt]
    if backend=="echo":
        return ["printf","%s\n",prompt]
    raise ValueError(f"unknown backend: {backend}")

def _cursor_bin():
    return shutil.which("agent") or str(Path.home()/".local/bin/agent")

def _parse_claude(line):
    try: o = json.loads(line)
    except Exception: return [("text",line[:500])] if line.strip() else []
    t = o.get("type")
    if t=="system" and o.get("subtype")=="init":
        return [("meta",o["session_id"])] if o.get("session_id") else []
    if t=="assistant":
        out = []
        try: blocks = o["message"]["content"]
        except Exception: blocks = []
        for b in blocks or []:
            if b.get("type")=="text" and b.get("text"): out.append(("text",b["text"]))
            elif b.get("type")=="tool_use":
                out.append(("tool",f'{b.get("name","tool")} {json.dumps(b.get("input",{}))[:160]}'))
        return out
    if t=="user":
        out = []
        try: blocks = o["message"]["content"]
        except Exception: blocks = []
        for b in blocks or []:
            if b.get("type")=="tool_result":
                c = b.get("content")
                if isinstance(c,list):
                    txt = " ".join(x.get("text","") for x in c if isinstance(x,dict) and x.get("type")=="text")
                else: txt = str(c or "")
                txt = txt.strip()
                out.append(("toolout",txt[:600] if txt else ("(error)" if b.get("is_error") else "(ok)")))
        return out
    if t=="result":
        return [("done",f'{o.get("subtype","")} cost=${o.get("total_cost_usd",0):.3f}')]
    return []

def _parse_opencode(line):
    try: o = json.loads(line)
    except Exception: return [("text",line[:500])] if line.strip() else []
    evs = []
    if o.get("sessionID"): evs.append(("meta",o["sessionID"]))
    t, p = o.get("type"), o.get("part",{}) or {}
    if t=="text" and p.get("text"): evs.append(("text",p["text"]))
    elif t=="tool_use":
        st = p.get("state",{}) or {}
        title = st.get("title") or json.dumps(st.get("input",{}))[:160]
        evs.append(("tool",f'{p.get("tool","tool")} {title}'))
        if st.get("output"): evs.append(("toolout",str(st["output"])[:600]))
    elif t=="step_finish" and p.get("reason")=="stop": evs.append(("done","stop"))
    return evs

def _parse_generic(line):
    try: o = json.loads(line)
    except Exception: return [("text",line[:500])] if line.strip() else []
    texts, tools = [], []
    def walk(x):
        if isinstance(x,dict):
            for k,v in x.items():
                kl = str(k).lower()
                if isinstance(v,str) and kl in ("text","content","output","message","response") and v.strip():
                    texts.append(v[:2000])
                elif isinstance(v,str) and kl in ("tool","tool_name","function","command") and v.strip():
                    tools.append(v[:200])
                elif isinstance(v,(dict,list)): walk(v)
        elif isinstance(x,list):
            for v in x: walk(v)
    walk(o)
    out = [("tool",t) for t in tools[:5]]
    if texts: out.append(("text","\n".join(texts)[:4000]))
    for mt in re.finditer(r"(?i)(?:session_?id|conversation_?id)[\s\":=,/]+([A-Za-z0-9_\-]{6,})|\b(ses_[A-Za-z0-9]{6,})\b", line):
        sid = mt.group(1) or mt.group(2)
        if sid: out.insert(0,("meta",sid)); break
    return out or [("text",line[:300])]

def parse_events(backend, line):
    """-> [(kind, text)]; kinds: text|tool|done|meta. Pure, no I/O."""
    line = line.strip()
    if not line: return []
    if backend=="claude": return _parse_claude(line)
    if backend=="opencode": return _parse_opencode(line)
    return _parse_generic(line)

def load_agents(sdir):
    try: rows = json.loads((sdir/"agents.json").read_text())
    except Exception: rows = []
    if not rows:
        rows = [{"name":"claude","backend":"claude","model":"default","dir":".","role":"orchestrator"},
                {"name":"oc","backend":"opencode","model":"default","dir":".","role":"sub"}]
    return rows

def save_agents(sdir, rows):
    (sdir/"agents.json").write_text(json.dumps(rows,indent=2))

def do_agents(a):
    sdir = state_dir(a.dir); ensure_state(sdir)
    if a.sub=="doctor":
        probes = dict(PROBES); probes["cursor"] = [_cursor_bin(),"--version"]
        rows = []
        for b,probe in probes.items():
            try:
                p = subprocess.run(probe,capture_output=True,text=True,timeout=15)
                ok = p.returncode==0
                ver = (p.stdout or p.stderr or "").strip().splitlines()[0][:60] if ok else (p.stderr or "")[:120]
                hint = ""
                if not ok and b=="codex": hint = "reinstall: npm i -g @openai/codex"
                if b=="gemini" and ok: hint = "free tier retired; needs Antigravity or API key"
                if b=="echo" and ok: hint = "local plumbing-test backend"
                rows.append({"backend":b,"ok":ok,"version":ver,"hint":hint})
            except FileNotFoundError:
                rows.append({"backend":b,"ok":False,"version":"","hint":"not on PATH"})
            except Exception as e:
                rows.append({"backend":b,"ok":False,"version":"","hint":str(e)[:100]})
        if getattr(a,"json",False): return emit(a,"agents",{"backends":rows})
        txt = "\n".join(f'{"ok " if r["ok"] else "BAD"} {r["backend"]:9} {r["version"]} {r["hint"]}' for r in rows)
        return emit(a,"agents",{"_text":txt})
    rows = load_agents(sdir)
    if a.sub=="list":
        if getattr(a,"json",False): return emit(a,"agents",{"agents":rows})
        txt = "\n".join(f'{r["name"]:10} {r["backend"]:9} {r.get("model","default"):12} {r.get("role","sub"):12} {r.get("dir",".")}' for r in rows) or "(none)"
        return emit(a,"agents",{"_text":txt})
    if a.sub=="add":
        if any(r["name"]==a.name for r in rows):
            return emit(a,"agents",error=f"exists: {a.name}")
        rows.append({"name":a.name,"backend":a.backend,"model":a.model or "default",
            "dir":a.adir or ".","role":a.role})
        save_agents(sdir,rows)
        return emit(a,"agents",{"_text":f"added {a.name}"})
    if a.sub=="rm":
        rows = [r for r in rows if r["name"]!=a.name]
        save_agents(sdir,rows)
        return emit(a,"agents",{"_text":f"removed {a.name}"})
    if a.sub=="set":
        hit = [r for r in rows if r["name"]==a.name]
        if not hit: return emit(a,"agents",error=f"no such agent: {a.name}")
        r = hit[0]
        if a.backend: r["backend"]=a.backend
        if a.model: r["model"]=a.model
        if a.adir: r["dir"]=a.adir
        if a.role: r["role"]=a.role
        save_agents(sdir,rows)
        return emit(a,"agents",{"_text":f"updated {a.name}"})

