def _setup_cli_ok():
    try: import curses  # noqa: F401
    except ImportError: return False
    try: c, l = os.get_terminal_size(sys.stdout.fileno())
    except OSError: return False
    return l >= SETUP_MIN[0] and c >= SETUP_MIN[1]

def _sput(win, y, x, s, attr=0):
    import curses
    h, w = win.getmaxyx()
    if not (0 <= y < h and 0 <= x < w): return
    try: win.addstr(y, x, s[:max(0, w - x - (1 if y == h - 1 else 0))], attr)
    except curses.error: pass

_SETUP_SEQ = {"A": "KEY_UP", "B": "KEY_DOWN", "C": "KEY_RIGHT", "D": "KEY_LEFT", "5~": "KEY_PPAGE", "6~": "KEY_NPAGE"}
def _setup_getkey(win):
    """get_wch + decode CSI/SS3 arrows terminfo didn't map (ESC [ B vs ESC O B); else a bare ESC would cancel."""
    import curses
    ch = win.get_wch()
    if ch != "\x1b": return ch
    win.nodelay(True); seq = ""
    try:
        while len(seq) < 4:
            try: c = win.get_wch()
            except curses.error: break
            if not isinstance(c, str): curses.ungetch(c); break
            if not seq and c not in "[O": curses.unget_wch(c); break
            seq += c
            if len(seq) > 1 and (c.isalpha() or c == "~"): break
    finally: win.nodelay(False)
    if not seq: return "\x1b"
    k = _SETUP_SEQ.get(seq[1:])
    return getattr(curses, k) if k else None

_SETUP_ENTER = ("\n", "\r", 343)  # 343 = KEY_ENTER
_SETUP_BS = ("\x7f", "\b", 263)   # 263 = KEY_BACKSPACE

def _setup_cli_box(scr, redraw, bh, bw):
    import curses
    redraw(); h, w = scr.getmaxyx()
    bh, bw = max(3, min(bh, h - 2)), max(10, min(bw, w - 2))
    win = curses.newwin(bh, bw, max(0, (h - bh) // 2), max(0, (w - bw) // 2))
    win.keypad(True); win.erase(); win.box()
    return win, bh, bw

def _setup_cli_pick(scr, redraw, title, items, cur=None, multi=False, chosen=(), custom=False, info=""):
    """Popup picker: type to filter (Backspace edits), ↑↓/PgUp/PgDn, Enter picks, Esc cancels;
    multi: Space toggles, Enter confirms; custom: Tab or the last row -> free-text id."""
    import curses
    q, pos, top, chosen = "", (items.index(cur) if cur in items else 0), 0, list(chosen)
    CROW = "custom…" if not os.environ.get("AG_ASCII") else "custom..."
    while True:
        hits = setup_filter(items, q); vis = hits + ([CROW] if custom else [])
        pos = max(0, min(pos, len(vis) - 1))
        win, bh, bw = _setup_cli_box(scr, redraw, len(vis) + 6, max(46, max(map(len, vis + [title, info]), default=0) + 10))
        n = max(1, bh - 6)
        top = min(max(top, pos - n + 1), pos)
        _sput(win, 0, 2, f" {title} ", curses.A_BOLD)
        _sput(win, 1, 2, info + (f" · {len(hits)}/{len(items)} match" if q else ""))
        _sput(win, 2, 2, f"filter: {q}_" if q else "type to filter", 0 if q else getattr(curses, "A_DIM", 0))
        for i, it in enumerate(vis[top:top + n]):
            k = top + i
            box = ("[x] " if it in chosen else "[ ] ") if multi and it != CROW else ""
            _sput(win, 3 + i, 2, f'{G("›") if k == pos else " "} {box}{it}{"  (current)" if it == cur else ""}',
                curses.A_REVERSE if k == pos else 0)
        hint = "Space toggle · Enter done · Esc cancel" if multi else "Enter pick · Esc cancel" + (" · Tab custom id" if custom else "")
        _sput(win, bh - 2, 2, hint + (f"  {pos + 1}/{len(vis)}" if len(vis) > n else ""), getattr(curses, "A_DIM", 0))
        win.noutrefresh(); curses.doupdate()
        try: ch = _setup_getkey(win)
        except curses.error: continue
        if ch == "\x1b": return None
        if ch in _SETUP_ENTER:
            if multi: return [i for i in items if i in chosen]
            if not vis: continue
            if vis[pos] != CROW: return vis[pos]
            ch = "\t"
        if ch == "\t" and custom:
            v = _setup_cli_input(scr, redraw, title, "custom id", cur or "")
            if v: return v
        elif ch == curses.KEY_UP: pos -= 1
        elif ch == curses.KEY_DOWN: pos += 1
        elif ch == curses.KEY_PPAGE: pos -= n
        elif ch == curses.KEY_NPAGE: pos += n
        elif ch == " " and multi:
            if vis and vis[pos] != CROW: chosen = [c for c in chosen if c != vis[pos]] if vis[pos] in chosen else chosen + [vis[pos]]
        elif ch in _SETUP_BS: q, pos = q[:-1], 0
        elif ch == "\x15": q, pos = "", 0
        elif isinstance(ch, str) and ch.isprintable() and not (ch == "/" and not q): q, pos = q + ch, 0

def _setup_cli_input(scr, redraw, title, prompt, default=""):
    import curses
    s = default
    try: curses.curs_set(1)
    except curses.error: pass
    try:
        while True:
            win, bh, bw = _setup_cli_box(scr, redraw, 6, 70)
            _sput(win, 0, 2, f" {title} ", curses.A_BOLD); _sput(win, 1, 2, prompt)
            shown = s[-(bw - 7):]
            _sput(win, 2, 2, "> " + shown); _sput(win, 4, 2, "Enter ok · Esc cancel · Ctrl-U clear", getattr(curses, "A_DIM", 0))
            try: win.move(2, min(4 + len(shown), bw - 2))
            except curses.error: pass
            win.noutrefresh(); curses.doupdate()
            try: ch = _setup_getkey(win)
            except curses.error: continue
            if ch == "\x1b": return None
            if ch in _SETUP_ENTER: return s.strip() or None
            if ch in _SETUP_BS: s = s[:-1]
            elif ch == "\x15": s = ""
            elif isinstance(ch, str) and ch.isprintable(): s += ch
    finally:
        try: curses.curs_set(0)
        except curses.error: pass

def _setup_cli_confirm(scr, redraw, title, lines, hint="y/Enter yes · n/Esc no", anykey=False):
    import curses
    while True:
        win, bh, bw = _setup_cli_box(scr, redraw, len(lines) + 5, max(map(len, lines + [title, hint])) + 6)
        n = max(1, bh - 4)
        shown = lines if len(lines) <= n else lines[:n - 1] + [f"{G('…')} {len(lines) - n + 1} more"]
        _sput(win, 0, 2, f" {title} ", curses.A_BOLD)
        for i, ln in enumerate(shown): _sput(win, 1 + i, 2, ln)
        _sput(win, bh - 2, 2, hint, curses.A_BOLD)
        win.noutrefresh(); curses.doupdate()
        try: ch = _setup_getkey(win)
        except curses.error: continue
        if ch == curses.KEY_RESIZE: continue
        if anykey or ch in ("y", "Y") + _SETUP_ENTER: return True
        if ch in ("n", "N", "q", "\x1b"): return False

def _setup_cli_head():
    if os.environ.get("AG_ASCII"): return "ag setup - up/down move - Enter edit - s save - q quit - ? help"
    return "ag setup — ↑↓ move · ⏎ edit · s save · q quit · ? help"

def _setup_cli_draw(scr, st, S, bg):
    import curses
    scr.erase(); h, w = scr.getmaxyx()
    if h < SETUP_MIN[0] or w < SETUP_MIN[1]:
        _sput(scr, 0, 0, f"terminal too small ({w}x{h}, need {SETUP_MIN[1]}x{SETUP_MIN[0]}); q quits"); scr.noutrefresh(); return
    B, R, D = curses.A_BOLD, curses.A_REVERSE, getattr(curses, "A_DIM", 0)
    _sput(scr, 0, 0, _setup_cli_head(), B)
    rows, y = setup_rows(st), 2
    for i, (_, lab) in enumerate(rows[:4]):
        name, _, val = lab.partition(": "); on = S["sel"] == i
        _sput(scr, y, 0, f'{G("›") if on else " "} {name:<16}', B if on else 0); _sput(scr, y, 19, val, R if on else 0); y += 1
    custom = setup_custom_jobs(st)
    _sput(scr, y + 1, 2, f'{"Job":<12}{"Claude":<10}ag backend / model', B | curses.A_UNDERLINE); y += 2
    for n, j in enumerate(JOB_KEYS):
        e, on = st["jobs"][j], S["sel"] == 4 + n
        _sput(scr, y, 0, f'{G("›") if on else " "} {j + ("*" if j in custom else ""):<11}', B if on else 0)
        _sput(scr, y, 14, e["claude"], R if on and S["col"] == 0 else 0)
        _sput(scr, y, 24, f'{e["ag"]["backend"]} / {e["ag"]["model"]}', R if on and S["col"] >= 1 else 0); y += 1
    _sput(scr, y + 1, 2, f'{"Backend":<12}{"On":<5}{"Default model":<32}{"Mode":<8}Plan', B | curses.A_UNDERLINE); y += 2
    for n, b in enumerate(BACKEND_TABS):
        e, on = st["backends"][b], S["sel"] == 10 + n
        _sput(scr, y, 0, f'{G("›") if on else " "} {b:<11}', B if on else 0)
        for c, (x, v) in enumerate(((14, "yes" if e["enabled"] else "no"), (19, (e["model"] or "default")[:30]),
                (51, e["mode"] or "-"), (59, ("yes" if e["plan"] else "no") if CAPS[b]["plan"] else "n/a"))):
            _sput(scr, y, x, v, R if on and S["col"] == c else D if not e["enabled"] and c else 0)
        y += 1
    t = setup_targets(st); plan = t["plan"]
    _sput(scr, y + 1, 0, f'Writes ({st["scope"]}): {len(plan)} file{"s" * (len(plan) != 1)}', B); y += 2
    room = h - 1 - y
    shown = plan if len(plan) <= room else plan[:max(0, room - 1)]
    for p, _, _, s in shown: _sput(scr, y, 2, f"{s:<9} {_setup_short(p, w - 14)}", D if s == "unchanged" else 0); y += 1
    if len(shown) < len(plan): _sput(scr, y, 2, f"{G('…')} {len(plan) - len(shown)} more (s lists all)", D)
    msg = S["msg"] or (f'! {t["skill_err"]}' if t["skill_err"] else "refreshing model lists…" if bg is not None and bg.is_alive()
        else "* = differs from preset" if custom else "")
    _sput(scr, h - 1, 0, msg, D)
    scr.noutrefresh()

_SETUP_HELP = ["↑↓ / j k   move between rows", "←→ / h l / Tab   Claude vs ag column (job rows)",
    "Enter / e  edit the focused field", "  in pickers: type to filter, Backspace, Esc cancel,",
    "  Space toggles (harnesses), Tab = custom id", "s  review target files, then write", "q / Esc  quit without writing",
    "*  job differs from the preset", "Backend rows: ←→ pick On / model / mode / plan; Enter toggles or edits",
    "  disabled backends drop out of the ag backend picker"]

def _setup_cli_edit(scr, redraw, st, key, col):
    """Edit one field via popups; True if the state changed."""
    pk = lambda *a, **k: _setup_cli_pick(scr, redraw, *a, **k)
    if key == "scope":
        r = pk("Scope", ["global", "project"], cur=st["scope"], info="where routing.json + skills go")
        if r and r != st["scope"]: setup_set_scope(st, r); return True
    elif key == "harnesses":
        r = pk("Harnesses", list(SETUP_HARNESSES), multi=True, chosen=st["harnesses"], info="install ag-cli + ag-agents skills for")
        if r is not None and r != st["harnesses"]: st["harnesses"] = r; return True
    elif key == "preset":
        r = pk("Preset", list(ROUTING_PRESETS), cur=st["preset"], info="resets all six jobs")
        cj = setup_custom_jobs(st)
        if r and (not cj or _setup_cli_confirm(scr, redraw, f"Apply preset {r}?", ["overwrites your custom picks for:", "  " + ", ".join(cj)])):
            setup_apply_preset(st, r); return True
    elif key == "claude_md":
        cur = "auto" if st["claude_md"] is None else "yes" if st["claude_md"] else "no"
        r = pk("Write CLAUDE.md routing block", ["auto", "yes", "no"], cur=cur, info="~/.claude/CLAUDE.md, global scope only; auto = if claude harness")
        if r and r != cur: st["claude_md"] = None if r == "auto" else r == "yes"; return True
    elif key.startswith("job:"):
        j = key[4:]; e = st["jobs"][j]
        if col == 0:
            r = pk(f"{j}: Claude subagent model", list(SETUP_CLAUDE_ALIASES), cur=e["claude"], custom=True, info=JOB_DESC[j])
            if r and r != e["claude"]: setup_edit_job(st, j, claude=r); return True
        else:
            b = pk(f"{j}: ag backend", setup_enabled_backends(st), cur=e["ag"]["backend"], info=JOB_DESC[j] + " · enabled backends only")
            m = b and pk(f"{j}: {b} model", model_choices(b), cur=e["ag"]["model"] if b == e["ag"]["backend"] else "default",
                custom=True, info=setup_models_info(b))
            if m and {"backend": b, "model": m} != e["ag"]: setup_edit_job(st, j, ag={"backend": b, "model": m}); return True
    elif key.startswith("bk:"):
        b = key[3:]; e, cp = st["backends"][b], CAPS[b]
        if col == 0: setup_edit_backend(st, b, enabled=not e["enabled"]); return True
        if col == 1:
            r = pk(f"{b}: default model", model_choices(b), cur=e["model"] or "default", custom=True, info=setup_models_info(b))
            if r and (r if r != "default" else "") != e["model"]: setup_edit_backend(st, b, model=r); return True
        elif col == 2:
            adv = "" if cp["native_enforce"] else " (advisory)"
            r = pk(f"{b}: default permission mode", ["unset"] + [m + adv for m in cp["modes"]],
                cur=(e["mode"] + adv) if e["mode"] else "unset", info="used by ag agents add --backend " + b + " without --mode")
            if r and (r.split()[0] if r != "unset" else "") != e["mode"]: setup_edit_backend(st, b, mode="" if r == "unset" else r.split()[0]); return True
        elif cp["plan"]: setup_edit_backend(st, b, plan=not e["plan"]); return True
    return False

def _setup_cli_main(scr, st, bg):
    import curses
    try: curses.curs_set(0)
    except curses.error: pass
    scr.keypad(True)
    keys = [k for k, _ in setup_rows(st)]
    S = {"sel": 0, "col": 1, "msg": ""}
    dirty = False
    redraw = lambda: _setup_cli_draw(scr, st, S, bg)
    while True:
        scr.timeout(400 if bg is not None and bg.is_alive() else -1)
        redraw(); curses.doupdate()
        try: ch = _setup_getkey(scr)
        except curses.error: continue
        S["msg"] = ""
        h, w = scr.getmaxyx()
        if ch in ("q", "Q", "\x1b"):
            if not dirty or _setup_cli_confirm(scr, redraw, "Quit without saving?", ["your changes are not written"], "y quit · n/Esc stay"): return None
        elif h < SETUP_MIN[0] or w < SETUP_MIN[1]: continue
        elif ch in (curses.KEY_UP, "k"): S["sel"] = (S["sel"] - 1) % len(keys)
        elif ch in (curses.KEY_DOWN, "j"): S["sel"] = (S["sel"] + 1) % len(keys)
        elif ch in (curses.KEY_LEFT, "h", curses.KEY_RIGHT, "l", "\t"):  # job rows: 2 columns, backend rows: 4
            mc = 3 if keys[S["sel"]].startswith("bk:") else 1; c = min(S["col"], mc)
            S["col"] = max(0, c - 1) if ch in (curses.KEY_LEFT, "h") else min(mc, c + 1) if ch != "\t" else (c + 1) % (mc + 1)
        elif ch == "?": _setup_cli_confirm(scr, redraw, "ag setup keys", _SETUP_HELP, "any key closes", anykey=True)
        elif ch == "s":
            errs = setup_validate(st)
            if errs: _setup_cli_confirm(scr, redraw, "Can't save yet", errs, "any key closes", anykey=True); continue
            t = setup_targets(st)
            if _setup_cli_confirm(scr, redraw, "Write these files?", setup_summary_lines(st, t), "y/Enter write · n/Esc back"): return st
        elif ch in _SETUP_ENTER + ("e",):
            k = keys[S["sel"]]
            if _setup_cli_edit(scr, redraw, st, k, S["col"] if k.startswith("bk:") else min(S["col"], 1)): dirty = True; S["msg"] = "edited (s to save)"

def setup_ui_cli(st, bg=None):
    """Single-screen curses editor over the shared state; st on save, None on quit."""
    import curses, locale
    os.environ.setdefault("ESCDELAY", "25")
    try: locale.setlocale(locale.LC_ALL, "")
    except locale.Error: pass
    return curses.wrapper(_setup_cli_main, st, bg)

def do_setup(a):
    want = (getattr(a, "ui", None) or os.environ.get("AG_SETUP_UI") or "").strip().lower()
    if want and want not in SETUP_UIS: return emit(a, "setup", error=f"bad --ui/AG_SETUP_UI {want!r}: {'|'.join(SETUP_UIS)}")
    inter = not a.yes and (sys.stdin.isatty() or want in ("web", "mac"))  # the web form needs no TTY
    if not inter and not a.yes and not a.dry_run:
        return emit(a, "setup", error="stdin is not a TTY: pass --yes (plus flags) to run non-interactively",
            hint="ag setup --yes --scope global --harness claude --preset cost-first")
    try:
        rest, bsets = parse_backend_sets(a.set)
        sets = parse_route_sets(rest)
        harn = parse_harness_list(a.harness) if a.harness is not None else None
    except ValueError as e: return emit(a, "setup", error=str(e))
    ui = setup_ui_pick(want, tty=sys.stdin.isatty() and sys.stdout.isatty()) if inter else ""
    if ui == "cli" and not _setup_cli_ok(): ui = "plain"
    if ui == "plain":
        _say("refreshing model lists…")
        models_load(refresh=True, on_progress=lambda b, e: _say(f'  {b}: {len(e["models"])} models'
            + (f' (error: {e["error"]}; kept last good)' if e["error"] else "")))
    bg = _setup_bg_refresh() if ui in ("web", "cli") else None
    scope = a.scope or (_ask("scope (global|project)", "global") if ui == "plain" else "global")
    if scope not in ("global", "project"): return emit(a, "setup", error=f"bad scope {scope!r}: global|project")
    if harn is None:
        det = ",".join(detect_harnesses()) or "none"
        try: harn = parse_harness_list(_ask("install skills for (claude,opencode,codex|all|none)", det) if ui == "plain" else det)
        except ValueError as e: return emit(a, "setup", error=str(e))
    st = setup_state_from(scope, a.preset, sets, harn, a.claude_md, bsets=bsets)
    if ui == "plain" and not a.preset:
        p = _ask("preset (cost-first|balanced|quality-first)", st["preset"])
        if p != st["preset"]: st["preset"] = p; _setup_rebase(st)
    if st["preset"] not in ROUTING_PRESETS: return emit(a, "setup", error=f"bad preset {st['preset']!r}: {'|'.join(ROUTING_PRESETS)}")
    if ui == "plain":
        for j in JOB_KEYS:
            e = st["jobs"][j]
            _say(f'{j} — {JOB_DESC[j]}: claude={e["claude"]}  ag={e["ag"]["backend"]}/{e["ag"]["model"]}')
            if _ask("  change? (y/N)", "n").lower()[:1] != "y": continue
            c = _ask_pick("  claude subagent alias", list(SETUP_CLAUDE_ALIASES), e["claude"])
            b = _ask_pick("  ag backend (enabled)", setup_enabled_backends(st), e["ag"]["backend"])
            if b not in NATIVE_ORDER: _say(f"  unknown backend {b!r}, keeping {e['ag']['backend']}"); b = e["ag"]["backend"]
            m = _ask_pick("  ag model", model_choices(b), e["ag"]["model"] if b == e["ag"]["backend"] else "default")
            setup_edit_job(st, j, claude=c, ag={"backend": b, "model": m})
    elif ui == "web": return setup_ui_web(a, st)
    elif ui == "cli":
        try: st = setup_ui_cli(st, bg)
        except RuntimeError as e: return emit(a, "setup", error=str(e), hint="retry with --ui cli or --ui plain")
        if st is None: return emit(a, "setup", {"_text": "cancelled (nothing written)", "cancelled": True})
    errs = setup_validate(st)
    if errs: return emit(a, "setup", error="; ".join(errs), hint="ag setup --set backend.B.enabled=true  |  --set JOB=ag:BACKEND/MODEL")
    t = setup_targets(st)
    scope, harn, preset, jobs = st["scope"], st["harnesses"], st["preset"], st["jobs"]
    plan, notes, skill_err, block, tdir = t["plan"], t["notes"], t["skill_err"], t["block"], t["tdir"]
    if ui == "plain":
        _say(f"\nscope={scope} preset={preset} harnesses={','.join(harn) or 'none'}\n{block}\n")
        for p, _, _, s in plan: _say(f"  {s:9} {p}")
        if skill_err: _say(f"  ! {skill_err}")
        if _ask("write these files? (Y/n)", "y").lower()[:1] == "n": return emit(a, "setup", {"_text": "cancelled", "cancelled": True})
    files, out = [], []
    for p, txt, old, st_ in plan:
        rec = {"path": str(p), "status": st_}
        if a.dry_run:
            if st_ != "unchanged":
                rec["diff"] = "".join(difflib.unified_diff(old.splitlines(True), txt.splitlines(True),
                    str(p) if st_ == "changed" else "/dev/null", str(p)))
            out.append(f"would write {p} ({st_})" if st_ != "unchanged" else f"unchanged {p}")
            if rec.get("diff"): out.append(rec["diff"].rstrip("\n"))
        else:
            if st_ != "unchanged": _put_file(p, txt)
            out.append(f"{'wrote' if st_ != 'unchanged' else 'unchanged'} {p}")
        files.append(rec)
    out += notes
    data = {"scope": scope, "harnesses": harn, "preset": preset, "routing": jobs, "backends": st["backends"], "files": files,
        "dry_run": bool(a.dry_run), "notes": notes}
    if skill_err:
        if not getattr(a, "json", False): print("\n".join(out))
        return emit(a, "setup", data, error=skill_err,
            hint=f"skill templates live at {tdir}/<{'|'.join(SKILL_NAMES)}>/SKILL.md (override: AG_SKILLS_DIR)")
    return emit(a, "setup", {**data, "_text": "\n".join(out)})

