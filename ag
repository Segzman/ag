def slash_popup_filter(query):
    """Indices into SLASH_COMMANDS matching a composer query. Pure.
    Leading / stripped; match is on the command word (prefix ranks before
    description-substring), case-insensitive. Empty query lists everything
    in canonical order."""
    q = (query or "").lstrip("/").strip().lower()
    if not q:
        return list(range(len(SLASH_COMMANDS)))
    first = q.split()[0] if q.split() else q
    pre, sub = [], []
    for i, e in enumerate(SLASH_COMMANDS):
        c = e["cmd"].lower()
        if c.startswith(first):
            pre.append(i)
        elif first in f'{c} {e.get("desc", "").lower()}':
            sub.append(i)
    return pre + sub

def slash_popup_complete(buffer, entry):
    """Tab completion for the slash popup: canonical command word, typed
    arguments kept verbatim, never executed. Pure.
    '/mo' + model -> '/model'; '/model op' + model -> '/model op'."""
    s = buffer or ""
    rest = ""
    if s.startswith("/"):
        parts = s[1:].split(None, 1)
        rest = parts[1] if len(parts) > 1 else ""
    cmd = (entry or {}).get("cmd", "")
    if not cmd:
        return s
    return "/" + cmd + ((" " + rest) if rest else "")

def slash_visible_window(idx, off, vis, n):
    """Scroll offset keeping idx visible in a vis-tall window over n
    rows (selection never scrolls out of sight; mouse hit mapping
    pos = off + (my - by - 1) stays consistent). Pure."""
    vis = max(1, vis)
    off = max(0, min(off, max(0, n - 1)))
    if idx < off:
        off = idx
    elif idx >= off + vis:
        off = idx - vis + 1
    return max(0, off)

def slash_popup_rect(w, h, x0, cw, composer_y, composer_h, n_items):
    """Slash-popup rect anchored to the composer. Pure.
    Prefers directly ABOVE the composer; when the composer sits at the top
    (tiny screens) drops BELOW it so the draft stays visible. The status
    line is never covered. Returns (bx, by, bw, bh, vis)."""
    bw = max(20, min(cw, w - 2))
    bx = min(max(0, x0), max(0, w - bw))
    want = min(10, max(1, n_items if n_items else 1)) + 2
    above = max(0, composer_y)
    below = max(0, h - 1 - (composer_y + composer_h))
    if above >= min(want, 5):
        bh = min(want, max(3, above))
        by = composer_y - bh
    else:
        bh = min(want, max(3, below))
        by = composer_y + composer_h
    if by + bh > h - 1:
        bh = max(3, h - 1 - by)
    vis = max(1, bh - 2)
    return (bx, by, bw, bh, vis)

def _is_glue_mark(c):
    """Zero-width mark that extends a cluster: combining marks, variation
    selectors, emoji modifiers (skin tones U+1F3FB-U+1F3FF). ZWJ is NOT
    one (it joins in the dedicated step below). Pure."""
    import unicodedata as _u
    if _u.combining(c) or c in ("\ufe0e", "\ufe0f", "\u200b"):
        return True
    o = ord(c)
    return 0x1F3FB <= o <= 0x1F3FF

def _cell_clusters(s):
    """Split text into (cluster, cells) keeping base+combining/ZWJ-joined
    sequences whole so truncation/wrap never splits them. Pure."""
    import unicodedata as _u
    chars = list(s or "")
    out, i, n = [], 0, len(chars)
    while i < n:
        j = i + 1
        while j < n and _is_glue_mark(chars[j]):
            j += 1
        # swallow ZWJ-joined legs: ZWJ + next base (+ its marks)
        k = j
        while k < n and chars[k] == "\u200d" and k + 1 < n:
            k += 2
            while k < n and _is_glue_mark(chars[k]):
                k += 1
            j = k
        cluster = "".join(chars[i:j]) or chars[i]
        base = chars[i]
        if "\u200d" in cluster:
            wd = 2  # ZWJ emoji sequence renders as one wide glyph
        elif _u.combining(base) or base in ("\u200d", "\ufe0e", "\ufe0f", "\u200b"):
            wd = 0
        else:
            wd = 2 if _u.east_asian_width(base) in ("W", "F") else 1
        out.append((cluster, wd))
        i = j if j > i else i + 1
    return out

def cell_len(s):
    """Terminal cells for a string (CJK wide = 2, combining = 0). Pure."""
    return sum(wd for _, wd in _cell_clusters(s))

def cell_trunc(s, n, ellipsis="…"):
    """Cut to n cells with cluster-safe breaks. Pure. Ellipsis only when
    truncation happened (and n >= 2); n <= 0 gives ''."""
    s = s or ""
    cls = _cell_clusters(s)
    if sum(wd for _, wd in cls) <= n:
        return s
    if n <= 0:
        return ""
    ell = ellipsis if n >= 2 else ""
    budget = n - (cell_len(ell) if ell else 0)
    out, used = [], 0
    for c, wd in cls:
        if used + wd > budget:
            break
        out.append(c)
        used += wd
    return "".join(out) + ell

def foot_text(avail, wide, narrow):
    """Footer that fits: wide when it measures within avail cells, else
    the short form (still naming choose/confirm + Esc). Pure."""
    avail = max(10, avail)
    return wide if cell_len(wide) <= avail else cell_trunc(narrow, avail)

def cell_wrap_line(line, width):
    """Wrap one line to cell width (floor 10), space-break preferred,
    clusters never split, no chars dropped. Pure."""
    w = max(10, width)
    cls = _cell_clusters(line or "")
    if sum(wd for _, wd in cls) <= w:
        return [line or ""]
    out, i, n = [], 0, len(cls)
    while i < n:
        used, j = 0, i
        while j < n and used + cls[j][1] <= w:
            used += cls[j][1]
            j += 1
        if j >= n:
            out.append("".join(c for c, _ in cls[i:]))
            break
        sp = -1
        for k in range(i, j):
            if cls[k][0] == " ":
                sp = k
        if sp > i:
            out.append("".join(c for c, _ in cls[i:sp]))
            i = sp + 1
        else:
            out.append("".join(c for c, _ in cls[i:j]) if j > i else cls[i][0])
            i = j if j > i else i + 1
    return out or [""]

