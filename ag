    def run_palette(act):
        """Execute one palette action id. Returns 'quit' when the TUI should
        exit, else None. Real actions only: chat/config/pickers/new/delegate/
        home/help/theme/approve/backend-switch/handoff."""
        nonlocal mode, screen, home_idx, active, scroll, inp, msg, pick_idx
        nonlocal pal_idx, cfg_idx, pk_return, help_return, flow_inp
        if act == "quit":
            return "quit"
        if act == "home":
            screen = "home"; mode = "normal"; return None
        if act == "compact":
            if chats:
                open_compact(chats[active]["name"], (screen, base_mode()))
            return None
        if act == "help":
            help_return = pal_return
            mode = "help"; return None
        if act == "theme":
            cycle_theme(); mode, _ = pal_return; return None
        if act == "approve":
            approve_oldest(); mode, _ = pal_return; return None
        if act == "new":
            screen = "chat"; mode = "newname"; flow_inp = ""; return None
        if act == "delegate":
            subs = [c["name"] for c in chats if c.get("role")!="orchestrator"] or [c["name"] for c in chats]
            screen = "chat"; mode = "dagent"; flow_inp = subs[0] if subs else ""; return None
        kind, _, arg = act.partition(":")
        if kind == "chat" and any(c["name"]==arg for c in chats):
            ri = index_by_name(chats, arg)
            active = ri if ri is not None else active
            flat = home_flat_agents(group_agents_by_workdir(chats, tui_cwd))
            sync_home_to_active(flat)
            screen = "chat"; mode = "input"; scroll = 0; return None
        if kind == "config" and any(c["name"]==arg for c in chats):
            ri = index_by_name(chats, arg)
            active = ri if ri is not None else active
            flat = home_flat_agents(group_agents_by_workdir(chats, tui_cwd))
            sync_home_to_active(flat)
            cfg_idx = 0
            cfg_return = (screen, "normal")
            mode = "config"; return None
        if kind == "model" and any(c["name"]==arg for c in chats):
            ri = index_by_name(chats, arg)
            active = ri if ri is not None else active
            open_modelpick(); pk_return = pal_return; return None
        if kind == "backend":
            if chats and arg in tui_backend_opts():
                nm = chats[active]["name"]
                ok, out = switch_backend(sdir, nm, arg)
                show_slash(nm, f"/harness use {arg}", ok, out)
                msg = f'backend -> {arg}' if ok else out[:60]
            mode = pal_return[1] if pal_return[0]==screen else base_mode()
            return None
        if kind == "profile":
            if chats:
                nm = chats[active]["name"]
                want = arg
                r = profile_set_agent(sdir, nm, want)
                if "error" in r:
                    show_slash(nm, f"/profile use {want or '--none'}", False, r["error"])
                    msg = r["error"][:60]
                else:
                    show_slash(nm, f"/profile use {want or '--none'}", True,
                        f"{nm} profile -> {want or '(none)'} sid_cleared={r['sid_cleared']}")
                    msg = f'profile -> {want or "(none)"}'
            mode = pal_return[1] if pal_return[0]==screen else base_mode()
            return None
        if kind == "handoff" and any(c["name"]==arg for c in chats):
            if agent_busy(sdir, arg):
                msg = f"{arg} is busy (turn or handoff running); retry when idle."
            else:
                r = native_launch(sdir, arg, "")
                if not r.get("ok"):
                    show_slash(arg, "/handoff", False, r.get("error", "handoff failed"))
                    msg = (r.get("error") or "handoff failed")[:60]
                else:
                    msg = _tui_handoff_exec(stdscr, sdir, arg, r, show_slash)
            mode = pal_return[1] if pal_return[0]==screen else base_mode()
            return None
        if kind == "context":
            # real read-only view on the stable get_agent_context API (no
            # fake success: unassigned agents show the honest empty state).
            if any(c["name"]==arg for c in chats):
                open_context(arg, (screen, base_mode()))
                return None
            msg = "context view: integration pending"
            mode = pal_return[1] if pal_return[0]==screen else base_mode()
            return None
        return None
