def _xterm256_rgb(i):
    """(r,g,b) for a 256-palette index. Pure."""
    if i < 16:
        return [(0,0,0),(128,0,0),(0,128,0),(128,128,0),(0,0,128),(128,0,128),
                (0,128,128),(192,192,192),(128,128,128),(255,0,0),(0,255,0),
                (255,255,0),(0,0,255),(255,0,255),(0,255,255),(255,255,255)][i]
    if i < 232:
        i -= 16
        r, g, b = i // 36, (i % 36) // 6, i % 6
        return tuple(0 if v == 0 else 55 + v * 40 for v in (r, g, b))
    g = 8 + (i - 232) * 10
    return (g, g, g)

def theme_rgb(name, role):
    """((fg r,g,b), (bg r,g,b) or None) for PNG QA + docs. Pure."""
    spec = THEME_256.get(name, THEME_256["abyss"])
    fg, bg = spec.get(role, (252, None))
    fgb = _xterm256_rgb(fg) if isinstance(fg, int) else (230, 230, 230)
    bgb = _xterm256_rgb(bg) if isinstance(bg, int) else None
    return fgb, bgb
