    def render_slash_popup(buf, w, h):
        """Slash popup anchored to comp_box (above the composer, or below
        it when the composer sits at the top of a tiny screen). Canonical
        /command + plain description per row, reverse/accent selection,
        bounded count, short controls. Records pop_box + click_pop."""
        nonlocal slash_idx, slash_off, pop_box
        matches = slash_popup_filter(buf[1:] if buf.startswith("/") else "")
        if slash_idx >= len(matches):
            slash_idx = max(0, len(matches) - 1)
        cx, cy, cw2, ch2 = comp_box
        bx, by, bw, bh, vis = slash_popup_rect(w, h, cx, cw2, cy, ch2,
            len(matches))
        slash_off = slash_visible_window(slash_idx, slash_off, vis,
            len(matches))
        title = (f'commands {slash_idx + 1}/{len(matches)}'
            if matches else 'commands (no match)')
        draw_panel(bx, by, bw, bh, title)
        click_pop.clear()
        if matches:
            for j, mi in enumerate(matches[slash_off:slash_off + vis]):
                e = SLASH_COMMANDS[mi]
                sel = (slash_off + j) == slash_idx
                at = select_attr(th) if sel else th["text_c"]
                if sel:
                    put(by + 1 + j, bx + 2, " " * max(0, bw - 4), at)
                full = (f'{G("›") if sel else " "} /{e["cmd"]} '
                    f'{G("·")} {e.get("desc", "")}')
                put(by + 1 + j, bx + 2, cell_trunc(full, max(10, bw - 4)), at)
                click_pop[by + 1 + j] = slash_off + j
        else:
            put(by + 1, bx + 2, cell_trunc("(no match — Enter runs typed text)",
                max(10, bw - 4)), th["dim_c"])
        foot = (f'{G("↑")}{G("↓")} move {G("·")} tab complete '
            f'{G("·")} enter run {G("·")} esc keeps draft')
        put(by + bh - 1, bx + 2, cell_trunc(foot, max(10, bw - 4)), th["dim_c"])
        pop_box = (bx, by, bw, bh)
