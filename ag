    return (max(0, (w - cw) // 2), cw)

def ag_wordmark_lines(size="full"):
    """Centered ASCII 'ag' wordmark. Pure. full=5 rows, small=3, tiny=1."""
    if size == "tiny":
        return ["  __ _  __ _ "]
    if size == "small":
        return ["  __ _  __ _ ",
                " / _` |/ _` |",
                " \\__,_|\\__,_|"]
    return ["  __ _  __ _ ",
            " / _` |/ _` |",
            " | (_| | (_| |",
            "  \\__,_|\\__, |",
            "        |___/ "]

def wordmark_size(h, w):
    """Wordmark size for a terminal: less logo/padding at short heights. Pure."""
    if h < 18 or w < 40:
        return "none"
    if h < 24 or w < 60:
        return "tiny"
    if h < 30:
        return "small"
    return "full"

def palette_filter(items, query):
    """Indices of palette items matching query (case-insensitive substring
    over label+hint). Pure. Empty query matches everything, order kept."""
    q = (query or "").strip().lower()
    if not q:
        return list(range(len(items or [])))
    out = []
    for i, it in enumerate(items or []):
        hay = f'{it.get("label", "")} {it.get("hint", "")}'.lower()
        if q in hay:
            out.append(i)
