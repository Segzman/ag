def _web_v2(): return callable(globals().get("routing_load"))
def _web_rows():
    """Ranked catalog rows (catalog_rows when merged) + every plain model id as a bare row. Pure-ish (reads caches)."""
    f, out = globals().get("catalog_rows"), []
    try: src = [r for r in (f() or []) if isinstance(r, dict)] if callable(f) else []
    except Exception: src = []
    for r in src:
        i = r.get("id") or r.get("model")
        if r.get("backend") in BACKEND_TABS and isinstance(i, str) and i: out.append({k: r.get(k) for k in _WEB_ROW_KEYS} | {"id": i})
    have = {(r["backend"], r["id"]) for r in out}
    return out + [{k: None for k in _WEB_ROW_KEYS} | {"backend": b, "id": m} for b in BACKEND_TABS for m in model_choices(b) if (b, m) not in have]

def _web_job_ok(e):
    """Clean {claude, ag:{backend, model}} or None. Pure."""
    if not isinstance(e, dict): return None
    ga = e.get("ag") if isinstance(e.get("ag"), dict) else {}
    ok = lambda v, n: isinstance(v, str) and 0 < len(v) <= n and v == v.strip() and not re.search(r"[\x00-\x1f\s]", v)
    if not (ok(e.get("claude"), 64) and ga.get("backend") in BACKEND_TABS and ok(ga.get("model"), 200)): return None
    return {"claude": e["claude"], "ag": {"backend": ga["backend"], "model": ga["model"]}}

def _web_profiles(st, scope):
    """{profile: {jobs}} for the form. v2 (profiles branch merged): active_profile seed < stored profiles; else one 'default' from st. Reads."""
    seed = {j: {"claude": st["jobs"][j]["claude"], "ag": dict(st["jobs"][j]["ag"])} for j in JOB_KEYS}
    if not _web_v2(): return {"default": {"jobs": seed}}
    try: stored = (routing_load(scope) or {}).get("profiles") or {}
    except Exception: stored = {}
    out = {}
    for p in WEB_PROFILES:
        jobs = {j: {"claude": v["claude"], "ag": dict(v["ag"])} for j, v in seed.items()}
        try: aj = globals()["active_profile"](None, p)[1] if callable(globals().get("active_profile")) else {}
        except Exception: aj = {}
        for src in (aj, (stored.get(p) or {}).get("jobs") or {}):
            for j in JOB_KEYS:
                c = _web_job_ok((src or {}).get(j))
                if c: jobs[j] = c
        out[p] = {"jobs": jobs}
    return out

def setup_web_payload(st, status=None, dry=False):
    """Everything the page shows as one JSON-able dict. Reads caches (model lists, providers)."""
    gp, pp = routing_paths(st["proj"]); scopes = {}
    for sc in ("global", "project"):
        s = st if st["scope"] == sc else setup_state_from(sc, None, None, st["harnesses"], st["claude_md"], proj=st["proj"], existing=st["existing"])
        scopes[sc] = {"path": _setup_short(gp if sc == "global" else pp), "profiles": _web_profiles(s, sc),
            "backends": {b: dict(s["backends"][b]) for b in BACKEND_TABS}, "claude_md": bool(setup_claude_md_on(s)) and sc == "global"}
    hf = globals().get("detect_harness")
    try: harness = hf()[0] if callable(hf) else "none"
    except Exception: harness = "none"
    names = list(WEB_PROFILES) if _web_v2() else ["default"]
    cm = list(dict.fromkeys(list(SETUP_CLAUDE_ALIASES) + [m for m in model_choices("claude") if m != "default"]))
    return {"scope": st["scope"], "scopes": scopes, "harness": harness, "harnesses": list(st["harnesses"]), "harness_opts": list(SETUP_HARNESSES),
        "profile_names": names, "tab": harness if harness in names else names[0], "jobs": list(JOB_KEYS), "job_desc": JOB_DESC, "aliases": cm,
        "backends": list(BACKEND_TABS), "caps": {b: {"modes": list(CAPS[b]["modes"]), "advisory": not CAPS[b]["native_enforce"], "plan": CAPS[b]["plan"]} for b in BACKEND_TABS},
        "status": status or {}, "rows": _web_rows(), "dry_run": bool(dry)}

def setup_web_apply(st0, body, v2=None):
    """Validate the page's save body with the shared helpers. -> (errors, st, profiles|None). Pure given st0."""
    v2 = _web_v2() if v2 is None else v2
    if not isinstance(body, dict): return ["body must be a JSON object"], None, None
    errs, scope = [], body.get("scope")
    if scope not in ("global", "project"): errs.append(f"bad scope {scope!r}")
    hs = body.get("harnesses")
    if not isinstance(hs, list) or any(h not in SETUP_HARNESSES for h in hs): errs.append(f"harnesses must be a list of {','.join(SETUP_HARNESSES)}")
    if not isinstance(body.get("claude_md", False), bool): errs.append("claude_md must be true/false")
    names, prim = (WEB_PROFILES, "claude") if v2 else (("default",), "default")
    pin, profs = body.get("profiles"), {}
    if not isinstance(pin, dict): errs.append("profiles must be an object")
    else:
        for p, pv in pin.items():
            if p not in names: errs.append(f"unknown profile {p!r}"); continue
            jin = pv.get("jobs") if isinstance(pv, dict) and isinstance(pv.get("jobs"), dict) else {}
            profs[p] = {}
            for j in JOB_KEYS:
                c = _web_job_ok(jin.get(j))
                if c: profs[p][j] = c
                else: errs.append(f"{p}/{j}: bad target (need a Claude alias and backend + model; backend in {','.join(BACKEND_TABS)})")
        if prim not in profs: errs.append(f"profile {prim!r} is required")
    bk = {}
    if not isinstance(body.get("backends"), dict): errs.append("backends must be an object")
    else:
        for b, e in body["backends"].items():
            if b not in BACKEND_TABS or not isinstance(e, dict): errs.append(f"unknown backend {b!r}"); continue
            if e.get("mode") not in (None, "") and e["mode"] not in CAPS[b]["modes"]: errs.append(f"{b}: mode {e['mode']!r} not in {'|'.join(CAPS[b]['modes'])}"); continue
            if e.get("plan") is True and not CAPS[b]["plan"]: errs.append(f"{b}: no plan mode"); continue
            bk[b] = _bk_clean(e)
    if errs: return errs, None, None
    st = setup_state_from(scope, None, None, [h for h in SETUP_HARNESSES if h in hs], body.get("claude_md") if scope == "global" else None, proj=st0["proj"], existing=st0["existing"])
    st["edits"] = {j: dict(v) for j, v in profs[prim].items()}
    st["bedits"] = bk; _setup_rebase(st)
    errs = setup_validate(st)
    for p, jobs in profs.items():
        if p != prim: errs += [f"{p}/{j}: ag target {b} is disabled (enable {b} or pick another target)" for j, b in routing_disabled(jobs, st["backends"])]
    return errs, (None if errs else st), (profs if v2 else None)

def setup_web_plan(st, profs=None):
    """setup_targets + (v2) the routing file rewritten as {version:2, profiles:{...}} keeping unknown keys. Reads."""
    t = setup_targets(st)
    if profs is not None:
        gp, pp = routing_paths(st["proj"]); path = gp if st["scope"] == "global" else pp
        doc = dict(_json_or_empty(path)); old_p = doc.get("profiles") if isinstance(doc.get("profiles"), dict) else {}
        for k in ("jobs", "preset"): doc.pop(k, None)
        bks = json.loads(t["plan"][0][1]).get("backends")
        doc["version"], doc["profiles"] = 2, {**old_p, **{p: {**(old_p.get(p) if isinstance(old_p.get(p), dict) else {}), "jobs": j} for p, j in profs.items()}}
        doc.pop("backends", None)
        if bks: doc["backends"] = bks
        txt = json.dumps(doc, indent=2) + "\n"; old = _read_or_empty(path)
        t["plan"][0] = (path, txt, old, "unchanged" if path.exists() and old == txt else "changed" if path.exists() else "new")
    return t

def setup_write_plan(plan, dry):
    """Write (or diff) a setup_targets plan -> (files, text lines). Same output as do_setup's loop."""
    files, out = [], []
    for p, txt, old, s in plan:
        rec = {"path": str(p), "status": s}
        if dry:
            if s != "unchanged": rec["diff"] = "".join(difflib.unified_diff(old.splitlines(True), txt.splitlines(True), str(p) if s == "changed" else "/dev/null", str(p)))
            out.append(f"would write {p} ({s})" if s != "unchanged" else f"unchanged {p}")
            if rec.get("diff"): out.append(rec["diff"].rstrip("\n"))
        else:
            if s != "unchanged": _put_file(p, txt)
            out.append(f"{'wrote' if s != 'unchanged' else 'unchanged'} {p}")
        files.append(rec)
    return files, out

def setup_web_serve(st0, dry=False, idle=None, announce=None):
    """Serve the form until Save/Cancel/idle. -> {"saved": {...}} | {"cancelled": reason}. Nothing is written unless Save validates."""
    import http.server, secrets, hmac
    idle = float(os.environ.get("AG_SETUP_WEB_IDLE") or idle or WEB_IDLE_S)
    token = secrets.token_urlsafe(24)
    state = {"result": None, "last": time.monotonic()}; lock = threading.Lock(); done = threading.Event()
    srv_box = {}
    status = setup_backend_status()
    payload = setup_web_payload(st0, status, dry)
    page = _WEB_PAGE.replace("__DATA__", json.dumps(payload).replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026").replace("\u2028", "\\u2028").replace("\u2029", "\\u2029")).encode()
    class H(http.server.BaseHTTPRequestHandler):
        server_version = "ag-setup"; protocol_version = "HTTP/1.1"
        def log_message(self, *a): pass
        def _send(self, code, body=b"", ctype="application/json"):
            self.send_response(code); self.send_header("Content-Type", ctype + "; charset=utf-8"); self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store"); self.send_header("X-Content-Type-Options", "nosniff"); self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("Content-Security-Policy", _WEB_CSP); self.send_header("Connection", "close"); self.end_headers(); self.wfile.write(body); self.close_connection = True
        def _json(self, code, obj): self._send(code, json.dumps(obj).encode())
        def _gate(self):
            """403 unless Host is 127.0.0.1/localhost:<port>, Origin (if any) is this origin, and the first path segment is the token. -> subpath or None."""
            port = self.server.server_address[1]; hosts = (f"127.0.0.1:{port}", f"localhost:{port}")
            if self.headers.get("Host", "") not in hosts: self._send(403, b"forbidden", "text/plain"); return None
            o = self.headers.get("Origin")
            if o is not None and o not in [f"http://{h}" for h in hosts]: self._send(403, b"forbidden", "text/plain"); return None
            seg, _, rest = self.path.split("?", 1)[0].lstrip("/").partition("/")
            if not hmac.compare_digest(seg.encode(), token.encode()): self._send(403, b"forbidden", "text/plain"); return None
            state["last"] = time.monotonic(); return rest
        def do_GET(self):
            r = self._gate()
            if r is None: return
            if r == "": self._send(200, page, "text/html")
            else: self._send(404, b"not found", "text/plain")
        def do_POST(self):
            r = self._gate()
            if r is None: return
            if r not in ("save", "refresh", "cancel"): return self._send(404, b"not found", "text/plain")
            if not (self.headers.get("Content-Type", "").split(";")[0].strip().lower() == "application/json"): return self._json(415, {"ok": False, "errors": ["Content-Type must be application/json"]})
            try:
                n = int(self.headers.get("Content-Length") or 0)
                if not 0 <= n <= 1_000_000: raise ValueError
                body = json.loads(self.rfile.read(n) or b"{}")
            except ValueError: return self._json(400, {"ok": False, "errors": ["bad JSON body"]})
            with lock:
                if state["result"]: return self._json(409, {"ok": False, "errors": ["already finished"]})
                if r == "cancel": state["result"] = {"cancelled": "cancelled"}; self._json(200, {"ok": True}); done.set(); return
                if r == "refresh":
                    try:
                        models_load(refresh=True); rf = globals().get("catalog_refresh")
                        if callable(rf): rf()
                        return self._json(200, {"ok": True, "rows": _web_rows(), "status": setup_backend_status(0.1)})
                    except Exception as e: return self._json(500, {"ok": False, "errors": [f"refresh failed: {e}"]})
                errs, st, profs = setup_web_apply(st0, body)
                if errs: return self._json(400, {"ok": False, "errors": errs})
                try:
                    t = setup_web_plan(st, profs); files, out = setup_write_plan(t["plan"], dry)
                except OSError as e: return self._json(500, {"ok": False, "errors": [f"write failed: {e}"]})
                notes = t["notes"] + ([t["skill_err"]] if t["skill_err"] else [])
                state["result"] = {"saved": {"scope": st["scope"], "harnesses": st["harnesses"], "preset": st["preset"], "routing": st["jobs"], "profiles": profs,
                    "backends": st["backends"], "files": files, "dry_run": bool(dry), "notes": notes, "_text": "\n".join(out + t["notes"]), "skill_err": t["skill_err"], "tdir": str(t["tdir"])}}
                self._json(200, {"ok": True, "files": files, "notes": notes, "dry_run": bool(dry)}); done.set()
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H); srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True, name="ag-setup-web").start()
    url = f"http://127.0.0.1:{srv.server_address[1]}/{token}/"
    if announce: announce(url)
    try:
        while not done.wait(0.2):
            if time.monotonic() - state["last"] > idle: state["result"] = {"cancelled": f"idle timeout ({int(idle)}s)"}; break
        else: time.sleep(0.1)  # let the response flush
    finally: srv.shutdown(); srv.server_close()
    return state["result"]

def setup_ui_web(a, st0):
    """`ag setup --ui web`: serve, open the browser (skip: AG_SETUP_NO_OPEN=1), print the URL, emit like do_setup."""
    def announce(url):
        _say(f"ag setup form: {url}"); _say("  (127.0.0.1 only; Ctrl-C to abort; idle timeout 15 min)")
        if os.environ.get("AG_SETUP_NO_OPEN") == "1": return
        o = shutil.which("open" if sys.platform == "darwin" else "xdg-open")
        if o:
            try: subprocess.Popen([o, url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError: pass
    try: r = setup_web_serve(st0, bool(a.dry_run), announce=announce)
    except KeyboardInterrupt: r = {"cancelled": "interrupted"}
    if "saved" not in r: return emit(a, "setup", {"_text": f"{r['cancelled']} (nothing written)", "cancelled": True})
    d = r["saved"]
    if d["skill_err"]: return emit(a, "setup", d, error=d["skill_err"], hint=f"skill templates live at {d['tdir']}/<{'|'.join(SKILL_NAMES)}>/SKILL.md (override: AG_SKILLS_DIR)")
    return emit(a, "setup", d)



