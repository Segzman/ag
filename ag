def parse_slash(text):
    """Split leading /cmd or \\cmd from composer/headless input.
    Returns (cmd, args) normalized, or None for normal message text.
    `/` prefix: any /word is a command (unknown -> error/handoff, never prose).
    `\\` prefix: only known commands; other backslash text stays a message
    (Windows paths, \\n etc are never hijacked). Command words allow
    letters/digits/hyphens/underscores (e.g. /compact-now); a non-word char
    right after / (like '// comment') stays prose. A second / glued to a
    KNOWN command word (like '/config/quit') is a malformed command and
    parses so it errors locally; a /word path with an unknown first word
    (like '/Users/me/file') stays prose. Pure."""
    if not isinstance(text, str): return None
    s = text.lstrip()
    if not s or s[0] not in ("/", "\\"): return None
    m = re.match(r"^[/\\]([A-Za-z?][A-Za-z0-9_-]*)", s)
    if not m: return None
    word = m.group(1)
    rest = s[m.end():]
    if rest == "" or rest[0] in (" ", "\t", "\n"):
        cmd = SLASH_ALIASES.get(word.lower(), word.lower())
        args = rest.strip()
        if s[0] == "\\" and cmd not in SLASH_KNOWN: return None
        return (cmd, args)
    if rest[0] == "/" and s[0] == "/":
        # glued path: malformed command only when the first word is a
        # known command (/config/quit errors locally); otherwise prose
        # (absolute paths like /Users/me/file stay user input).
        known = set(SLASH_KNOWN) | {e["cmd"] for e in SLASH_COMMANDS} \
            | set(SLASH_ALIASES)
        if SLASH_ALIASES.get(word.lower(), word.lower()) in known \
                or word.lower() in known:
            return (word.lower() + rest.split()[0], "")
        return None
    return None

