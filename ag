def parse_slash(text):
    """Split leading /cmd or \\cmd from composer/headless input.
    Returns (cmd, args) normalized, or None for normal message text.
    `/` prefix: any /word is a command (unknown -> error/handoff, never prose).
    `\\` prefix: only known commands; other backslash text stays a message
    (Windows paths, \\n etc are never hijacked). Command words allow
    letters/digits/hyphens/underscores (e.g. /compact-now); a non-word char
    right after / (like '// comment') stays prose. A second / glued to a
    KNOWN command word (like '/config/quit') is a malformed command and
    parses so it errors locally; a /word path with an unknown first word
    (like '/Users/me/file') stays prose. Pure."""
    if not isinstance(text, str): return None
    s = text.lstrip()
    if not s or s[0] not in ("/", "\\"): return None
    m = re.match(r"^[/\\]([A-Za-z?][A-Za-z0-9_-]*)", s)
    if not m: return None
    word = m.group(1)
    rest = s[m.end():]
    if rest == "" or rest[0] in (" ", "\t", "\n"):
        cmd = SLASH_ALIASES.get(word.lower(), word.lower())
        args = rest.strip()
        if s[0] == "\\" and cmd not in SLASH_KNOWN: return None
        return (cmd, args)
    if rest[0] == "/" and s[0] == "/":
        # glued path: malformed command only when the first word is a
        # known command (/config/quit errors locally); otherwise prose
        # (absolute paths like /Users/me/file stay user input).
        known = set(SLASH_KNOWN) | {e["cmd"] for e in SLASH_COMMANDS} \
            | set(SLASH_ALIASES)
        if SLASH_ALIASES.get(word.lower(), word.lower()) in known \
                or word.lower() in known:
            return (word.lower() + rest.split()[0], "")
        return None
    return None

def tui_backend_opts():
    """Backend picker options. Pure; order stable for keyboard paths."""
    return list(NATIVE_ORDER)

def native_handoff_argv(backend, *, sid="", workdir=".", model=""):
    """Interactive native TUI argv preserving the session. Pure.
    Never includes auto-approve/bypass flags (see BYPASS_FLAGS). OpenCode
    carries the effective model via -m (verified root flag); default/missing
    resolves to the ag-level default. Other backends keep their bare launch."""
    if backend == "claude":
        return (["claude"] + (["--resume", sid] if sid else []), workdir or ".")
    if backend == "opencode":
        m = eff_model("opencode", model)
        return ([_opencode_bin()] + (["-m", m] if m else []), workdir or ".")
    if backend == "gemini":
        return (["gemini"], workdir or ".")
    if backend == "codex":
        return (["codex"], workdir or ".")
    if backend == "cursor":
        return ([_cursor_bin()] + (["--resume", sid] if sid else []), workdir or ".")
    raise ValueError(f"no native interactive session for backend: {backend}")

def _slash_sid(sdir, name, agent, backend):
    meta = load_chat_meta(sdir, name, agent=agent)
    sids = meta.get("sids") or {}
    if backend in sids and sids[backend]: return sids[backend]
    if meta.get("backend", agent.get("backend")) == backend:
        return meta.get("sid", "")
    return ""

def native_launch(sdir, name, backend=""):
    """Effective native launch with profile applied. Returns
    {ok, backend, argv, cwd, env, profile, sid} or {ok:False, error}.
    Never mutates global configs; env/argv point under profiles_effective/."""
    agents = {x["name"]: x for x in load_agents(sdir)}
    a = agents.get(name)
    if a is None:
        return {"ok": False, "error": f"no such agent: {name} (ag agents list)"}
    b = (backend or "").strip().lower() or a.get("backend", "claude")
    if b not in MODELS:
        return {"ok": False, "error": f"unknown backend: {b} (ag agents doctor)"}
    if b == "echo":
        return {"ok": False, "error": "echo is a local plumbing-test backend: no native TUI to hand off to."}
    sid = _slash_sid(sdir, name, a, b)
    try:
        argv, cwd = native_handoff_argv(b, sid=sid, workdir=a.get("dir", ".") or ".",
            model=a.get("model", "") or "")
    except ValueError as e:
        return {"ok": False, "error": str(e)}
    prof = (a.get("profile") or "").strip()
    env, extra = {}, []
    if prof:
        # reuse the headless scoping; backend here is the handoff target
        fake_agent = dict(a, backend=b)
        env = backend_env_for_profile(sdir, fake_agent, prof)
        extra = backend_argv_extra(b, sdir, prof)
    argv = list(argv) + list(extra)
    return {"ok": True, "backend": b, "argv": argv, "cwd": cwd,
        "env": env, "profile": prof, "sid": sid}

def native_handoff_text(sdir, name, backend=""):
    """Explain + give the working interactive attach for a backend. Pure I/O-light.
    Includes selected profile env/config (scoped, no global writes)."""
    agents = {x["name"]: x for x in load_agents(sdir)}
    a = agents.get(name, {})
    b = (backend or "").strip().lower() or a.get("backend", "claude")
    if b not in MODELS:
        return (False, f"unknown backend: {b} (ag agents doctor)")
    if b == "echo":
        return (False, "echo is a local plumbing-test backend: no native TUI to hand off to.")
    try:
        argv, cwd = native_handoff_argv(b, sid=_slash_sid(sdir, name, a, b),
            workdir=a.get("dir", ".") or ".", model=a.get("model", "") or "")
    except ValueError as e:
        return (False, str(e))
    sid = _slash_sid(sdir, name, a, b)
    resume = f"resumes session {sid}" if sid else "fresh session (pick resume inside the TUI if needed)"
    launch = native_launch(sdir, name, b)
    if launch.get("ok"):
        argv, cwd = launch["argv"], launch["cwd"]
        penv = launch.get("env") or {}
    else:
        penv = {}
    extra = ""
    if b == "opencode":
        extra = ("\n  native headless command: ag chat send <agent> --command <cmd> [args]"
            " (opencode-only, verified flag)")
        if sid:
            extra += f'\n  headless resume instead: opencode run --session {sid} --dir {cwd} "<msg>"'
    if b in ("gemini", "codex"):
        extra = ("\n  note: ag keeps gemini turns stateless (history replay); codex headless turns resume their thread"
            if b == "codex" else "\n  note: ag keeps gemini turns stateless (history replay); the TUI owns its own sessions.")
    cmd = " ".join(shlex.quote(t) for t in argv)
    prof_line = ""
    if launch.get("ok") and launch.get("profile"):
        eff = ensure_effective_profile(sdir, launch["profile"])
        files = (eff.get("files") or {}) if "error" not in eff else {}
        env_show = " ".join(f"{k}={v}" for k, v in sorted(penv.items())) or "(no extra env)"
        argv_show = " ".join(backend_argv_extra(b, sdir, launch["profile"])) or "(no extra argv)"
        unsup = (eff.get("unsupported") or [])[:3]
        prof_line = (f"\n  profile {launch['profile']}: env {env_show}"
            f"\n  profile argv: {argv_show}")
        if files:
            prof_line += f"\n  profile files: {', '.join(sorted(files))}"
        if unsup:
            prof_line += f"\n  profile unsupported: {'; '.join(unsup)}"
    return (True, f"native {b} needs its interactive TUI (slash runs there, {resume}):\n"
        f"  run: {cmd}   (cwd {cwd})\n"
        f"  headless fallback: ag spawn -- {cmd}  then: ag attach <id>{extra}{prof_line}\n"
        "no auto-approve flags are ever passed.")

def harness_current(sdir, name):
    """Selected backend and behavior, suitable for scripts as well as display."""
    a = next((r for r in load_agents(sdir) if r["name"] == name), None)
    if a is None: return {"error": f"no such agent: {name} (ag agents list)"}
    backend = a.get("backend", "claude")
    return {"agent": name, "backend": backend, "model": a.get("model", "default"),
        "effective_model": eff_model(backend, a.get("model")),
        "dir": a.get("dir", "."), "role": a.get("role", "sub"),
        "persona": a.get("persona", ""), "profile": a.get("profile", ""),
        "sid": _slash_sid(sdir, name, a, backend)}

def update_agent_settings(sdir, name, updates):
    """Apply settings under the same guard as turns, refusing rather than waiting.
    Models and native SIDs belong to their backend, including custom model IDs.
    Validate before writing so an invalid persona cannot partially switch."""
    new = updates.get("backend")
    if new is not None and new not in MODELS:
        return (False, f"unknown backend: {new} ({'/'.join(NATIVE_ORDER)})")
    persona = updates.get("persona")
    if persona and persona not in [r["name"] for r in load_roles(sdir)]:
        return (False, f"no such role: {persona} (ag roles list)")
    busy = f"{name} is busy (turn or handoff running); retry when idle."
    try:
        guard = _acquire_agent_turn(sdir, name, blocking=False)
    except BlockingIOError:
        return (False, busy)
    except OSError as e:
        # Unreadable/unwritable lock dir (EACCES/ENOSPC/ESTALE...): clean
        # error, never a traceback. Treated as busy-or-error; retry when idle.
        detail = e.strerror or e
        return (False, f"cannot acquire turn guard for {name}: {detail} ({busy})")
    try:
        if is_running(name) or _handoff_live(sdir, name): return (False, busy)
        rows = load_agents(sdir)
        a = next((r for r in rows if r["name"] == name), None)
        if a is None: return (False, f"no such agent: {name} (ag agents list)")
        old = a.get("backend", "claude")
        new = new or old
        meta = load_chat_meta(sdir, name, agent=a)
        models = dict(a.get("models") or {})
        models[old] = a.get("model", "default") or "default"
        model = updates.get("model")
        if model is None:
            model = models.get(new, "default")
        model = eff_model(new, model) or "default"
        sids = dict(meta.get("sids") or {})
        if meta.get("sid"):
            # A stale meta backend may differ from the roster: the SID still
            # belongs to its recorded owner, never implicitly to `old`.
            sids[meta.get("backend") or old] = meta["sid"]
        a.update(updates)
        a.update({"backend": new, "model": model})
        models[new] = model
        a["models"] = models
        save_agents(sdir, rows)
        meta.update({"backend": new, "model": model,
            "sid": sids.get(new, ""), "sids": sids})
        save_chat_meta(sdir, name, meta)
        if new != old:
            _event(sdir, "harness", name, backend=new, model=model)
            sid_note = f"resumes {sids[new]}" if sids.get(new) else "fresh session"
            return (True, f"backend {old} -> {new} ({model}, {sid_note}).")
        return (True, f"updated {name} [{new}] ({model}).")
    finally:
        _release_agent_turn(guard)

def switch_backend(sdir, name, new_backend, model=None):
    """Shared CLI/slash/TUI switch: preserve identity, backend models and SIDs."""
    updates = {"backend": (new_backend or "").strip().lower()}
    if model is not None: updates["model"] = model
    return update_agent_settings(sdir, name, updates)

def slash_help_text(sdir, name):
    agents = {x["name"]: x for x in load_agents(sdir)}
    a = agents.get(name, {})
    cur = f"[{name}: {a.get('backend', '?')} · {a.get('model', 'default')}] " if a else ""
    return f"{cur}{SLASH_HELP}"

def handle_slash(sdir, name, cmd, args):
    """Run a parsed slash command locally (never calls a backend binary).
    Returns (ok, reply_text). Pure of model I/O; may write roster/meta/events."""
    agents = {x["name"]: x for x in load_agents(sdir)}
    if name not in agents:
        return (False, f"no such agent: {name} (ag agents list)")
    a = agents[name]
    backend = a.get("backend", "claude")
    if cmd == "help":
        return (True, slash_help_text(sdir, name))
    if cmd == "harness":
        toks = (args or "").split()
        sub = toks[0].lower() if toks else "current"
        if sub == "list":
            lines = [f'{"*" if b == backend else " "} {b}' for b in NATIVE_ORDER]
            return (True, f"backends for {name} (* current):\n" + "\n".join(lines)
                + "\nswitch: /harness use <backend>   live probe: ag agents doctor")
        if sub in ("current", ""):
            sid = _slash_sid(sdir, name, a, backend)
            return (True, f"{name}: backend {backend} · model {a.get('model', 'default')} "
                f"· role {a.get('role', 'sub')} · dir {a.get('dir', '.')} "
                f"· session {'set' if sid else 'none'}")
        if sub in ("use", "select", "set"):
            tgt = toks[1].lower() if len(toks) > 1 else ""
            if not tgt: return (False, "usage: /harness use <backend>  (see /harness list)")
            return switch_backend(sdir, name, tgt)
        return switch_backend(sdir, name, sub)
    if cmd == "model":
        toks = (args or "").split()
        if not toks or toks[0].lower() == "list":
            opts = MODELS.get(backend, ["default"])
            cur_eff = eff_model(backend, a.get("model", "default"))
            lines = [f'{"*" if eff_model(backend, o) == cur_eff else " "} {o}' for o in opts]
            return (True, f"models for {name} [{backend}] (* current):\n" + "\n".join(lines)
                + "\nset: /model <name> (custom strings allowed)")
        target = toks[0][:120]
        if backend == "opencode" and target in ("default", ""):
            target = OPENCODE_MODEL_DEFAULT
        ok, message = update_agent_settings(sdir, name, {"model": target})
        if not ok: return (False, message)
        _event(sdir, "model", name, model=target)
        known = " (custom)" if target not in MODELS.get(backend, ["default"]) else ""
        return (True, f"model -> {target}{known} for {name} [{backend}].")
    if cmd == "handoff":
        tgt = (args or "").split()[0].lower() if (args or "").split() else ""
        return native_handoff_text(sdir, name, tgt)
    if cmd == "profile":
        toks = (args or "").split()
        sub = toks[0].lower() if toks else "list"
        if sub in ("list", "status"):
            profs = profiles_list(sdir)
            cur = (a.get("profile") or "")
            lines = [f'{"*" if n == cur else " "} {n}' for n in sorted(profs)] or ["(none)"]
            users = f" (this agent: {cur or 'none'})"
            return (True, f"profiles for {name}{users}:\n" + "\n".join(lines)
                + "\nshow: /profile show <name>   select: /profile use <name>|--none")
        if sub == "show":
            tgt = toks[1] if len(toks) > 1 else ""
            if not tgt: return (False, "usage: /profile show <name>")
            v = profile_validate(sdir, tgt)
            if v.get("errors") and not profiles_list(sdir).get(tgt):
                return (False, f"no such profile: {tgt}")
            eff = profile_effective(sdir, tgt)
            if "error" in eff: return (False, eff["error"])
            lines = [f"profile {tgt} valid={v.get('ok')}"]
            if v.get("errors"): lines += [f"errors: {v['errors']}"]
            if v.get("warnings"): lines += [f"warnings: {v['warnings']}"]
            combo, seen = [], set()
            for u in (v.get("unsupported", []) + eff.get("unsupported", [])):
                if u not in seen: seen.add(u); combo.append(u)
            if combo: lines += ["unsupported:"] + [f"  - {u}" for u in combo[:10]]
            lines += [f"effective: {', '.join(sorted(eff.get('files', {}))) or '(none)'}"]
            return (True, "\n".join(lines))
        if sub in ("use", "set", "select"):
            tgt = toks[1] if len(toks) > 1 else ""
            if tgt in ("--none", "none", "") and len(toks) <= 1:
                pass  # bare `/profile use` without name -> usage below
            if not tgt: return (False, "usage: /profile use <name>|--none")
            if tgt == "--none": tgt = ""
            r = profile_set_agent(sdir, name, tgt)
            if "error" in r: return (False, r["error"])
            return (True, f"{name} profile -> {tgt or '(none)'} sid_cleared={r['sid_cleared']}")
        if sub in ("validate",):
            tgt = toks[1] if len(toks) > 1 else ""
            if not tgt: return (False, "usage: /profile validate <name>")
            v = profile_validate(sdir, tgt)
            if v.get("errors") and not profiles_list(sdir).get(tgt):
                return (False, f"no such profile: {tgt}")
            return (v.get("ok", False), f"profile {tgt} valid={v.get('ok')} errors={v.get('errors')} warnings={v.get('warnings')}")
        if sub in ("help", ""):
            return (True, slash_help_text(sdir, name))
        return (False, f"unknown /profile {sub}. usage: /profile list|show <n>|use <n>|--none|validate <n>")
    if cmd in SLASH_UI_ONLY:
        # Interactive-only command typed headless (the TUI composer
        # intercepts these and opens the screen instead): honest pointer,
        # never model prose, never a fake local execution.
        return (False, f"/{cmd} is interactive — open the TUI composer "
            f"(ag tui) and type /{cmd} there. {slash_help_text(sdir, name)}")
    return (False, f"unknown command /{cmd} (ag runs it locally; it was NOT sent to the model). "
        f"Backend-native slash commands only run inside the backend TUI — real route: "
        f"/handoff (or H key, or: ag handoff {name}) to open it, then type /{cmd} there. "
        f"{slash_help_text(sdir, name)}")

