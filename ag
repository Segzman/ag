    def open_palette(ret):
        """Searchable command palette. ret=(screen,mode) restored on cancel;
        drafts (inp/home_inp) are never cleared by open or cancel."""
        nonlocal mode, pal_query, pal_idx, pal_off, pal_items, pal_return
