        "unsupported": eff.get("unsupported", []),
        "diagnostics": eff.get("diagnostics", {})}

def profile_set_agent(sdir, agent, name):
    rows = load_agents(sdir)
    hit = [r for r in rows if r.get("name") == agent]
    if not hit: return {"error": f"no such agent: {agent}"}
    if agent_busy(sdir, agent):
        return {"error": f"{agent} is busy (turn or handoff running); retry when idle."}
    if name:
        profs = load_profiles(sdir)
        if name not in profs: return {"error": f"no such profile: {name}"}
        v = validate_profile(name, profs[name])
        if not v["ok"]: return {"error": "; ".join(v["errors"])}
    hit[0]["profile"] = name or ""
    save_agents(sdir, rows)
    cleared = clear_agent_sid(sdir, agent)
    return {"ok": True, "agent": agent, "profile": name or "",
        "sid_cleared": cleared}

def do_harness_profile(a):
    sdir = state_dir(a.dir); ensure_state(sdir)
    sub = getattr(a, "psub", None) or "list"
    profs = load_profiles(sdir)
    if sub == "list":
        if getattr(a, "json", False):
            return emit(a, "harness", {"profiles": profs,
                "agents": {r["name"]: r.get("profile", "") for r in load_agents(sdir)}})
        rows = [f'{n:16} {str((p.get("mcp") or "-"))[:30]:30} '
            f'{str((p.get("skills") or "-"))[:30]:30} '
            f'{str((p.get("instructions") or "-"))[:30]}'
            for n, p in sorted(profs.items())] or ["(none)"]
        amap = " ".join(f'{r["name"]}={r.get("profile") or "-"}'
            for r in load_agents(sdir))
        return emit(a, "harness", {"_text": "profiles:\n" + "\n".join(rows)
            + f"\nagents: {amap or '(none)'}"})
    if sub == "show":
        name = getattr(a, "pname", "") or ""
        if name not in profs:
            return emit(a, "harness", error=f"no such profile: {name}")
        v = validate_profile(name, profs[name])
        eff = ensure_effective_profile(sdir, name)
        # redact env values: counts/names only
        red = dict(profs[name])
        data = {"profile": name, "sources": red, "valid": v,
            "effective": {k: v2 for k, v2 in eff.items() if k != "error"}}
        if getattr(a, "json", False): return emit(a, "harness", data)
        t = [f"profile {name} valid={v['ok']}"]
        t += [f"sources: {json.dumps(red)[:300]}"]
        t += [f"errors: {v['errors']}"] if v["errors"] else []
        t += [f"warnings: {v['warnings']}"] if v["warnings"] else []
        seen, combo = set(), []
        for u in (v.get("unsupported", []) + eff.get("unsupported", [])):
            if u not in seen: seen.add(u); combo.append(u)
        t += [f"unsupported:"] + [f"  - {u}" for u in combo[:10]]
        t += [f"effective: {json.dumps(eff.get('files', {}), indent=0)[:500]}"]
        return emit(a, "harness", {"_text": "\n".join(t), **data})
    if sub == "add":
        name = getattr(a, "pname", "") or ""
        if not PROFILE_NAME_RE.match(name or ""):
            return emit(a, "harness", error="bad name",
                hint="use [A-Za-z0-9][A-Za-z0-9_.-]{0,63}")
        if name in profs and not getattr(a, "force", False):
            return emit(a, "harness", error=f"exists: {name}",
                hint="retry with --force to overwrite")
        mem = getattr(a, "memory", None) or []
        prof = {"instructions": getattr(a, "instructions", None) or "",
            "skills": getattr(a, "skills", None) or "",
            "mcp": getattr(a, "mcp", None) or "",
            "memory": mem,
            "opencode_config": getattr(a, "opencode_config", None) or "",
            "codex_config": getattr(a, "codex_config", None) or "",
            "claude_settings": getattr(a, "claude_settings", None) or "",
            "notes": getattr(a, "pnotes", None) or ""}
        _penv, _perr = env_parse(getattr(a, "env", None))
        if _perr: return emit(a, "harness", error=_perr)
        if _penv: prof["env"] = _penv
        if getattr(a, "env_unset", None): prof["env_unset"] = list(a.env_unset)
        prof = {k: v for k, v in prof.items() if v not in ("", [], None)}
        v = validate_profile(name, prof)
        if not v["ok"]:
            return emit(a, "harness", error="; ".join(v["errors"]))
        profs[name] = prof
        save_profiles(sdir, profs)
        eff = ensure_effective_profile(sdir, name)
        data = {"profile": name, "sources": prof, "warnings": v["warnings"],
            "unsupported": v.get("unsupported", []) + eff.get("unsupported", [])}
        if getattr(a, "json", False): return emit(a, "harness", data)
        w = f' (+{len(v["warnings"])} warnings)' if v["warnings"] else ""
        u = f' ({len(data["unsupported"])} unsupported notes)' if data["unsupported"] else ""
        return emit(a, "harness", {"_text": f"added profile {name}{w}{u}", **data})
    if sub == "rm":
        name = getattr(a, "pname", "") or ""
        if name not in profs:
            return emit(a, "harness", error=f"no such profile: {name}")
        users = [r["name"] for r in load_agents(sdir) if r.get("profile") == name]
        if users and not getattr(a, "force", False):
            return emit(a, "harness", error=f"in use by: {','.join(users)}",
                hint="retry with --force or harness profile set <agent> --none")
        del profs[name]
        save_profiles(sdir, profs)
        return emit(a, "harness", {"_text": f"removed profile {name}"})
    if sub == "validate":
        name = getattr(a, "pname", "") or ""
        if name not in profs:
            return emit(a, "harness", error=f"no such profile: {name}")
        v = validate_profile(name, profs[name])
        if getattr(a, "json", False): return emit(a, "harness", v)
        t = [f"profile {name} valid={v['ok']}"] + v["errors"] + v["warnings"] \
            + [f"unsupported: {u}" for u in v["unsupported"][:10]]
        return emit(a, "harness", {"_text": "\n".join(t) or "valid", **v})
    if sub == "set":
        agent = getattr(a, "agent", "") or ""
        want = getattr(a, "profile", "") or ""
        if getattr(a, "none", False): want = ""
        r = profile_set_agent(sdir, agent, want)
        if "error" in r:
            return emit(a, "harness", error=r["error"], hint="ag agents list")
        if getattr(a, "json", False): return emit(a, "harness", r)
        return emit(a, "harness", {"_text":
            f'{agent} profile -> {want or "(none)"} sid_cleared={r["sid_cleared"]}', **r})
    if sub == "status":
        rows = []
        for n, p in sorted(profs.items()):
            v = validate_profile(n, p)
            users = [r["name"] for r in load_agents(sdir) if r.get("profile") == n]
            rows.append({"profile": n, "valid": v["ok"],
                "errors": v["errors"], "unsupported_count":
                len(v.get("unsupported", [])), "agents": users})
        if getattr(a, "json", False):
            return emit(a, "harness", {"status": rows})
        txt = "\n".join(f'{r["profile"]:16} valid={r["valid"]} '
            f'unsup={r["unsupported_count"]} agents={",".join(r["agents"]) or "-"}'
            for r in rows) or "(none)"
        return emit(a, "harness", {"_text": txt})
    return emit(a, "harness", error=f"unknown profile sub: {sub}",
        hint="list|show|add|rm|validate|set|status")

