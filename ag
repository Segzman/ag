def compact_scope_settings(sdir, scope, agent_name=""):
    """(settings, role, source) for a scope id. Pure of writes.
    scope: 'orchestrator' | 'sub' | 'agent' (agent needs agent_name)."""
    if scope in ("orchestrator", "sub"):
        try:
            cfg = compact_load_config(sdir)
        except Exception:
            cfg = {"defaults": {}, "agents": {}}
        d = (cfg.get("defaults") or {}).get(scope, {})
        if not d:
            import copy as _cp
            d = dict(COMPACT_FACTORY.get(scope, {}))
        return dict(d), scope, f"role:{scope}"
