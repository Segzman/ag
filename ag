#   profile_validate(sdir, name) -> validate_profile(...)
#   profile_effective(sdir, name) -> ensure_effective_profile(...) (redacted summary)
#   profile_set_agent(sdir, agent, name|"") -> {ok, sid_cleared} (workdir/role/persona untouched)
def profiles_list(sdir): return load_profiles(sdir)

def profile_validate(sdir, name):
