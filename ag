    def handle_palette(ch):
        """Palette keys: typing filters, arrows move, Enter runs, Esc cancels
        back to pal_return with drafts intact. Returns 'quit' to exit TUI."""
        nonlocal pal_query, pal_idx, pal_off, mode, screen
        import curses as _cu
        matches = palette_filter(pal_items, pal_query)
        if ch in (10,13):
            if matches:
                act = pal_items[matches[min(pal_idx, len(matches)-1)]]["act"]
                return run_palette(act)
            return None
        if ch == 27:
            rs, rm = pal_return
            screen = rs; mode = rm; return None
        if ch in (_cu.KEY_UP,):
            pal_idx = max(0, pal_idx-1); return None
        if ch in (_cu.KEY_DOWN, 9):
            pal_idx = pal_idx+1; return None
        if ch in (_cu.KEY_PPAGE,):
            pal_idx = max(0, pal_idx-5); return None
        if ch in (_cu.KEY_NPAGE,):
            pal_idx = pal_idx+5; return None
        if ch in (_cu.KEY_BACKSPACE, 127, 8):
            pal_query = pal_query[:-1]; pal_idx = 0; return None
        if isinstance(ch, str):
            try: printable = ch.isprintable()
            except Exception: printable = True
            if printable and len(ch)==1: pal_query += ch; pal_idx = 0
            return None
        if isinstance(ch, int) and ch >= 256: return None  # keys never text
        if 32 <= ch <= 126:
            pal_query += chr(ch); pal_idx = 0
        elif 128 <= ch <= 0x10FFFF:
            try:
                if chr(ch).isprintable(): pal_query += chr(ch); pal_idx = 0
            except Exception: pass
        return None
