                assert do_kill(mk(sess=s2,force=True))==0
                t0=_t.time()
                while _sstatus(sroot/s2).get("running") and _t.time()-t0<8: _t.sleep(0.2)
                assert not _sstatus(sroot/s2).get("running")
            finally:
                try: do_kill(mk(sess=s2,force=True))
                except Exception: pass
            assert (td/"events.jsonl").exists()
    print(f"selfcheck ok ({td})")
