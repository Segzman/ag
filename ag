    def handle_typing(ch):
        """Shared composer keys: chat/home composers (typing-first, every
        ordinary letter is text) + capture flows (new/delegate/model share
        flow_inp so message drafts survive). Returns True (always consumes).
        A leading / in a composer opens the slash popup (handled first)."""
        nonlocal inp, home_inp, mode, msg, scroll, active, pending_name, pending_dagent, screen
        nonlocal cmp_inp, cmp_err, cmp_edit, cmp_agent
        nonlocal cmp_msg, cmp_view, cmp_fresh
        nonlocal flow_inp, slash_open, slash_sup, slash_idx
        if slash_open and mode in ("input", "homeinput"):
            return handle_slashkey(ch)
        if mode == "compactedit":
            # dedicated editor buffer: chat/home drafts (inp/home_inp) stay
            # intact while editing a compaction value.
            if ch in (10, 13):
                raw = cmp_inp
                tgt = cmp_edit[0] if cmp_edit else ""
                key = cmp_edit[1] if cmp_edit else ""
                ok, out = compact_apply_edit(sdir, tgt, key, raw)
                cmp_inp, cmp_edit = "", None
                if ok:
                    cmp_err, cmp_msg, msg, mode = "", out, out, "compact"
                else:
                    cmp_err, mode = out, "compact"  # inline error, no save
                return True
            if ch == 27:
                cmp_inp, cmp_edit, cmp_err, mode = "", None, "", "compact"
                return True
            if ch in (curses.KEY_BACKSPACE, 127, 8):
                cmp_fresh = False
                cmp_inp = cmp_inp[:-1]
                return True
            if isinstance(ch, str):
                try: printable = ch.isprintable()
                except Exception: printable = True
                if printable and len(ch) == 1:
                    if cmp_fresh:
                        cmp_inp, cmp_fresh = ch, False
                    else:
                        cmp_inp += ch
                return True
            if isinstance(ch, int) and ch >= 256: return True
            if 32 <= ch <= 126:
                if cmp_fresh:
                    cmp_inp, cmp_fresh = chr(ch), False
                else:
                    cmp_inp += chr(ch)
            elif 128 <= ch <= 0x10FFFF:
                try:
                    if chr(ch).isprintable(): cmp_inp += chr(ch)
                except Exception: pass
            return True
        if ch in (10,13):
            if mode=="input":
                t = inp.strip()
                if t.startswith("!") and len(t)>1: run_shell(t[1:].strip())
                elif t:
                    if send_active(t) is False:
                        return True  # busy: visible error, draft preserved
                if mode=="input":
                    mode = base_mode()
                inp = ""
                slash_sync()
                return True
            elif mode=="homeinput":
                t = home_inp.strip()
                if t:
                    # home prompt submits to the selected agent, then opens chat
                    flat = home_flat_agents(group_agents_by_workdir(chats, tui_cwd))
                    sync_active_to_home(flat)
                    if t.startswith("!") and len(t)>1: run_shell(t[1:].strip())
                    else:
                        if send_active(t) is False:
                            return True  # busy: visible error, draft kept
                    was_composing = (mode == "homeinput")
                    home_inp = ""
                    slash_sync()
                    if was_composing:
                        screen = "chat"; mode = "input"; scroll = 0
                    return True
                mode = "normal"; return True
            elif mode=="setmodel" and chats:
                chats[active]["model"] = flow_inp.strip() or "default"
                save_agents(sdir,chats); msg = f'model -> {chats[active]["model"]}'
            elif mode=="newname":
                pending_name = flow_inp.strip()
                if pending_name: mode = "newbackend"; flow_inp = "opencode"; return True
                flow_inp = ""; mode = base_mode(); return True
            elif mode=="newbackend":
                b = flow_inp.strip() or "opencode"
                if b in MODELS:
                    mod = OPENCODE_MODEL_DEFAULT if b=="opencode" else "default"
                    chats.append({"name":pending_name,"backend":b,"model":mod,"dir":".","role":"sub"})
                    save_agents(sdir,chats)
                    logs[pending_name] = []; stream[pending_name] = ""
                    active = len(chats)-1; msg = f"added {pending_name} ({b})"
                    # land in the new agent's chat, wherever we came from
                    screen = "chat"; flow_inp = ""; mode = "input"; return True
                msg = f"unknown backend (claude|opencode|gemini|codex|cursor)"
                flow_inp = ""; mode = base_mode(); return True
            elif mode=="dagent":
                pending_dagent = flow_inp.strip()
                if pending_dagent and any(c["name"]==pending_dagent for c in chats):
                    mode = "dtext"; flow_inp = ""; return True
                msg = "no such agent"; flow_inp = ""; mode = base_mode(); return True
            elif mode=="dtext":
                if flow_inp.strip():
                    tgt = pending_dagent
                    dthr = threading.Thread(target=delegate_task,args=(sdir,tgt,flow_inp.strip(),onevent),daemon=True)
                    dthr.start(); msg = f"delegated to {tgt}"
                else: msg = "empty task — type the delegation first"
                flow_inp = ""; mode = base_mode(); return True
            inp = ""; mode = base_mode(); return True
        if ch==27:
            if mode=="homeinput":
                mode = "normal"; slash_open = False; return True  # keep draft, select
            if mode=="input":
                # back home with the draft kept; selection follows the target
                flat = home_flat_agents(group_agents_by_workdir(chats, tui_cwd))
                sync_home_to_active(flat)
                screen = "home"; mode = "normal"; slash_open = False
                return True
            if mode in ("setmodel", "newname", "newbackend", "dagent", "dtext"):
                flow_inp = ""; mode = "input"; return True  # message draft kept
            inp = ""; mode = "normal"; return True
        if ch in (curses.KEY_BACKSPACE,127,8):
            if mode=="homeinput": home_inp = home_inp[:-1]
            elif mode in ("setmodel", "newname", "newbackend", "dagent", "dtext"):
                flow_inp = flow_inp[:-1]
            else: inp = inp[:-1]
            slash_sync()
            return True
        if isinstance(ch, str):
            # non-ASCII text via get_wch (str stays distinct from KEY_* ints)
            try: printable = ch.isprintable()
            except Exception: printable = True
            if printable:
                if mode=="homeinput": home_inp += ch
                elif mode in ("setmodel", "newname", "newbackend", "dagent", "dtext"):
                    flow_inp += ch
                else: inp += ch
                slash_sync()
            return True
        sc = _tui_special_scroll(ch)
        if sc is not None:
            scroll = max(0, scroll+sc); return True
        if isinstance(ch, int) and ch >= 256: return True  # KEY_RESIZE etc never text
        if 32<=ch<=126:
            if mode=="homeinput": home_inp += chr(ch)
            elif mode in ("setmodel", "newname", "newbackend", "dagent", "dtext"):
                flow_inp += chr(ch)
            else: inp += chr(ch)
            slash_sync()
        elif 128<=ch<=0x10FFFF:
            try:
                if chr(ch).isprintable():
                    if mode=="homeinput": home_inp += chr(ch)
                    elif mode in ("setmodel", "newname", "newbackend", "dagent", "dtext"):
