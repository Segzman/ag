# ---- models cache, job routing, `ag setup` (skills + CLAUDE.md routing block) ----
# Paths: AG_HOME (default ~) roots ~/.claude, ~/.config/opencode, ~/.codex, ~/AGENTS.md;
# AG_CONFIG_HOME (default $AG_HOME/.config/ag) holds routing.json; AG_CACHE_HOME
# (default $AG_HOME/.cache/ag) holds models.json; AG_SKILLS_DIR overrides the
# skill template dir (default <ag dir>/skills). Tests point all of them at a tmp dir.
MODEL_BACKENDS = ("claude", "opencode", "codex", "cursor", "gemini")
MODELS_TTL_S = 24 * 3600
MODELS_STATIC = {
    "claude": (["default", "fable", "opus", "sonnet", "haiku"], "static (claude CLI has no list command)"),
    "gemini": (["default", "gemini-2.5-pro", "gemini-2.5-flash"], "static"),
