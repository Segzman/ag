# ag-level default model for OpenCode: "default"/missing resolves to this ID
# everywhere OpenCode runs through ag (headless argv, handoff, new agents,
# switches, pickers). Explicit custom models always win; other backends untouched.
OPENCODE_MODEL_DEFAULT = "opencode/muse-spark-1.3-contributor-free"
MODELS = {
    "claude": ["default","sonnet","opus","haiku"],
    "opencode": [OPENCODE_MODEL_DEFAULT],
    "gemini": ["default","gemini-2.5-pro","gemini-2.5-flash"],
    "codex": ["default"],
    "cursor": ["default","sonnet-4","sonnet-4-thinking","gpt-5"],
    "echo": ["default"],
}
def eff_model(backend, model):
    """Effective model string for argv/display. Pure.
    OpenCode default/missing resolves to the ag-level default (Muse Spark);
    other backends keep '' (= backend default, no -m flag). Explicit custom
    strings pass through untouched on every backend."""
    m = (model or "").strip()
    if m in ("", "default"):
        return OPENCODE_MODEL_DEFAULT if backend == "opencode" else ""
    return m
PROBES = {"claude":["claude","--version"],"opencode":["opencode","--version"],
    "gemini":["gemini","--version"],"codex":["codex","--version"],"echo":["printf","ok"]}

def cycle_model(backend, cur):
    opts = MODELS.get(backend,["default"])
    return opts[(opts.index(cur)+1)%len(opts)] if cur in opts else opts[0]

def _model_opts(backend): return MODELS.get(backend,["default"])+["[custom…]"]

def _model_idx(c):
    opts = _model_opts(c["backend"])
    try: return opts.index(c.get("model","default"))
    except ValueError: return 0

