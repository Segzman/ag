ROUTING_PRESETS = {"cost-first": _ROUTE_COST,
    "balanced": {**_ROUTE_COST, "review": _rj("sonnet", "claude", "sonnet")},
    "quality-first": {"mechanical": _rj("sonnet", "claude", "sonnet"), "implement": _rj("opus", "claude", "opus"),
        **{j: _rj("fable", "claude", "fable") for j in ("review", "debug", "plan", "hardest")}}}
ROUTE_FALLBACK = {"backend": "opencode", "model": OPENCODE_MODEL_DEFAULT}
