                    "status":"pending","ts":now_iso()})
                (sdir/"approvals.json").write_text(json.dumps(approvals, indent=2))
            show(f"blocked: {reason} (press a to approve, then re-run !cmd)")
            return
        try:
            p = subprocess.run(cmd,shell=True,capture_output=True,text=True,timeout=60,env=dict(os.environ))
            out = ((p.stdout or "")+(p.stderr or "")).strip() or f"(exit {p.returncode})"
        except Exception as e: out = f"error: {e}"
