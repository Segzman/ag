    "implement": "implement a clear spec / plan", "review": "code review, verification",
    "debug": "debugging, failing tests, root cause", "plan": "planning, design, architecture",
    "hardest": "ambiguous, high-stakes, security-sensitive"}
def _rj(c, b, m): return {"claude": c, "ag": {"backend": b, "model": m}}
_ROUTE_COST = {"mechanical": _rj("haiku", "opencode", OPENCODE_MODEL_DEFAULT),
    "implement": _rj("sonnet", "claude", "sonnet"), "review": _rj("opus", "claude", "opus"),
