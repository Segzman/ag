def _ag_home(): return Path(os.environ.get("AG_HOME") or Path.home()).expanduser()
def ag_config_home(): return Path(os.environ.get("AG_CONFIG_HOME") or _ag_home()/".config"/"ag").expanduser()
def ag_cache_home(): return Path(os.environ.get("AG_CACHE_HOME") or _ag_home()/".cache"/"ag").expanduser()
def models_cache_path(): return ag_cache_home()/"models.json"
def _read_or_empty(p):
    try: return Path(p).read_text()
    except OSError: return ""
def _json_or_empty(p):
    try: d = json.loads(Path(p).read_text())
    except (OSError, ValueError): return {}
    return d if isinstance(d, dict) else {}
def _put_file(p, text):
    p = Path(p); p.parent.mkdir(parents=True, exist_ok=True); _atomic_write(p, text)
def _age_s(iso):
    try: return max(0.0, time.time() - datetime.fromisoformat(iso).timestamp())
    except (TypeError, ValueError): return float("inf")
def _ago(iso):
    s = _age_s(iso)
    if s == float("inf"): return "never"
    s = int(s)
    return f"{s}s ago" if s < 60 else f"{s//60}m ago" if s < 3600 else f"{s//3600}h ago" if s < 86400 else f"{s//86400}d ago"

def parse_model_lines(out):
    """ids from `opencode models` / `agent --list-models` stdout (ANSI, spinner, headers stripped). Pure."""
    ids = []
    for ln in ANSI.sub("", out or "").replace("\r", "\n").splitlines():
        ln = ln.strip()
        low = ln.lower()
        if not ln or low.startswith(("loading", "available models", "tip:", "no models available")): continue
        tok = ln.split(" - ")[0].split()
        if tok and tok[0] not in ids: ids.append(tok[0])
    return ids

def _models_fetch(b):
    """(ids, source, error) for one backend; error == '' on success."""
    if b in MODELS_STATIC:
        ids, src = MODELS_STATIC[b]
        return list(ids), src, ""
    if b == "codex":
        p = _ag_home()/".codex"/"models_cache.json"
        d = _json_or_empty(p)
        if not d: return [], str(p), "missing or unreadable (run codex once to create it)"
        return [m["slug"] for m in d.get("models") or [] if isinstance(m, dict)
            and m.get("visibility") == "list" and m.get("slug")], str(p), ""
    argv = [_opencode_bin(), "models"] if b == "opencode" else [_cursor_bin(), "--list-models"]
    src = " ".join([Path(argv[0]).name] + argv[1:])
    for attempt in (0, 1):  # opencode: serialized (one at a time), one retry on sqlite lock
        try: p = subprocess.run(argv, capture_output=True, text=True, timeout=90, stdin=subprocess.DEVNULL)
        except FileNotFoundError: return [], src, "not installed"
        except Exception as e: return [], src, str(e)[:200]
        both = (p.stdout or "") + (p.stderr or "")
        if attempt == 0 and "database is locked" in both: time.sleep(1); continue
        break
    if "no models available" in both.lower(): return [], src, ""
    if p.returncode != 0: return [], src, ANSI.sub("", both).strip()[-200:] or f"exit {p.returncode}"
    return parse_model_lines(p.stdout), src, ""

def _models_read():
    d = _json_or_empty(models_cache_path())
    if not isinstance(d.get("backends"), dict): d["backends"] = {}
    d.setdefault("fetched_at", "")
    return d

def models_refresh(backends=MODEL_BACKENDS, on_progress=None):
    """Re-fetch backends; a failed source keeps its last good list + records error."""
    cache = _models_read()
    for b in backends:
        ids, src, err = _models_fetch(b)
        prev = cache["backends"].get(b) or {}
        ent = {"models": prev.get("models", []) if err else ids, "source": src, "error": err,
            "fetched_at": prev.get("fetched_at", "") if err else now_iso(), "checked_at": now_iso()}
        cache["backends"][b] = ent
        if on_progress: on_progress(b, ent)
    cache["fetched_at"] = now_iso()
    try: _put_file(models_cache_path(), json.dumps(cache, indent=1) + "\n")
    except OSError: pass
    return cache

def models_load(backends=MODEL_BACKENDS, refresh=False, on_progress=None):
    """Cached lists; stale (> TTL) or missing backends refresh on read, --refresh forces."""
    cache = _models_read()
    stale = [b for b in backends if refresh or _age_s((cache["backends"].get(b) or {}).get("checked_at")) > MODELS_TTL_S]
    return models_refresh(stale, on_progress) if stale else cache

def model_choices(backend):
    """Static MODELS first (default stays first), then cached ids. Read-only: never spawns a refresh."""
    base = list(MODELS.get(backend, ["default"]))
    cached = (_models_read()["backends"].get(backend) or {}).get("models") or []
    return base + [m for m in cached if isinstance(m, str) and m and m not in base]

def do_models(a):
    bs = [a.backend] if a.backend else list(MODEL_BACKENDS)
    cache = models_load(bs, refresh=a.refresh)
    data = {"fetched_at": cache.get("fetched_at", ""), "path": str(models_cache_path()),
        "backends": {b: cache["backends"].get(b, {}) for b in bs}}
    if getattr(a, "json", False): return emit(a, "models", data)
    out = []
    for b in bs:
        e = data["backends"][b]; ids = e.get("models") or []
        out.append(f'{b} ({len(ids)}, {e.get("source", "")}, fetched {_ago(e.get("fetched_at"))})')
        if e.get("error"): out.append(f'  error: {e["error"]}')
        out += [f"  {m}" for m in ids[:MODELS_SHOW]]
        if len(ids) > MODELS_SHOW: out.append(f"  … {len(ids)-MODELS_SHOW} more (--json for all)")
    return emit(a, "models", {**data, "_text": "\n".join(out)})

def project_root(cwd=None):
    cwd = Path(cwd or Path.cwd())
    p = _git(cwd, "rev-parse", "--show-toplevel")
    return Path(p.stdout.strip()) if p.returncode == 0 and p.stdout.strip() else cwd

def routing_paths(proj=None):
    return ag_config_home()/"routing.json", Path(proj or project_root())/".agent"/"routing.json"

def routing_effective(glob=None, proj=None):
    """Per-job effective routing: preset < global < project (per field). Pure."""
    glob, proj = glob or {}, proj or {}
    base = ROUTING_PRESETS.get(proj.get("preset") or glob.get("preset") or "cost-first", _ROUTE_COST)
    out = {}
    for j in JOB_KEYS:
        e = {"claude": base[j]["claude"], "ag": dict(base[j]["ag"]),
            "source": {"claude": "preset-default", "ag": "preset-default"}}
        for src, d in (("global", glob), ("project", proj)):
            je = (d.get("jobs") or {}).get(j)
            if not isinstance(je, dict): continue
            if je.get("claude"): e["claude"] = str(je["claude"]); e["source"]["claude"] = src
            ga = je.get("ag")
            if isinstance(ga, dict) and ga.get("backend"):
                e["ag"] = {"backend": str(ga["backend"]), "model": str(ga.get("model") or "default")}
                e["source"]["ag"] = src
        if not e["ag"].get("backend"): e["ag"] = dict(ROUTE_FALLBACK)
        out[j] = e
    return out

def routing_now(cwd=None):
    gp, pp = routing_paths(project_root(cwd))
    return routing_effective(_json_or_empty(gp), _json_or_empty(pp)), gp, pp

def _route_model(ag_): return eff_model(ag_["backend"], ag_["model"]) or ag_["model"]

# per-backend defaults: routing.json "backends": {b: {enabled, model, mode, plan}}; project overlays global per field
BACKEND_TABS = ("claude", "opencode", "codex", "gemini", "cursor")
BK_DEFAULT = {"enabled": True, "model": "", "mode": "", "plan": False}
_BOOL = {"true": True, "yes": True, "on": True, "1": True, "false": False, "no": False, "off": False, "0": False}
def _bk_clean(d):
    """Valid fields of one routing.json backends entry ('default' model -> ''). Pure."""
    if not isinstance(d, dict): return {}
    out = {k: d[k] for k in ("enabled", "plan") if isinstance(d.get(k), bool)}
    if isinstance(d.get("model"), str): out["model"] = "" if d["model"].strip() in ("", "default") else d["model"].strip()
    if d.get("mode") in ("",) + MODES: out["mode"] = d["mode"]
    return out
def backends_effective(glob=None, proj=None):
    """{b: {enabled, model, mode, plan, source}}: default < global < project, per field. Pure."""
    out = {}
    for b in BACKEND_TABS:
        e, src = dict(BK_DEFAULT), "default"
        for s, d in (("global", glob or {}), ("project", proj or {})):
            bd = d.get("backends") if isinstance(d.get("backends"), dict) else {}
            c = _bk_clean(bd.get(b))
            if c: e.update(c); src = s
        out[b] = {**e, "source": src}
    return out
def backends_now(cwd=None):
    gp, pp = routing_paths(project_root(cwd))
    return backends_effective(_json_or_empty(gp), _json_or_empty(pp))
def routing_disabled(eff, bk):
    """[(job, backend)] routed to a disabled backend. Pure."""
    return [(j, e["ag"]["backend"]) for j, e in eff.items() if not (bk.get(e["ag"]["backend"]) or BK_DEFAULT)["enabled"]]
def backends_line(bk):
    """'opencode: m (mode edits) · gemini: off' — compact skill line. Pure."""
    def one(b, e):
        if not e["enabled"]: return f"{b}: off"
        x = ", ".join(([f'mode {e["mode"]}'] if e["mode"] else []) + (["plan"] if e["plan"] else []))
        return f'{b}: {eff_model(b, e["model"]) or "default"}' + (f" ({x})" if x else "")
    return " · ".join(one(b, bk[b]) for b in BACKEND_TABS if b in bk)
def parse_backend_sets(items):
    """Split --set items: backend.B.FIELD=V -> (other items, {b: {field: v}}). Raises ValueError. Pure."""
    rest, out = [], {}
    for it in items or []:
        if not it.startswith("backend."): rest.append(it); continue
        k, eq, v = it.partition("=")
        _, b, f = (k.strip().split(".", 2) + ["", ""])[:3]
        v = v.strip()
        bad = f"bad --set {it!r}: want backend.BACKEND.(enabled|model|mode|plan)=VALUE, BACKEND in {','.join(BACKEND_TABS)}"
        if not eq or b not in BACKEND_TABS or f not in BK_DEFAULT: raise ValueError(bad)
        if f in ("enabled", "plan"):
            if v.lower() not in _BOOL: raise ValueError(f"bad --set {it!r}: {f} wants true|false")
            val = _BOOL[v.lower()]
            if f == "plan" and val and not CAPS[b]["plan"]: raise ValueError(f"bad --set {it!r}: {b} has no plan mode")
        elif f == "mode":
            val = "" if v in ("", "unset") else v
            if val and val not in CAPS[b]["modes"]: raise ValueError(f"bad --set {it!r}: {b} modes are {'|'.join(CAPS[b]['modes'])} (or unset)")
        else: val = "" if v in ("", "default") else v
        out.setdefault(b, {})[f] = val
    return rest, out

def routing_block(eff, bk=None):
    """Markdown routing block (spec §5); bk adds the compact backend-defaults line (skills). Pure."""
    rows = [f'| {j} — {JOB_DESC[j]} | {eff[j]["claude"]} | {eff[j]["ag"]["backend"]} / {_route_model(eff[j]["ag"])} |'
        for j in JOB_KEYS]
    bl = ["", f"Backend defaults (`ag agents add NAME --backend B` without --model/--mode): {backends_line(bk)}"] if bk else []
    return "\n".join(["## Model routing (generated by `ag setup` — change it with `ag setup`, not by hand)", "",
        "Default to the cheapest model that can do the job; escalate only when it gets stuck or the job turns out to need judgment.", "",
        "| Job | Claude subagent (`model:`) | ag agent (backend / model) |", "|---|---|---|", *rows, *bl, "",
        "Unsure which job it is? Start one tier lower; escalate on failure. Effective config: `ag route`."])

def routing_md_insert(text, block, append=True):
    """Replace the marked block (markers kept), else append it; append=False -> None when no markers. Pure."""
    s, e = ROUTING_MARKERS
    marked = f"{s}\n{block}\n{e}"
    i = text.find(s); j = text.find(e, i + len(s)) if i >= 0 else -1
    if i >= 0 and j >= 0: return text[:i] + marked + text[j + len(e):]
    if not append: return None
    if not text: return marked + "\n"
    return text + ("" if text.endswith("\n\n") else "\n" if text.endswith("\n") else "\n\n") + marked + "\n"

def render_skill(tpl, routing_md, scope):
    """Substitute {{AG}} {{ROUTING}} {{SCOPE}}; any other {{...}} stays. Pure."""
    return tpl.replace("{{AG}}", ag_script_path()).replace("{{SCOPE}}", scope).replace("{{ROUTING}}", routing_md)

def skill_templates_dir(): return Path(os.environ.get("AG_SKILLS_DIR") or Path(ag_script_path()).parent/"skills")

def harness_skills_dir(harness, scope, proj):
    if scope == "global":
        h = _ag_home()
        return {"claude": h/".claude", "opencode": h/".config"/"opencode", "codex": h/".codex"}[harness]/"skills"
    return Path(proj)/{"claude": ".claude", "opencode": ".opencode", "codex": ".agents"}[harness]/"skills"

def detect_harnesses():
    h = _ag_home()
    dirs = {"claude": h/".claude", "opencode": h/".config"/"opencode", "codex": h/".codex"}
    return [x for x in SETUP_HARNESSES if shutil.which(x) or dirs[x].is_dir()]

def parse_route_sets(items):
    """--set JOB=claude:ALIAS | JOB=ag:BACKEND/MODEL -> {job: {claude|ag}}. Raises ValueError. Pure."""
    out = {}
    for it in items or []:
        job, eq, rest = it.partition("=")
        kind, colon, val = rest.partition(":")
        job, kind, val = job.strip(), kind.strip(), val.strip()
        if not (eq and colon and val) or job not in JOB_KEYS or kind not in ("claude", "ag"):
            raise ValueError(f"bad --set {it!r}: want JOB=claude:ALIAS or JOB=ag:BACKEND/MODEL, JOB in {','.join(JOB_KEYS)}")
        if kind == "claude": out.setdefault(job, {})["claude"] = val; continue
        b, _, m = val.partition("/")
        if b not in NATIVE_ORDER: raise ValueError(f"bad --set {it!r}: unknown backend {b!r} ({','.join(NATIVE_ORDER)})")
        out.setdefault(job, {})["ag"] = {"backend": b, "model": m or "default"}
    return out

def parse_harness_list(v):
    v = (v or "").strip().lower()
    if v == "all": return list(SETUP_HARNESSES)
    if v in ("", "none"): return []
    hs = [x.strip() for x in v.split(",") if x.strip()]
    bad = [x for x in hs if x not in SETUP_HARNESSES]
    if bad: raise ValueError(f"unknown harness {','.join(bad)} (claude,opencode,codex|all|none)")
    return list(dict.fromkeys(hs))

def _say(*x): print(*x, file=sys.stderr)
def _ask(prompt, default=""):
    sys.stderr.write(f"{prompt} [{default}]: " if default else f"{prompt}: "); sys.stderr.flush()
    try: v = input().strip()
    except EOFError: v = ""
    return v or default
def _ask_pick(prompt, opts, default):
    for i, o in enumerate(opts[:MODELS_SHOW], 1): _say(f"  {i:2}. {o}")
    if len(opts) > MODELS_SHOW: _say(f"  … {len(opts)-MODELS_SHOW} more (type any id)")
    v = _ask(prompt, default)
    return opts[int(v)-1] if v.isdigit() and 1 <= int(v) <= min(len(opts), MODELS_SHOW) else v

def do_route(a):
    eff, gp, pp = routing_now()
    jobs = {a.job: eff[a.job]} if a.job else eff
    bk = backends_effective(_json_or_empty(gp), _json_or_empty(pp))
    warn = [f"{j}: routed to disabled backend {b} (ag setup: enable {b} or re-route {j})" for j, b in routing_disabled(jobs, bk)]
    data = {"jobs": jobs, "backends": bk, "warnings": warn, "global": str(gp), "project": str(pp)}
    if getattr(a, "json", False): return emit(a, "route", data)
    off = dict(routing_disabled(jobs, bk))
    out = [f'{j:10} claude={e["claude"]:7} ({e["source"]["claude"]})  ag={e["ag"]["backend"]}/{_route_model(e["ag"])} ({e["source"]["ag"]})'
        + ("  ! backend disabled" if j in off else "") for j, e in jobs.items()]
    if not a.job:
        out += [f'backend {b:9} ' + (f'model={eff_model(b, e["model"]) or "default"} mode={e["mode"] or "-"}{" plan" if e["plan"] else ""}'
            if e["enabled"] else "disabled") + f' ({e["source"]})' for b, e in bk.items()]
    out += [f"! {w}" for w in warn]
    out += [f'global:  {gp}{"" if gp.exists() else " (missing)"}', f'project: {pp}{"" if pp.exists() else " (missing)"}']
    return emit(a, "route", {**data, "_text": "\n".join(out)})

# ---- `ag setup` front-ends: one pure state model, three thin UIs (plain prompts / mac osascript / cli curses) ----
SETUP_UIS = ("web", "mac", "cli", "plain")   # mac = alias of web
SETUP_CLAUDE_ALIASES = ("haiku", "sonnet", "opus", "fable")
SETUP_PRESET_DESC = {"cost-first": "cheapest model that can do each job (default)",
    "balanced": "cost-first, but review on sonnet", "quality-first": "sonnet floor, opus implements, fable for the rest"}
SETUP_MIN = (23, 60)          # curses floor (rows, cols); smaller at start -> plain prompts

def _setup_rebase(st):
    """jobs = preset (+ that scope's on-disk picks when its file uses the same preset and the preset
    wasn't forced) < --set < UI edits. Mutates + returns st. Pure."""
    cur = st["existing"].get(st["scope"]) or {}
    keep = {} if st["forced"] or st["preset"] != (cur.get("preset") or "cost-first") else cur
    eff = routing_effective({"preset": st["preset"], "jobs": keep.get("jobs") or {}})
    st["jobs"] = {j: {"claude": eff[j]["claude"], "ag": dict(eff[j]["ag"])} for j in JOB_KEYS}
    for src in (st["sets"], st["edits"]):
        for j, upd in src.items(): st["jobs"][j].update({k: dict(v) if isinstance(v, dict) else v for k, v in upd.items()})
    ex = st["existing"]  # backends: effective for the scope (project sees global under it) < --set backend.* < UI edits
    bk = backends_effective(ex.get("global") or {}, (ex.get("project") or {}) if st["scope"] == "project" else {})
    st["backends"] = {b: {k: e[k] for k in BK_DEFAULT} for b, e in bk.items()}
    for src in (st["bsets"], st["bedits"]):
        for b, upd in src.items(): st["backends"][b].update(upd)
    return st

def setup_state_from(scope="global", preset=None, sets=None, harn=None, claude_md=None, proj=None, existing=None, bsets=None):
    """Shared setup state {scope, harnesses, preset, forced, jobs, backends, claude_md (None=auto), proj, existing,
    sets, edits, bsets, bedits}. A given preset is forced (drops on-disk per-job picks). Pure when proj + existing are given."""
    proj = Path(proj or project_root())
    if existing is None:
        gp, pp = routing_paths(proj)
        existing = {"global": _json_or_empty(gp), "project": _json_or_empty(pp)}
    return _setup_rebase({"scope": scope, "harnesses": list(harn or []),
        "preset": preset or (existing.get(scope) or {}).get("preset") or "cost-first", "forced": bool(preset),
        "jobs": {}, "claude_md": claude_md, "proj": str(proj), "existing": existing, "sets": dict(sets or {}), "edits": {},
        "backends": {}, "bsets": {b: dict(v) for b, v in (bsets or {}).items()}, "bedits": {}})

